{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.crownthrive.example/institutional-ip/evidence-envelope.v1.schema.json",
  "title":"Institutional IP Evidence Reference Envelope",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","envelope_id","subject_type","subject_id","evidence_class","exact_evidence_ref","evidence_digest","source_repository","source_head","authority","non_voting","sovereign_voter","body_in_public_envelope","provider_write_requested","database_write_requested"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "envelope_id":{"type":"string","minLength":8},
    "subject_type":{"enum":["ASSET","INVENTION","TITLE_EVENT","VALUATION_INPUT","RELEASE","COMMERCIAL_PROOF","FRAMEWORK_PACKET","OFFER"]},
    "subject_id":{"type":"string","minLength":4},
    "evidence_class":{"enum":["PUBLIC_REFERENCE","PRIVATE_REFERENCE","RESTRICTED_REFERENCE","LEGAL_REFERENCE","FINANCIAL_REFERENCE","PROVIDER_REFERENCE"]},
    "exact_evidence_ref":{"type":"string","minLength":4},
    "evidence_digest":{"type":"string","pattern":"^(?:sha256:)?[0-9a-f]{64}$"},
    "source_repository":{"type":"string","minLength":3},
    "source_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "authority":{"enum":["D0","D1","D2"]},
    "non_voting":{"const":true},
    "sovereign_voter":{"const":false},
    "body_in_public_envelope":{"const":false},
    "provider_write_requested":{"const":false},
    "database_write_requested":{"const":false}
  }
}
