{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_version": "1.0.0",
  "route_id": "ct.route.REPLACE_ME",
  "source_binding_id": "ct.binding.REPLACE_ME.source",
  "destination_binding_id": "ct.binding.REPLACE_ME.destination",
  "contract_id": "ct.interop.contract.REPLACE_ME.v1",
  "route_kind": "async",
  "route_state": "candidate",
  "authority_class": "D1",
  "transformation_ref": "ct.transform.REPLACE_ME.v1",
  "idempotency_strategy": "stable_source_id_plus_version_digest",
  "retry_policy": {
    "max_attempts": 3,
    "backoff": "bounded_provider_aware",
    "retryable_classes": [
      "timeout",
      "provider_5xx",
      "explicit_retry_after"
    ],
    "non_retryable_classes": [
      "auth_failure",
      "validation_failure",
      "rights_failure",
      "policy_denial"
    ]
  },
  "data_minimization_policy": {
    "allow": [],
    "deny": [
      "credential",
      "private_key",
      "payment_credential",
      "private_identity_mapping",
      "protected_implementation"
    ],
    "unknown_fields": "deny_and_quarantine"
  },
  "rollback_policy": {
    "mode": "append_correction_or_versioned_successor",
    "silent_delete": false,
    "provider_rollback_required_for_write": true,
    "read_after_write_required": true
  },
  "observability": {
    "evidence_receipt_required": true,
    "route_score_required": true,
    "stale_evidence_days": 7,
    "provider_capacity_checked": true,
    "secret_exposed": false
  },
  "owner_agent_id": "ct.interop.agent.adapter-foundry",
  "verifier_agent_id": "ct.interop.agent.compatibility-verifier",
  "activation_gates": [
    "exact_contract_and_version",
    "source_and_destination_identity",
    "authentication_or_public_access_evidence",
    "negative_security_privacy_idempotency_tests",
    "rollback_and_readback_for_writes",
    "independent_verification"
  ],
  "execution": {
    "performed_by_template": false,
    "provider_write_enabled": false,
    "D3_auto": false,
    "sovereign_vote_effect": false
  },
  "route_digest": "REPLACE_WITH_SHA256"
}
