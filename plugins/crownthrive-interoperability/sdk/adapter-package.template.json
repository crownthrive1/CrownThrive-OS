{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_version": "1.0.0",
  "adapter_id": "ct.adapter.REPLACE_ME",
  "canonical_name": "REPLACE ME Adapter",
  "semantic_version": "0.1.0",
  "plugin_id": "ct.plugin.REPLACE_ME",
  "service_id": "REPLACE_ME_SERVICE",
  "provider_system": "REPLACE_ME_PROVIDER",
  "lifecycle_state": "candidate",
  "authority_ceiling": "D2",
  "owner_agent_id": "ct.interop.agent.adapter-foundry",
  "verifier_agent_id": "ct.interop.agent.compatibility-verifier",
  "auth": {
    "mode": "vault_brokered_or_provider_managed",
    "raw_credential_in_package": false,
    "credential_ref_public": false,
    "least_privilege_required": true
  },
  "capabilities": [
    {
      "capability_id": "ct.cap.REPLACE_ME.read",
      "key": "resource.read",
      "operation_mode": "read",
      "risk_class": "D1",
      "state": "candidate",
      "read_only": true,
      "idempotent": true,
      "destructive": false,
      "open_world": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "public_description": "REPLACE ME with a focused user-intent description."
    }
  ],
  "contracts": [
    {
      "contract_id": "ct.interop.contract.REPLACE_ME.v1",
      "binding_mode": "producer",
      "exact_version_required": true,
      "field_mapping_public": false,
      "loss_analysis_required": true
    }
  ],
  "canaries": {
    "read": {
      "required": true,
      "state": "planned",
      "least_data": true
    },
    "write": {
      "required": false,
      "state": "not_applicable",
      "exact_operation_only": true
    },
    "rollback": {
      "required_for_write": true,
      "state": "not_applicable"
    },
    "read_after_write": {
      "required_for_write": true,
      "state": "not_applicable"
    }
  },
  "provider_limits": {
    "local_monthly_budget": -1,
    "local_budget_semantics": "-1=unlimited_local_ceiling;0=disabled;positive=local_monthly_ceiling;null=unresolved_fail_closed",
    "provider_limits_authoritative": true,
    "rate_limit_evidence_ref": null,
    "billing_evidence_ref": null
  },
  "testing": {
    "required_classes": [
      "schema",
      "compatibility",
      "negative",
      "security",
      "privacy",
      "idempotency"
    ],
    "write_additional_classes": [
      "rollback",
      "readback"
    ],
    "originator_can_self_verify": false
  },
  "governance": {
    "D3_auto": false,
    "sovereign_vote_effect": false,
    "direct_main_merge": false,
    "provider_write_enabled": false,
    "checkout_enabled": false,
    "history_policy": "append_or_supersede_never_silent_delete"
  },
  "source_refs": [],
  "public_contract_digest": "REPLACE_WITH_SHA256",
  "package_sha256": "REPLACE_WITH_SHA256"
}
