{
  "canonical_family": "Penta Resilience Suite",
  "version": "1.0.0",
  "owner": "CrownThrive, LLC",
  "control_plane": "CrownThrive IO",
  "documentation_plane": "PentaDocs",
  "authority_rule": "No component may manufacture authority.",
  "components": [
    {"name": "PentaLiency", "mark": "PentaLiency™", "slug": "liency", "role": "resilience engineering and hardening"},
    {"name": "PentaBlue", "mark": "PentaBlue™", "slug": "blue", "role": "defensive detection, containment, and restore validation"},
    {"name": "PentaRed", "mark": "PentaRed™", "slug": "red", "role": "sandbox-only adversarial simulation"},
    {"name": "PentaHoneyPot", "mark": "PentaHoneyPot™", "slug": "honeypot", "role": "ephemeral clone range and duel orchestration"},
    {"name": "PentaSnapshot", "mark": "PentaSnapshot™", "slug": "snapshot", "aliases": ["PentaSnapShot"], "role": "snapshot and integrity manifest authority"},
    {"name": "PentaRollback", "mark": "PentaRollback™", "slug": "rollback", "role": "approved rollback and recovery"}
  ],
  "red_boundary": {
    "network_targets": false,
    "production_targets": false,
    "arbitrary_commands": false,
    "range_lease_required": true,
    "ephemeral_clone_only": true
  },
  "hardening": {
    "default": "dry-run",
    "approved_change_id_required": true,
    "pre_change_snapshot_required": true,
    "post_change_health_gate_required": true,
    "automatic_rollback_on_failed_health_gate": true
  }
}
