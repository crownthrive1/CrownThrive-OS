  "cross_family_assignments": {
    "PentaStatus": ["observability-organic", "communications-service"],
    "PentaHealth": ["workforce-people", "resilience-continuity"],
    "PentaAssure": ["security-trust", "governance-legal"],
    "PentaCertify": ["security-trust", "resilience-continuity"],
    "PentaData": ["intelligence-research"],
    "PentaFederation": ["knowledge-semantics-data"],
    "PentaCapital": ["commerce-economy"],
    "PentaCost": ["observability-organic"],
    "PentaImmune": ["resilience-continuity", "observability-organic"],
    "PentaSnapshot": ["transport-primitives"],
    "PentaRollback": ["transport-primitives"],
    "PentaTime": ["automation-agentic"],
    "PentaDirectors": ["governance-legal"]
  }
}
