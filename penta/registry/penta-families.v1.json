{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "registry_id": "ct.registry.penta-families.v1",
  "canonical_name": "Penta Family of Families",
  "mark": "Penta Families™",
  "owner": "CrownThrive LLC",
  "status": "production",
  "production_scope": "institutional_topology_and_portal_control_plane",
  "parent_family": "Penta Family",
  "parent_registry": "data/penta/family.registry.json",
  "doctrine": "Discover -> Govern -> Execute -> Verify -> Preserve",
  "authority_invariant": "Family assignment organizes responsibility, portals, dependencies and institutional storytelling. It never promotes member maturity or manufactures legal, economic, provider, security, rights, governance, credential, fiduciary or human authority.",
  "inventory_sources": [
    {
      "source_id": "machine-family",
      "kind": "machine_catalogs",
      "path": "data/penta/family.registry.json",
      "rule": "load every catalog declared by the parent family plus every data/penta/systems*.json extension that exposes a systems array"
    },
    {
      "source_id": "technical-components",
      "kind": "component_registry",
      "path": "penta/registry/penta-component-registry.v1.json",
      "rule": "load all components and the PentaRoute primitive census"
    },
    {
      "source_id": "institutional-family",
      "kind": "institutional_registry",
      "path": "PENTA-FAMILY-REGISTRY.md",
      "rule": "load canonical Penta table identities and the registered primitive/capability family"
    }
  ],
  "invariants": {
    "every_discovered_penta_has_primary_family": true,
    "exactly_one_primary_family": true,
    "cross_family_roles_allowed": true,
    "family_assignment_does_not_promote_maturity": true,
    "family_assignment_does_not_create_authority": true,
    "unknown_or_unclassified_penta_fails_closed": true,
    "future_registry_growth_must_be_classified": true,
    "family_portals_required": true,
    "family_portal_state_independent_from_member_maturity": true
  },
  "portal_contract": {
    "index_route": "/io/pentas/families",
    "route_pattern": "/io/pentas/families/{slug}",
    "docs_index": "PENTA-FAMILIES.md",
    "portal_state": "contracted",
    "portal_state_is_not_frontend_deployment_claim": true,
    "required_sections": [
      "story",
      "mission",
      "member_census",
      "member_status",
      "responsibilities",
      "inputs_outputs",
      "authority_boundary",
      "cross_family_handoffs",
      "operations",
      "sops_slas",
      "evidence",
      "api_mcp",
      "incidents_recovery",
      "releases_changelog",
      "roadmap",
      "support"
    ]
  },
  "classification": {
    "normalization": "casefold_alphanumeric_strip_marks_spaces_hyphens_underscores",
    "precedence": [
      "explicit_member",
      "machine_category_pattern",
      "route_primitive_only"
    ],
    "ambiguous_match_disposition": "hold_fail_closed",
    "unclassified_disposition": "hold_fail_closed",
    "route_primitive_only_family": "transport-primitives"
  },
  "families": [
    {
      "family_id": "system-architecture",
      "canonical_name": "Penta System Architecture Family",
      "slug": "system-architecture",
      "mission": "Define the operating-system umbrella, architecture, topology, planes, substrate, mesh and system self-model that give every other Penta a stable place in the whole.",
      "portal_route": "/io/pentas/families/system-architecture",
      "explicit_members": ["PentaOS", "PentaVergence", "PentaTechture", "PentaPology", "PentaPlanes", "PentaFabric", "PentaMesh", "PentaBase", "PentaControl", "PentaSELF"],
      "machine_category_patterns": ["(^|_)(control_plane|architecture|topology|substrate|system_architecture)(_|$)"],
      "handoffs_to": ["routing-interoperability", "governance-legal", "observability-organic", "resilience-continuity"]
    },
    {
      "family_id": "routing-interoperability",
      "canonical_name": "Penta Routing & Interoperability Family",
      "slug": "routing-interoperability",
      "mission": "Make registered systems mutually addressable through certified routes, federation, MCP/API contracts, explicit bindings and interoperable transport without converting connectivity into permission.",
      "portal_route": "/io/pentas/families/routing-interoperability",
      "explicit_members": ["PentaFederation", "PentaInterOps", "PentaFlex", "PentaMCP", "PentaRoute", "PentaWire", "PentaBind"],
      "machine_category_patterns": ["routing", "interoperability", "federation", "tool_interoperability", "mesh_fabric"],
      "handoffs_to": ["transport-primitives", "automation-agentic", "security-trust", "resilience-continuity"]
    },
    {
      "family_id": "transport-primitives",
      "canonical_name": "Penta Transport & Capability Primitives Family",
      "slug": "transport-primitives",
      "mission": "Own the bounded request, query, read, mutation, event, queue, cache, synchronization and delivery primitives used beneath higher-level Penta systems.",
      "portal_route": "/io/pentas/families/transport-primitives",
      "explicit_members": [],
      "machine_category_patterns": [],
      "handoffs_to": ["routing-interoperability", "security-trust", "build-release"]
    },
    {
      "family_id": "automation-agentic",
      "canonical_name": "Penta Automation & Agentic Family",
      "slug": "automation-agentic",
      "mission": "Govern workflows, agents, models, skills, tools, algorithms, scripts and bounded orchestration so autonomous work remains typed, reviewable and authority-aware.",
      "portal_route": "/io/pentas/families/automation-agentic",
      "explicit_members": ["PentaOrchestrator", "PentaMation", "PentaFlows", "PentaAgents", "PentaLLM", "PentaMCL", "PentaBoxes", "PentaSkills", "PentaTools", "PentaRithms", "PentaScripts", "PentaSuite", "PentaRFA"],
      "machine_category_patterns": ["automation", "orchestration", "agentic", "agent_runtime", "workflow"],
      "handoffs_to": ["routing-interoperability", "build-release", "security-trust", "workforce-people"]
    },
    {
      "family_id": "build-release",
      "canonical_name": "Penta Build, Certification & Release Family",
      "slug": "build-release",
      "mission": "Turn governed requirements into software, adapters, tests, certificates, PRs, merges, releases and immutable execution evidence without bypassing independent gates.",
      "portal_route": "/io/pentas/families/build-release",
      "explicit_members": ["PentaFactory", "PentaBuild", "PentaCertify", "PentaAssure", "PentaQuality", "PentaPR", "PentaMerge", "PentaCloser", "PentaRelease", "PentaRunners", "PentaPunters", "PentaActions", "PentaResults"],
      "machine_category_patterns": ["software_factory", "software_delivery", "provider_adapter_certification", "assurance_certification", "release_management", "source_convergence", "gap_closure", "quality_management"],
      "handoffs_to": ["security-trust", "resilience-continuity", "knowledge-semantics-data", "routing-interoperability"]
    },
    {
      "family_id": "security-trust",
      "canonical_name": "Penta Security, Identity & Trust Family",
      "slug": "security-trust",
      "mission": "Protect identity, credentials, privacy, compliance, risk, auditability, sanctions controls, secrets and adversarial assurance while keeping all consequential authority fail-closed.",
      "portal_route": "/io/pentas/families/security-trust",
      "explicit_members": ["PentaBound", "PentaSecure", "PentaSecurity", "PentaCredentials", "PentaIdentity", "PentaPrivacy", "PentaCompliance", "PentaRisk", "PentaAudit", "PentaOFAC", "PentaVault", "PentaAuth", "PentaSign", "PentaImmune", "PentaEVIBuilder", "PentaBlue", "PentaRed", "PentaHoneyPot"],
      "machine_category_patterns": ["security", "credential", "identity", "privacy", "compliance", "risk", "audit", "ofac", "sanction", "trust"],
      "handoffs_to": ["governance-legal", "build-release", "resilience-continuity", "routing-interoperability"]
    },
    {
      "family_id": "resilience-continuity",
      "canonical_name": "Penta Resilience & Continuity Family",
      "slug": "resilience-continuity",
      "mission": "Preserve recoverability, serialization, version lineage, schedules, liveness, readiness, maintenance, succession, snapshots and staged rollback across seven-generation continuity horizons.",
      "portal_route": "/io/pentas/families/resilience-continuity",
      "explicit_members": ["PentaLiency", "PentaSnapshot", "PentaRollback", "PentaNurture", "PentaGeneration", "PentaSerialized", "PentaVersion", "PentaFormat", "PentaSOPs", "PentaSLAs", "PentaTime", "PentaStatus", "PentaOD", "PentaHeartbeat", "PentaBeata"],
      "machine_category_patterns": ["continuity", "system_maintenance", "temporal_governance", "readiness", "heartbeat", "liveness", "recovery", "rollback", "serial", "self_observability_reporting"],
      "handoffs_to": ["observability-organic", "build-release", "knowledge-semantics-data", "security-trust"]
    },
    {
      "family_id": "observability-organic",
      "canonical_name": "Penta Observability & Organic Systems Family",
      "slug": "observability-organic",
      "mission": "Sense the institutional body through errors, logs, traces, metrics, signals, spine events, nervous-system routing, health, load, balancing and cost-pressure evidence.",
      "portal_route": "/io/pentas/families/observability-organic",
      "explicit_members": ["PentaError", "PentaLogger", "PentaTrace", "PentaMetric", "PentaBrain", "PentaSpine", "PentaNerves", "PentaBody", "PentaHealth", "PentaLoad", "PentaBalancer", "PentaCosts"],
      "machine_category_patterns": ["observability", "telemetry", "logging", "tracing", "metrics", "system_health", "capacity", "load_balance", "organic"],
      "handoffs_to": ["resilience-continuity", "intelligence-research", "system-architecture", "communications-service"]
    },
    {
      "family_id": "knowledge-semantics-data",
      "canonical_name": "Penta Knowledge, Semantics & Data Family",
      "slug": "knowledge-semantics-data",
      "mission": "Preserve institutional truth, records, datasets, terminology, assets, maps, contracts and IP lineage so every human and machine projection resolves to governed source meaning.",
      "portal_route": "/io/pentas/families/knowledge-semantics-data",
      "explicit_members": ["PentaDocs", "PentaScribe", "PentaData", "PentaRecords", "PentaNotes", "PentaSets", "PentaMaps", "PentaStars", "PentaIP"],
      "machine_category_patterns": ["institutional_knowledge", "data_governance", "records_management", "knowledge", "semantic", "asset_registry"],
      "handoffs_to": ["governance-legal", "intelligence-research", "media-creative", "resilience-continuity"]
    },
    {
      "family_id": "governance-legal",
      "canonical_name": "Penta Governance, Legal & Institutional Controls Family",
      "slug": "governance-legal",
      "mission": "Coordinate policy, legal operations, contracts, licensing, ethics, capital, procurement, vendor governance and executive oversight beneath CHLOM/DAIL and reserved human authority.",
      "portal_route": "/io/pentas/families/governance-legal",
      "explicit_members": ["PentaBoard", "PentaPolicy", "PentaLegal", "PentaContracts", "PentaLicense", "PentaEthics", "PentaCapital", "PentaProcure", "PentaVendor"],
      "machine_category_patterns": ["policy", "legal", "contract", "licens", "ethic", "capital", "procure", "vendor", "institutional_governance"],
      "handoffs_to": ["security-trust", "workforce-people", "commerce-economy", "knowledge-semantics-data"]
    },
    {
      "family_id": "workforce-people",
      "canonical_name": "Penta Workforce & People Family",
      "slug": "workforce-people",
      "mission": "Govern human/AI collaboration, stewardship, managers, directors, cohorts, HR, benefits, triage and capability development without confusing workforce membership with sovereign authority.",
      "portal_route": "/io/pentas/families/workforce-people",
      "explicit_members": ["PentaDirectors", "PentaManagers", "PentaWorkforceOS", "PentaCohorts", "PentaAccelerator", "PentaTriage", "PentaHR", "PentaBenefits", "PentaAlumni", "PentaHybrid"],
      "machine_category_patterns": ["human_ai", "human_stewardship", "agent_management", "supervisory_policy", "workforce", "cohort", "capability_acceleration", "hr_", "benefit", "triage"],
      "handoffs_to": ["governance-legal", "communications-service", "automation-agentic", "intelligence-research"]
    },
    {
      "family_id": "intelligence-research",
      "canonical_name": "Penta Intelligence, Research & Impact Family",
      "slug": "intelligence-research",
      "mission": "Convert approved signals and data into analytics, research, scenarios, impact intelligence and evidence-backed recommendations while preserving uncertainty and advisory boundaries.",
      "portal_route": "/io/pentas/families/intelligence-research",
      "explicit_members": ["PentaSignal", "PentaAnalytics", "PentaInstitute", "PentaImpact"],
      "machine_category_patterns": ["research", "decision_science", "analytics", "impact", "strategic_sensing", "institutional_intelligence"],
      "handoffs_to": ["knowledge-semantics-data", "governance-legal", "observability-organic", "commerce-economy"]
    },
    {
      "family_id": "communications-service",
      "canonical_name": "Penta Communications & Service Family",
      "slug": "communications-service",
      "mission": "Coordinate institutional messaging, concierge fulfillment, marketing communication and owner/service delivery through authorized identities, consent-aware channels and evidence-backed delivery rails.",
      "portal_route": "/io/pentas/families/communications-service",
      "explicit_members": ["PentaMail", "PentaConcierge", "PentaMarketer"],
      "machine_category_patterns": ["messaging", "mail", "concierge", "marketing", "communications", "outreach"],
      "handoffs_to": ["routing-interoperability", "security-trust", "commerce-economy", "observability-organic"]
    },
    {
      "family_id": "media-creative",
      "canonical_name": "Penta Media, Studio & Publishing Family",
      "slug": "media-creative",
      "mission": "Operate media, studio and publishing assets through governed canon, rights, provider, production, QA and release pathways across CrownThrive creative properties.",
      "portal_route": "/io/pentas/families/media-creative",
      "explicit_members": ["PentaMedia", "PentaStudios", "PentaBooks"],
      "machine_category_patterns": ["media_operations", "studio", "publishing_operations", "creative"],
      "handoffs_to": ["knowledge-semantics-data", "commerce-economy", "security-trust", "build-release"]
    },
    {
      "family_id": "commerce-economy",
      "canonical_name": "Penta Commerce & Economy Family",
      "slug": "commerce-economy",
      "mission": "Coordinate authorized commerce, credits, compensation and cost economics under PentaGreen and CHLOM without turning optimization, provider capability or balances into unearned financial authority.",
      "portal_route": "/io/pentas/families/commerce-economy",
      "explicit_members": ["PentaGreen", "PentaCredits", "PentaPay", "PentaCost"],
      "machine_category_patterns": ["commerce", "economic", "credits", "payment", "compensation", "cost_control"],
      "handoffs_to": ["governance-legal", "security-trust", "communications-service", "media-creative"]
