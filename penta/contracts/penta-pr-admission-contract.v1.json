{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ct.penta.pr-admission.v1",
  "title": "Penta PR Admission Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo","subject_key","owner_lane","base_sha","head_sha","authority_class","changed_files","tests","rollback","evidence","post_open_obligations"],
  "properties": {
    "repo": {"type":"string","minLength":3},
    "subject_key": {"type":"string","minLength":3,"description":"Stable semantic work identity. One subject maps to one canonical open PR owner lane."},
    "owner_lane": {"type":"string","minLength":3},
    "release_candidate_key": {"type":["string","null"],"description":"For releases: repo + version + canonical base generation. Must be idempotent."},
    "base_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "head_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "authority_class": {"enum":["D0","D1","D2","D3"]},
    "changed_files": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "tests": {"type":"object","required":["status"],"properties":{"status":{"enum":["PASS","HOLD"]},"evidence_refs":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "rollback": {"type":"object","required":["defined"],"properties":{"defined":{"const":true},"procedure":{"type":"string","minLength":3}},"additionalProperties":true},
    "evidence": {"type":"object","required":["claims"],"properties":{"claims":{"type":"array","items":{"type":"object","required":["name","state"],"properties":{"name":{"type":"string"},"state":{"enum":["PASS","HOLD","NOT_APPLICABLE"]},"exact_head":{"type":"boolean"},"provider_receipt":{"type":["string","null"]}},"additionalProperties":false}}},"additionalProperties":true},
    "supersedes_pr": {"type":["integer","null"],"minimum":1},
    "existing_owner_pr": {"type":["integer","null"],"minimum":1},
    "post_open_obligations": {"type":"array","items":{"type":"string"}},
    "authority_created": {"const":false}
  }
}
