{
  "schema": "ct.penta.organic-control-plane.v1",
  "version": "1.0.0",
  "identity_policy": {
    "primary_identity": "vault_id",
    "routing_binding": "public_key_fingerprint",
    "ip_address_as_identity": "prohibited",
    "private_key_storage": "prohibited_outside_vault",
    "public_projection": ["vault_id", "public_key_fingerprint", "key_algorithm", "signature_ref"]
  },
  "governance_routes": {
    "amendment_candidate": "PentaLegislature",
    "adjudication_case": "PentaJudicial",
    "authorized_execution": "PentaExecutive",
    "health_signal": "PentaBrain",
    "capacity_signal": "PentaBalancer",
    "cost_signal": "PentaCosts",
    "security_signal": "PentaSecure"
  },
  "resilience_policy": {
    "minimum_redundancy": 2,
    "reserve_capacity_floor": 0.2,
    "zero_viable_organs_prohibited": true,
    "growth_mode": "bounded_demand_driven",
    "recession_mode": "graceful_with_reserve",
    "continuity_mode": "append_only_spine_and_recoverable_organs"
  },
  "cost_policy": {
    "currency": "normalized_cost_units",
    "per_organ_limit": 100,
    "money_movement": "prohibited",
    "budget_authority": "external_governed_binding_required"
  },
  "learning_policy": {
    "mode": "bounded_observational",
    "self_authorization": "prohibited",
    "training_on_private_payloads": "prohibited",
    "model_or_rule_promotion": "separate_certification_required"
  }
}
