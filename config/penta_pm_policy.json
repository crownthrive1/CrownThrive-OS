{
  "schema": "ct.penta.pm.policy.v1",
  "version": "1.2.0",
  "authority": "PentaPM",
  "risk_ceiling": "D2",
  "canonical_project": "CrownThrive OS — Penta Production Control",
  "family": [
    "PentaPM",
    "PentaProjects",
    "PentaMilestone",
    "PentaIssues",
    "PentaDevelopment",
    "PentaRoadmap",
    "PentaRetro",
    "PentaWatch"
  ],
  "project_fields": [
    "Artifact ID",
    "Penta Owner",
    "Lane",
    "Stage",
    "Risk",
    "Priority",
    "Release Train",
    "Milestone",
    "Dependency State",
    "Evidence State",
    "Certification State",
    "Runtime State",
    "Cost State",
    "CIE State",
    "Due/Deadline",
    "DAIL Receipt",
    "CHLOM Decision",
    "Last Reconciled At"
  ],
  "milestones": [
    {"title": "OS Production Convergence", "description": "Production convergence and governed release readiness."},
    {"title": "Penta Runtime Certification", "description": "Penta runtime interoperability, tests, certification and production evidence."},
    {"title": "Documentation & Institutional Knowledge", "description": "PentaDocs, Mintlify and institutional knowledge continuity."},
    {"title": "Commerce & Economic Activation", "description": "Commerce, treasury, market, licensing and economic activation."},
    {"title": "Security / Compliance / Rights", "description": "Security, compliance, rights and governance controls."},
    {"title": "Media / Publishing / Distribution", "description": "Media, publishing, distribution and syndication."},
    {"title": "Infrastructure / Data / Backup", "description": "Infrastructure, data, continuity, backup and recovery."},
    {"title": "Release Economics & CIE Evidence", "description": "Authoritative release cost and Cultural Imprint evidence."}
  ],
  "milestone_routing": {
    "penta:lane:docs": "Documentation & Institutional Knowledge",
    "penta:lane:commerce": "Commerce & Economic Activation",
    "penta:lane:security": "Security / Compliance / Rights",
    "penta:lane:media": "Media / Publishing / Distribution",
    "penta:lane:database": "Infrastructure / Data / Backup",
    "penta:lane:workflow": "Penta Runtime Certification"
  },
  "required_pr_metadata": [
    "project",
    "milestone_or_exemption",
    "development_link",
    "penta_owner",
    "lane",
    "risk",
    "stage",
    "originator_self_certification",
    "gate_evidence_blob",
    "continuity_receipt"
  ],
  "development": {
    "full_completion_keyword": "Closes",
    "partial_reference_keyword": "Refs",
    "prevent_unverified_auto_close": true,
    "same_repo_missing_link_action": "create_pr_scoped_pentadevelopment_issue_and_bind_refs",
    "external_fork_missing_link_action": "hold_fail_closed"
  },
  "gate_awareness": {
    "policy_path": "config/penta_pr_gate_awareness.json",
    "applies_to_all_same_repo_prs": true,
    "originator_self_certification_required": true,
    "exact_head_evidence_required": true,
    "continuity_receipt_required": true,
    "head_change_invalidates_evidence": true,
    "provider_gate_results_may_not_be_manufactured": true,
    "required_gate_bypass_forbidden": true,
    "final_pass_requires_provider_gates_readback_and_dail": true
  },
  "remediation_assignment": {
    "source": "PentaSELF",
    "pr_authority": "PentaPR",
    "assignment_authority": "PentaPM",
    "assignment_label_prefix": "penta:assigned:",
    "bootstrap_hold_required": true,
    "always_required": [
      "PentaBuild",
      "PentaTest",
      "PentaCertify",
      "PentaPR"
    ],
    "lane_owners": {
      "docs": ["PentaDocs", "PentaScribe"],
      "workflow": ["PentaFlows", "PentaActions", "PentaRunners"],
      "database": ["PentaBase", "PentaSecure"],
      "provider": ["PentaFlex", "PentaRoute", "PentaBind"],
      "security": ["PentaSecure", "PentaBound", "PentaAudit"],
      "commerce": ["PentaGreen", "PentaCosts", "PentaCompliance"],
      "media": ["PentaStudios", "PentaMedia", "PentaRoute"],
      "observability": ["PentaHealth", "PentaNerves", "PentaResults"],
      "general": ["PentaFactory", "PentaVergence"]
    },
    "high_risk_owners": [
      "PentaSecure",
      "PentaBound",
      "PentaCertify"
    ],
    "blocked_state_owners": [
      "PentaVergence",
      "PentaBalancer",
      "PentaRoute"
    ],
    "reassignment_states": [
      "blocked",
      "failed",
      "stalled",
      "degraded"
    ]
  },
  "exceptions": {
    "typed": true,
    "require_reason": true,
    "require_expiry": true,
    "require_dail_receipt": true
  },
  "receipts": {
    "immutable": true,
    "idempotent": true,
    "authority": "DAIL",
    "policy_authority": "CHLOM"
  }
}
