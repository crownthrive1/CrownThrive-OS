{
  "schema": "ct.penta.rg.policy.20260827.v1",
  "policy_id": "ct.penta.release-governance-recovery.v1",
  "display_name": "PentaRG™",
  "meaning": "Penta Release Governance & Recovery",
  "mode": "FULL_AUTONOMOUS_GOVERNED",
  "institutional_phase": "3",
  "owner": "CrownThrive Penta Governance Layer",
  "authority": {
    "d0": {
      "mode": "autonomous"
    },
    "d1": {
      "mode": "autonomous"
    },
    "d2": {
      "mode": "bounded_autonomous",
      "requirements": [
        "exact_head_evidence",
        "deterministic_test",
        "recorded_rollback",
        "provider_readback"
      ]
    },
    "d3": {
      "mode": "founder_lease_only",
      "founder_lease": {
        "enabled": true,
        "authority_source": "Founder explicit approval in production remediation directive",
        "starts_at": "2026-08-27T00:00:00Z",
        "expires_at": "2026-09-10T23:59:59Z",
        "scope": [
          "create_or_update_governed_workflows",
          "create_or_update_release_policies",
          "merge_only_after_required_evidence_green",
          "production_deploy_only_after_provider_readback",
          "archive_superseded_assets_without_history_deletion"
        ],
        "renewal_required": true
      }
    }
  },
  "safe_provider_actions": [
    "read_repository_and_provider_state",
    "comment_idempotent_receipts",
    "rerun_failed_jobs_once_per_exact_head",
    "update_same_repository_pr_branch_without_force",
    "archive_unbound_generic_workflow_prs_without_branch_deletion",
    "dispatch_registered_evidence_refresh_workflows",
    "create_repair_prs_from_canonical_history"
  ],
  "prohibited_actions": [
    "disable_or_weaken_branch_protection",
    "manufacture_successful_check_or_release_evidence",
    "force_push_or_rewrite_history",
    "read_or_log_secret_values",
    "delete_evidence_or_historical_branches",
    "perform_financial_or_entitlement_mutations",
    "grant_provider_or_sovereign_authority",
    "close_ambiguous_or_security_relevant_work_without_supersession_evidence"
  ],
  "provider": {
    "request_budget": 240,
    "max_open_pulls_per_sweep": 75,
    "retry_cap_per_exact_head": 1,
    "deferred_retry_seconds": 1800,
    "provider_truth_is_authoritative": true
  },
  "archive": {
    "generic_title_prefixes": [
      "create "
    ],
    "generic_workflow_paths": [
      ".github/workflows/webpack.yml",
      ".github/workflows/python-package-conda.yml",
      ".github/workflows/dependency-review.yml",
      ".github/workflows/generator-generic-ossf-slsa3-publish.yml",
      ".github/workflows/stale.yml",
      ".github/workflows/static.yml"
    ],
    "history_deletion_allowed": false,
    "tombstone_required": true
  },
  "required_paths": [
    "scripts/penta_rg.py",
    "tests/test_penta_rg.py",
    "config/penta_rg_policy.json",
    "config/penta_rg_topology.json",
    "config/retired_identity_archive.json",
    ".github/workflows/penta-rg.yml",
    ".github/workflows/penta-vercel-control-plane.yml",
    "apps/crownthrive-os-control-plane/index.html",
    "apps/crownthrive-os-control-plane/app.js",
    "apps/crownthrive-os-control-plane/styles.css",
    "apps/crownthrive-os-control-plane/api/health.js",
    "apps/crownthrive-os-control-plane/vercel.json",
    "config/vercel_control_plane.json"
  ],
  "required_topology_nodes": [
    "PentaRG",
    "PentaGate",
    "PentaHeal",
    "PentaRanger",
    "PentaTagger",
    "PentaPM",
    "PentaRelease",
    "PentaCertify",
    "PentaDeploy",
    "PentaVercel",
    "DAIL",
    "CHLOM",
    "PentaPolice",
    "PentaGovernance"
  ],
  "required_topology_edges": [
    ["PentaRG", "PentaGate"],
    ["PentaGate", "PentaHeal"],
    ["PentaHeal", "PentaRanger"],
    ["PentaRanger", "PentaCertify"],
    ["PentaCertify", "PentaRelease"],
    ["PentaRelease", "PentaDeploy"],
    ["PentaDeploy", "PentaVercel"],
    ["PentaRG", "DAIL"],
    ["PentaRG", "PentaGovernance"],
    ["CHLOM", "PentaPolice"]
  ],
  "vercel": {
    "project_name": "crownthrive-os-control-plane",
    "team_slug": "crownthrive1s-projects",
    "root_directory": "apps/crownthrive-os-control-plane",
    "deployment_state": "PROVIDER_BINDING_REQUIRED",
    "required_files": [
      "apps/crownthrive-os-control-plane/index.html",
      "apps/crownthrive-os-control-plane/app.js",
      "apps/crownthrive-os-control-plane/styles.css",
      "apps/crownthrive-os-control-plane/api/health.js",
      "apps/crownthrive-os-control-plane/vercel.json",
      "config/vercel_control_plane.json"
    ]
  }
}
