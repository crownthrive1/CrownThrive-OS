{
  "schema": "ct.penta.system-extension.v1",
  "extension_id": "ct.penta.immune-system",
  "version": "1.0.0",
  "state": "CANDIDATE",
  "target_phase": "Phase 3 — Execute",
  "components": [
    {
      "id": "penta.evi-builder",
      "name": "PentaEVIBuilder",
      "role": "construct exact-head evidence bundles, provenance receipts, rollback/fallback bindings and advisory repair memory",
      "may_self_certify": false,
      "may_promote_production": false,
      "may_expand_authority": false
    },
    {
      "id": "penta.immune",
      "name": "PentaImmune",
      "role": "rank authorized repository-local weaknesses and prepare bounded reversible repair work",
      "may_scan_external_targets": false,
      "may_execute_arbitrary_commands": false,
      "may_self_certify": false,
      "may_promote_production": false,
      "may_expand_authority": false
    }
  ],
  "autonomy": {
    "default_authority": "A2",
    "autonomous_decision_classes": ["D0", "D1", "D2"],
    "human_reserved_decision_classes": ["D3"],
    "kill_switch": "armed",
    "max_repairs_per_cycle": 1,
    "max_attempts_per_candidate": 2,
    "cooldown_seconds": 3600,
    "scheduled_hunt_cron": "17 * * * *",
    "scope": "authorized CrownThrive repository-local issues, CI failures, tests, evidence, registry and documentation drift only"
  },
  "repair_contract": {
    "builder": "penta.factory",
    "delivery": "penta.pr",
    "evidence_builder": "penta.evi-builder",
    "independent_certifier": "penta.certify",
    "assurance": "penta.assure",
    "required_outputs": [
      "exact_head_sha",
      "test_receipts",
      "evidence_receipt_sha256",
      "rollback",
      "fallback_redundancy",
      "failure_or_hold_reason"
    ],
    "repair_memory_is_advisory_only": true,
    "repair_memory_requires_retest": true,
    "failed_repairs_may_enter_success_memory": false
  },
  "penta_creation_contract": {
    "may_propose_new_pentas": true,
    "proposal_state": "CANDIDATE",
    "self_registration_authorized": false,
    "self_activation_authorized": false,
    "external_governance_required": true
  },
  "production_claim_contract": {
    "current_claim": "candidate until governed PR exact-head CI and merge evidence exist",
    "old_evidence_may_be_reused_as_new": false,
    "certifier_must_differ_from_evidence_producer": true,
    "sha_drift_fails_closed": true,
    "D3_requires_human_gate": true
  }
}
