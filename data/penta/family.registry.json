    "base_route": "/penta",
    "route_pattern": "/penta/{machine_key_suffix}",
    "portal_state_is_independent_from_maturity": true,
    "portal_does_not_create_execution_authority": true,
    "required_sections": ["overview", "status", "responsibilities", "inputs_outputs", "authority_boundary", "dependencies", "sops_slas", "runbooks", "guides", "evidence", "api_mcp", "changelog", "support"]
