{
  "schema_version": "1.3.0",
  "registry_id": "crownthrive.penta.family",
  "canonical_name": "Penta Family",
  "mark": "Penta Family™",
  "updated": "2026-08-26",
  "owner": "CrownThrive LLC",
  "status": "production",
  "production_scope": "institutional_control_plane",
  "doctrine": "Discover -> Govern -> Execute -> Verify -> Preserve",
  "authority_invariant": "Penta Family coordinates, validates and preserves member state but never manufactures legal, economic, security, licensing, governance, provider, fiduciary or human authority. Execution remains bounded by each member's maturity, CHLOM/DAIL authority, accountable ownership, PentaHybrid gates and certified provider bindings.",
  "production_contract": {
    "fail_closed": true,
    "member_status_is_independent": true,
    "production_family_does_not_promote_members": true,
    "unknown_members_block_dispatch": true,
    "duplicate_machine_keys_block_dispatch": true,
    "missing_required_catalogs_block_dispatch": true,
    "execution_requires_member_eligibility": true,
    "execution_eligible_maturity": ["certified", "production"],
    "non_execution_maturity": ["specified", "implemented", "hold", "retired"]
  },
  "catalogs": [
    {
      "catalog_id": "penta.core",
      "path": "data/penta/systems.registry.json",
      "required": true,
      "role": "canonical_core_system_catalog"
    },
    {
      "catalog_id": "penta.scribe-marketer",
      "path": "data/penta/systems.extensions.pentascribe-marketer.json",
      "required": true,
      "role": "production_system_extension"
    },
    {
      "catalog_id": "penta.institutional-services",
      "path": "data/penta/institutional-services.registry.json",
      "required": true,
      "role": "institutional_operating_fabric"
    },
    {
      "catalog_id": "penta.operations-workforce",
      "path": "data/penta/systems.extensions.operations-workforce.json",
      "required": true,
      "role": "operations_workforce_service_extension"
    },
    {
      "catalog_id": "penta.institutional-controls",
      "path": "data/penta/systems.extensions.institutional-controls.json",
      "required": true,
      "role": "institutional_control_and_assurance_extension"
    },
    {
      "catalog_id": "penta.observability-readiness",
      "path": "data/penta/systems.extensions.observability.json",
      "required": true,
      "role": "observability_heartbeat_and_on_demand_readiness_extension"
    }
  ],
  "control_plane_validation": {
    "registered_penta_refs_required": true,
    "normalize_display_names": true,
    "external_refs_allowed": ["CHLOM", "DAIL"],
    "unresolved_reference_disposition": "hold_fail_closed"
  },
  "control_planes": {
    "authority": ["CHLOM", "DAIL"],
    "human_governance": ["PentaHybrid", "PentaAlumni", "PentaBoard"],
    "routing_execution": ["PentaControl", "PentaMCP", "PentaRoute", "PentaMation", "PentaTime"],
    "readiness_liveness": ["PentaOD", "PentaHeartbeat", "PentaBeata", "PentaStatus", "PentaCertify", "PentaMesh", "PentaFabric"],
    "build_release": ["PentaFactory", "PentaBuild", "PentaCertify", "PentaAssure", "PentaRelease", "PentaMerge", "PentaCloser", "PentaPR", "PentaSuite", "PentaRFA", "PentaNurture"],
    "credentials_security_compliance": ["PentaCredentials", "PentaIdentity", "PentaSecurity", "PentaPrivacy", "PentaCompliance", "PentaRisk", "PentaAudit", "PentaOFAC"],
    "knowledge_continuity": ["PentaDocs", "PentaScribe", "PentaData", "PentaRecords", "PentaGeneration", "PentaFederation", "PentaNotes", "PentaStatus"],
    "market_media_economy": ["PentaMarketer", "PentaMedia", "PentaStudios", "PentaBooks", "PentaGreen", "PentaCredits", "PentaPay", "PentaCost"],
    "institutional_intelligence": ["PentaSignal", "PentaAnalytics", "PentaInstitute", "PentaImpact", "PentaData"],
    "institutional_governance": ["PentaPolicy", "PentaCompliance", "PentaLegal", "PentaContracts", "PentaEthics", "PentaCapital", "PentaQuality", "PentaBoard", "PentaDirectors"],
    "workforce_people": ["PentaManagers", "PentaDirectors", "PentaCohorts", "PentaAccelerator", "PentaTriage", "PentaHealth", "PentaHR", "PentaBenefits", "PentaIdentity"],
    "communications_service": ["PentaMail", "PentaConcierge", "PentaStatus"],
    "data_identity_privacy": ["PentaData", "PentaPrivacy", "PentaIdentity", "PentaRecords", "PentaSecurity", "PentaAudit"],
    "procurement_vendor_contracts": ["PentaProcure", "PentaVendor", "PentaContracts", "PentaCapital", "PentaCost", "PentaPay", "PentaLegal", "PentaRisk"],
    "quality_compliance_assurance": ["PentaQuality", "PentaCompliance", "PentaAssure", "PentaAudit", "PentaRisk", "PentaPolicy", "PentaSecurity"]
  },
  "on_demand_contract": {
    "controller": "PentaOD",
    "system_heartbeat": "PentaHeartbeat",
    "liveness_primitive": "PentaBeata",
    "hot_means_ready_not_unbounded": true,
    "verified_write_required_for_certified_write_on_demand": true,
    "credential_required_when_provider_auth_is_required": true,
    "heartbeat_freshness_required": true,
    "d3_auto_wake": false,
    "held_auto_wake": false,
    "retired_auto_wake": false,
    "arbitrary_provider_payload_proxy": false,
    "authority_expansion": false
  },
  "portal_contract": {
    "every_registered_member_has_portal": true,
    "base_route": "/penta",
    "route_pattern": "/penta/{machine_key_suffix}",
    "portal_state_is_independent_from_maturity": true,
    "portal_does_not_create_execution_authority": true,
    "required_sections": [
      "overview",
      "status",
      "responsibilities",
      "inputs_outputs",
      "authority_boundary",
      "dependencies",
      "sops_slas",
      "runbooks",
      "guides",
      "evidence",
      "api_mcp",
      "changelog",
      "support"
    ]
  },
  "dispatch_policy": {
    "resolve_member_by_machine_key": true,
    "require_registered_member": true,
    "require_member_maturity": ["certified", "production"],
    "require_authority_trace_for_consequential_actions": true,
    "require_certified_provider_binding_when_provider_action": true,
    "require_human_gate_when_policy_demands": true,
    "require_pentaod_readiness_when_on_demand": true,
    "require_readback_receipt": true,
    "preserve_evidence": true
  },
  "observability": {
    "emit_family_snapshot": true,
    "emit_member_counts_by_maturity": true,
    "emit_duplicate_keys": true,
    "emit_missing_catalogs": true,
    "emit_execution_eligible_members": true,
    "emit_held_members": true,
    "emit_control_plane_resolution": true,
    "emit_portal_index": true,
    "emit_pentaod_readiness_counts": true,
    "emit_pentaheartbeat_freshness": true
  }
}
