{
  "contract": "ct.penta.census.production-certification.v1",
  "component_key": "penta.census",
  "version": "1.1.0",
  "state": "production",
  "production_scope": [
    "repository namespace discovery",
    "registered system and provider census",
    "classification and diffing",
    "governed handoff routing",
    "authorized economic aggregate capture",
    "founder report enqueue through PentaMail",
    "scheduled heartbeat and daily major census"
  ],
  "excluded_scope": [
    "D3 execution",
    "authority self-promotion",
    "raw cookie access",
    "raw secret access",
    "personal income inference",
    "unattended Google Drive write",
    "unattended Google Sheets write",
    "arbitrary provider mutation",
    "money movement"
  ],
  "evidence_requirements": {
    "policy_enabled": true,
    "latest_census_completed": true,
    "scheduler_active": true,
    "scheduler_latest_status": "succeeded",
    "founder_report_queued": true,
    "raw_cookie_exposure": false,
    "raw_secret_exposure": false,
    "personal_income_inference": false,
    "d3_human_reserved": true
  },
  "runtime": {
    "status": "integration_control.penta_census_status_v1()",
    "production_status": "integration_control.penta_census_production_status_v1()",
    "scheduler": "ct-penta-census-native-due-v1",
    "schedule": "*/5 * * * *",
    "certification_table": "integration_control.penta_census_production_certification_v1"
  },
  "permanence": {
    "repair_key": "ct.repair.penta-census-readonly-core-production.v1",
    "stale_snapshot_regression_allowed": false,
    "rollback_requires_newer_independent_failure": true,
    "rollback_handle": "disable ct-penta-census-native-due-v1 and retain census history"
  },
  "authority_expansion": false
}
