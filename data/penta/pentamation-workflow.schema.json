{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/pentamation-workflow-v1.json",
  "title": "PentaMation Executable Workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "version",
    "trigger",
    "risk_class",
    "authority_ref",
    "owner",
    "idempotency_key_strategy",
    "human_gate",
    "retry_policy",
    "compensation",
    "steps",
    "terminal_verify",
    "preserve"
  ],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^penta\\.mation\\.[a-z0-9._-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": {"enum": ["event", "schedule", "manual", "dependency"]},
        "source": {"type": "string", "minLength": 1},
        "schedule_ref": {"type": ["string", "null"]},
        "event_type": {"type": ["string", "null"]}
      }
    },
    "risk_class": {"enum": ["D0", "D1", "D2", "D3"]},
    "authority_ref": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "idempotency_key_strategy": {"enum": ["explicit", "workflow_version_input_hash"]},
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "policy_ref"],
      "properties": {
        "required": {"type": "boolean"},
        "policy_ref": {"type": ["string", "null"]},
        "required_role": {"type": ["string", "null"]},
        "quorum": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "backoff_seconds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "rollback", "remedy", "manual"]},
        "handler": {"type": ["string", "null"]},
        "contract_ref": {"type": ["string", "null"]}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "handler", "depends_on", "params", "verify"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
          "handler": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "params": {"type": "object"},
          "verify": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["handler_receipt", "equals", "non_null", "custom"]},
              "expected": {},
              "verifier": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "terminal_verify": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
