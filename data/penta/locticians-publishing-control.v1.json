{
  "schema": "ct.integration.locticians-publishing-control.v1",
  "version": "1.0.0",
  "environment": "production",
  "surface_id": "ct.surface.locticians.production",
  "platform_id": "ct.platform.locticians",
  "adapter_id": "ct.adapter.brilliant-directories.locticians.v1",
  "route_id": "ct.route.locticians.bd-articles.production.v1",
  "publisher_agent_id": "ct.pentamarketer.agent.publisher",
  "publisher_persona_id": "ct.persona.locticians.publisher.kiara.v1",
  "expected_persona_count": 39,
  "provider_contract": {
    "create_path": "/api/v2/data_posts/create",
    "read_path_template": "/api/v2/data_posts/get/{post_id}",
    "required_identifiers": ["user_id", "data_id", "data_type"],
    "identifiers": {
      "user_id": 7569,
      "user_id_state": "candidate_from_verified_bounded_member_write_not_article_canary_verified",
      "data_id": null,
      "data_id_state": "unresolved_site_specific_post_type_identifier",
      "data_type": 20,
      "data_type_state": "documented_single_image_post_contract"
    },
    "write_canary_required": true,
    "read_after_write_required": true,
    "rollback_canary_required": true,
    "open_state": false,
    "hold_reason": "site_specific_data_id_and_article_write_rollback_canaries_not_yet_verified"
  },
  "image_rights_gate": {
    "required_when_image_present": true,
    "rights_state_required": "verified",
    "provenance_ref_required": true,
    "source_ref_required": true,
    "alt_text_required": true,
    "accepted_rights_bases": ["owned", "licensed", "public_domain", "provider_permitted"],
    "missing_or_unverified_action": "quarantine"
  },
  "authority": {
    "publisher_may_request_provider_publish": true,
    "publisher_may_bypass_release_gate": false,
    "non_publishers_direct_provider_write": false,
    "all_other_personas_handoff_only": true,
    "requires_chlom_invocation": true,
    "requires_readback": true
  },
  "offer_claim_gate": {
    "offer_ref": "locticians.claimmonth50.v1",
    "verified_public_scope": ["Community+ Member", "Basic"],
    "claimable_listings_only": true,
    "checkout_verification_may_remain_pending": true,
    "prohibited_until_checkout_verified": ["all plans", "higher-tier savings", "lifetime discount", "guaranteed recurring duration"]
  }
}
