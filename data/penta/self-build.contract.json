{
  "schema_version": "1.1.0",
  "contract_id": "ct.penta.self-build.v1",
  "owner": "CrownThrive LLC",
  "status": "production_control_contract",
  "applies_to_all_registered_members": true,
  "gap_intake": "PentaRFA",
  "builder": "PentaFactory",
  "originator_self_certifier": "self",
  "final_certifier": "PentaCertify",
  "assurance": ["PentaAssure", "PentaQuality", "PentaSecurity"],
  "release_path": ["PentaBuild", "PentaSuite", "PentaCertify", "PentaRelease", "PentaPR", "PentaMerge", "PentaCloser"],
  "required_gates": {
    "typed_gap_required": true,
    "penta_factory_builder_required": true,
    "originator_self_certification_required": true,
    "originator_evidence_blob_required": true,
    "gate_awareness_required": true,
    "independent_final_certification_required": true,
    "independent_certification_required": true,
    "negative_and_stress_tests_required": true,
    "rollback_required": true,
    "license_provenance_required": true,
    "security_review_required": true,
    "exact_source_and_artifact_required": true,
    "provider_binding_and_readback_required_for_provider_effects": true,
    "provider_gate_results_may_not_be_manufactured": true,
    "dail_binding_required_before_institutional_pass": true,
    "authority_never_manufactured": true,
    "d3_human_reserved": true
  },
  "self_certification_semantics": {
    "state": "SELF_CERTIFIED",
    "meaning": "The originating Penta attests its own exact candidate, tests, evidence, rollback and source identity before submitting to institutional gates.",
    "may_submit_own_evidence": true,
    "may_write_own_evidence_blobs": true,
    "may_write_own_continuity_receipts": true,
    "does_not_replace_independent_final_gate": true,
    "head_change_invalidates_prior_self_certification": true
  },
  "candidate_schema_path": "schemas/penta/self-build-candidate.schema.json",
  "runtime_path": "runtime/penta_self_build.py",
  "test_path": "tests/test_penta_self_build.py",
  "pr_gate_awareness_policy": "config/penta_pr_gate_awareness.json",
  "workflow_path": ".github/workflows/penta-institutional-services.yml"
}
