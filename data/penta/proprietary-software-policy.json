{
  "schema_version": "1.0.0",
  "policy_id": "crownthrive.penta.proprietary-software.v1",
  "owner": "CrownThrive LLC",
  "enforcement_owner": "PentaLegal + PentaPolicy + PentaScribe + PentaAssure + PentaSerialized + PentaRelease",
  "mode": "fail_closed",
  "license_file": "LICENSE",
  "required_license_strings": [
    "CROWNTHRIVE PUBLIC REPOSITORY LICENSE, INTELLECTUAL PROPERTY, MACHINE-USE, AND INSTITUTIONAL KNOWLEDGE NOTICE",
    "All Rights Reserved",
    "Copyright © 2026 CrownThrive, LLC. All rights reserved.",
    "Public visibility is not an open-source, open-content, patent, trademark, model-training, data-mining, commercial-use, or derivative-work license",
    "Technical ability is not permission."
  ],
  "protected_roots": [
    "runtime/",
    "penta/",
    "scripts/",
    "data/penta/",
    "schemas/penta/",
    "docs/phase3/",
    "automation/",
    "pentarelease/",
    ".pentarelease/"
  ],
  "source_extensions": [".py", ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".go", ".rs", ".java", ".sh", ".ps1", ".sql"],
  "third_party_allowlist_roots": [
    "vendor/",
    "third_party/",
    "third-party/",
    "node_modules/"
  ],
  "incompatible_first_party_spdx_identifiers": [
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "LGPL-2.1-only",
    "LGPL-3.0-only",
    "MPL-2.0",
    "ISC",
    "Unlicense",
    "CC0-1.0"
  ],
  "release_prohibited_path_patterns": [
    "(^|/)\\.env($|\\.)",
    "(^|/)secrets?($|/)",
    "(^|/)credentials?($|/)",
    "(^|/)vault($|/)",
    "(^|/)private[-_]?keys?($|/)",
    "\\.(pem|p12|pfx|key)$"
  ],
  "release_prohibited_content_patterns": [
    "-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
    "AKIA[0-9A-Z]{16}",
    "sk-proj-[A-Za-z0-9_-]{20,}",
    "ghp_[A-Za-z0-9]{20,}"
  ],
  "required_release_artifacts": [
    "MANIFEST.json",
    "RELEASE_NOTES.md",
    "SHA256SUMS"
  ],
  "required_controls": {
    "license_presence": true,
    "first_party_spdx_conflict_scan": true,
    "secret_path_scan": true,
    "secret_content_scan": true,
    "deterministic_receipt": true,
    "penta_serialized_preservation": true,
    "release_provider_readback": true,
    "hold_never_promoted_by_version_only": true
  },
  "legal_boundary": "This policy operationalizes repository controls around CrownThrive's existing rights notice. It does not itself create, enlarge, register, adjudicate, or guarantee any intellectual-property right and does not override applicable law or valid third-party licenses."
}
