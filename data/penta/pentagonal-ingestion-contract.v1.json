{
  "schema_version": "1.0.0",
  "contract_id": "crownthrive.penta.pentagonal-ingestion.v1",
  "purpose": "Defines the minimum machine-readable boot, routing, execution-gate, handoff, evidence, and failure semantics for agents and Pentas consuming CrownThrive OS Penta knowledge.",
  "authority_invariant": "Documentation, terminology, taxonomy, routing metadata, machine manifests, and provider reachability do not create execution authority, certification, or production state.",
  "state_invariant": [
    "DOCUMENTED",
    "DISCOVERABLE",
    "ROUTABLE",
    "EXECUTION_ELIGIBLE",
    "AUTHORIZED",
    "TESTED",
    "CERTIFIED",
    "RELEASED",
    "PRODUCTION"
  ],
  "boot_order": [
    "data/penta/pentagonal-reference.v1.json",
    "data/penta/agent-knowledge.v1.json",
    "data/penta/operational-knowledge.v1.json#target-record",
    "target canonical API/MCP/event/data/state contract",
    "current PentaStatus/readiness",
    "current CHLOM/authority trace",
    "dependency health",
    "applicable provider binding",
    "idempotency/retry policy",
    "expected readback/evidence destination"
  ],
  "routing_pipeline": [
    "normalize_intent_to_jobs",
    "filter_by_layers",
    "filter_by_family_if_useful",
    "prefer_canonical_identity",
    "reject_noncanonical_independent_execution",
    "verify_execution_eligibility",
    "verify_readiness",
    "verify_authority",
    "verify_dependencies",
    "verify_provider_binding_if_applicable",
    "select_narrowest_canonical_interface",
    "preserve_context",
    "execute_bounded_action",
    "read_back_actual_state",
    "emit_evidence",
    "reconcile_or_escalate"
  ],
  "required_context": [
    "task_or_correlation_id",
    "origin_identity",
    "target_identity",
    "requested_job",
    "contract_version",
    "authority_context",
    "risk_or_data_classification_if_applicable",
    "dependency_assumptions",
    "idempotency_or_replay_context",
    "expected_output",
    "expected_readback",
    "evidence_destination",
    "timeout_and_escalation_semantics"
  ],
  "execution_gate": {
    "must_be_true": [
      "target identity is canonical or execution is explicitly routed to canonical target",
      "registry permits entry into execution decision path",
      "current readiness is acceptable for the requested action",
      "current authority covers the exact action and scope",
      "required dependencies are healthy or explicitly degraded-safe",
      "applicable provider binding exists for external execution",
      "retry/idempotency semantics are known for material writes",
      "expected readback and evidence destination are known"
    ],
    "must_fail_closed_when_unknown": [
      "canonical identity",
      "authority",
      "high-consequence rights/legal/economic constraints",
      "critical dependency state",
      "material-write replay safety",
      "required provider binding",
      "recovery or evidence path"
    ]
  },
  "forbidden_inferences": [
    "Penta name implies authority",
    "candidate identity implies canonical execution",
    "documentation implies production",
    "test pass implies certification",
    "merge implies deployment",
    "deployment implies provider convergence",
    "credential possession implies authorization",
    "transport reachability implies authority",
    "one successful provider request proves system-wide health",
    "elapsed time converts HOLD to PASS"
  ],
  "ambiguity_routes": {
    "identity_or_terminology": ["document", "search", "govern"],
    "readiness_or_health": ["observe", "assure", "recover"],
    "authority": ["govern", "certify", "escalate"],
    "provider_result": ["readback", "reconcile", "recover"],
    "contract_or_schema": ["document", "build", "test"],
    "candidate_penta": ["document", "govern", "canonicalize"]
  },
  "evidence_minimum": [
    "subject",
    "assertion",
    "scope_or_environment",
    "timestamp_or_effective_period",
    "source_or_provider",
    "actor_or_authority_context",
    "request_or_action_identity",
    "target_result_or_readback",
    "correlation_or_idempotency_context",
    "evidence_or_DAIL_location_if_applicable"
  ],
  "penta_record_minimum": [
    "identity",
    "machine_key",
    "namespace_state",
    "canonical_target",
    "family",
    "pentagonal_axes",
    "layers",
    "jobs",
    "lifecycle_stages",
    "audiences",
    "classification_provenance",
    "role",
    "scope",
    "non_authorities",
    "when_to_use",
    "when_not_to_use",
    "prerequisites",
    "routing_actions",
    "forbidden_actions",
    "dependencies",
    "interfaces",
    "data_contracts",
    "authority_requirements",
    "provider_bindings",
    "readiness_projection",
    "execution_eligibility_projection",
    "risk_projection",
    "reliability_contract",
    "observability_contract",
    "evidence_contract",
    "runbooks",
    "tests",
    "release_contract",
    "agent_instructions",
    "escalation",
    "freshness",
    "source_refs",
    "record_sha256"
  ],
  "source_refs": [
    "PENTAGONAL-KNOWLEDGE-STANDARD.md",
    "PENTAGONAL-FULL-SUITE-SPECIFICATION.md",
    "PENTA-PORTAL-STANDARD.md",
    "data/penta/pentagonal-reference.v1.json",
    "data/penta/agent-knowledge.v1.json",
    "data/penta/operational-knowledge.v1.json"
  ]
}
