{
  "schema_version": "1.0.0",
  "contract_id": "crownthrive.penta.member-runtime",
  "status": "implemented",
  "runtime": "runtime/penta_exec.py",
  "adapter_registry": "data/penta/execution-adapters.registry.json",
  "request_schema": "schemas/penta/execution-request.schema.json",
  "receipt_schema": "schemas/penta/execution-receipt.schema.json",
  "authority_invariant": "The member runtime makes registered Penta systems addressable and operable without promoting their maturity or manufacturing authority.",
  "control_plane_actions": ["list", "status", "validate", "handoff", "invoke"],
  "invariants": {
    "all_registered_members_status_addressable": true,
    "unknown_members_fail_closed": true,
    "member_invocation_requires_static_adapter": true,
    "execute_effect_requires_certified_or_production_maturity": true,
    "interop_envelope_required_before_adapter_handler": true,
    "trace_and_idempotency_preserved": true,
    "evidence_reference_required_for_invocation": true,
    "provider_effect_adapters_disabled_in_v1": true,
    "arbitrary_shell_execution_disabled": true,
    "arbitrary_dynamic_import_disabled": true,
    "credential_material_never_accepted": true,
    "d3_authority_never_automatic": true,
    "member_maturity_never_auto_promoted": true
  },
  "v1_builtin_adapters": ["penta.fabric:family_snapshot", "penta.beata:heartbeat", "penta.mesh:route_check"],
  "promotion_rule": "Additional member operations become executable only after a bounded handler is implemented, tested, entered into the adapter registry, and any execute/provider path passes existing PentaCertify, CHLOM/DAIL, PentaHybrid, credential, readback, and evidence gates."
}
