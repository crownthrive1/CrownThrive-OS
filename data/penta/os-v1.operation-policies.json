{
  "schema": "crownthrive.penta.os-v1.operation-policies.v1",
  "policy_version": "1.5.0",
  "default_disposition": "HOLD_UNKNOWN_OPERATION",
  "authority_trace_pattern": "^A[0-3]:[A-Za-z0-9][A-Za-z0-9._:@/-]{2,239}$",
  "policies": [
    {
      "operation": "inspect",
      "scope": "all_members",
      "machine_keys": [],
      "effect": "read",
      "risk_class": "D0",
      "minimum_authority": "A0",
      "dependency_ready_required": false,
      "human_approval_required": false,
      "provider_binding_required": false,
      "readback_required": false
    },
    {
      "operation": "render_glossary",
      "scope": "machine_keys",
      "machine_keys": ["penta.scribe"],
      "effect": "local_compute",
      "risk_class": "D1",
      "minimum_authority": "A1",
      "dependency_ready_required": false,
      "human_approval_required": false,
      "provider_binding_required": false,
      "readback_required": false
    },
    {
      "operation": "reconcile",
      "scope": "all_members",
      "machine_keys": [],
      "effect": "local_write_handoff",
      "risk_class": "D2",
      "minimum_authority": "A1",
      "dependency_ready_required": true,
      "human_approval_required": false,
      "provider_binding_required": false,
      "readback_required": false
    },
    {
      "operation": "publish",
      "scope": "machine_keys",
      "machine_keys": ["penta.docs", "penta.green", "penta.marketer", "penta.scribe"],
      "effect": "provider_write",
      "risk_class": "D2",
      "minimum_authority": "A2",
      "dependency_ready_required": true,
      "human_approval_required": false,
      "provider_binding_required": true,
      "readback_required": true
    },
    {
      "operation": "email_send",
      "scope": "machine_keys",
      "machine_keys": ["penta.mail", "penta.marketer"],
      "effect": "provider_write",
      "risk_class": "D2",
      "minimum_authority": "A2",
      "dependency_ready_required": true,
      "human_approval_required": false,
      "provider_binding_required": true,
      "readback_required": true
    },
    {
      "operation": "delete",
      "scope": "all_members",
      "machine_keys": [],
      "effect": "destructive_handoff",
      "risk_class": "D3",
      "minimum_authority": "A3",
      "dependency_ready_required": true,
      "human_approval_required": true,
      "provider_binding_required": false,
      "readback_required": false
    }
  ]
}
