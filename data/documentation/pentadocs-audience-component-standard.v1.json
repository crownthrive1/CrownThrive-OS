        "Info",
        "Warning",
        "table",
        "Mermaid"
      ]
    },
    "public": {
      "template": "templates/pentadocs/public.mdx.template",
      "required_sections": [
        "What this helps you do",
        "Availability and eligibility",
        "How it works",
        "Options and expected outcome",
        "Privacy, payment, rights, and accessibility",
        "Troubleshooting",
        "Get help"
      ],
      "preferred_components": [
        "Columns",
        "Card",
        "Steps",
        "Tabs",
        "Info",
        "Warning",
        "table"
      ]
    },
    "operator": {
