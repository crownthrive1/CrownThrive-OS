    "rights_support": {
      "template": "templates/pentadocs/rights-support.mdx.template",
      "required_sections": [
        "Plain-language summary",
        "Scope and applicability",
        "Current evidence state",
        "Permitted and prohibited activity",
        "Intake requirements",
        "Review process",
        "Authority and decision boundary",
        "Evidence and privacy handling",
        "Outcome, remedy, response, or appeal",
        "Contact and escalation"
      ],
      "preferred_components": [
        "Warning",
        "Danger",
        "Info",
        "Tabs",
