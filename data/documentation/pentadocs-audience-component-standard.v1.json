        "Current state and evidence",
        "Strategic fit",
        "Authority and accountable owner",
        "Metrics and impact",
        "Risks, blockers, and dependencies",
        "Decision or next milestone",
        "Continuity and related records"
      ],
      "preferred_components": [
        "Columns",
