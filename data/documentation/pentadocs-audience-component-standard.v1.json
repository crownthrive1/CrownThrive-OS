{
  "manifest_id": "ct.standard-manifest.pentadocs-audience-components.v1",
  "manifest_version": "1.0.0",
  "standard_version": "1.0.0",
  "status": "candidate",
  "effective_at": null,
  "owner_role": "penta_docs_governance",
  "standard_page": "standards/pentadocs-audience-and-component-standard.mdx",
  "profile_schema": "schemas/documentation/pentadocs-page-profile.schema.json",
  "governing_records": [
    "standards/record-and-format-standard.mdx",
    "standards/evidence-claims-and-proof-standard.mdx",
    "standards/documentation-source-of-truth-and-autonomous-governance.mdx",
    "standards/documentation-reconciliation-continuity-framework.mdx",
    "standards/search-seo-metadata-robots.mdx",
    "standards/versioning-change-control-and-correction.mdx",
    "knowledge/historical-context-boundary.mdx",
    "support/articleization-manifest-and-autopublication-contract.mdx"
  ],
  "provider_sources": [
    "https://www.mintlify.com/docs/components",
    "https://www.mintlify.com/docs/components/columns",
    "https://www.mintlify.com/docs/components/steps",
    "https://www.mintlify.com/docs/components/tabs",
    "https://www.mintlify.com/docs/components/fields",
    "https://www.mintlify.com/docs/components/examples",
    "https://www.mintlify.com/docs/components/expandables",
    "https://www.mintlify.com/docs/components/callouts",
    "https://www.mintlify.com/docs/components/visibility",
    "https://www.mintlify.com/docs/components/update"
  ],
  "frontmatter_contract": {
    "required": [
      "title",
      "description",
      "standard_version",
      "primary_audience",
      "page_type",
      "content_state"
    ],
    "recommended": [
      "article_id",
      "last_verified_at",
      "evidence_level",
      "source_refs"
    ],
    "primary_audience": [
      "executive",
      "public",
      "operator",
      "developer",
      "rights_support",
      "historical"
    ],
    "page_type": [
      "orientation",
      "doctrine",
      "registry",
      "reference",
      "status",
      "workflow",
      "runbook",
      "standard",
      "support",
      "how_to",
      "policy",
      "legal",
      "developer",
      "changelog",
      "historical_record",
      "redirect"
    ],
    "content_state": [
      "current",
      "current_with_holds",
      "candidate",
      "historical",
      "superseded",
      "unresolved"
    ]
  },
  "orientation_contract": {
    "contract_version": "2.0.0",
    "marker": "{/* pentadocs:audience-orientation:v2 */}",
    "closing_marker": "{/* /pentadocs:audience-orientation:v2 */}",
    "allowed_callouts": [
      "Info",
      "Note",
      "Warning"
    ],
    "required_labels": [
      "Audience:",
      "This page:",
      "Documentation state:"
    ],
    "universal_non_certification_boundary": "Documentation state is editorial posture only; it does not certify runtime, deployment, legal, rights, financial, provider, production, release, security, or operational status.",
    "links": {
      "minimum_count": 2,
      "managed_count": 2,
      "root_relative": true,
      "distinct": true,
      "existing_target": true,
      "self_link_allowed": false,
      "redirect_source_allowed": false,
      "custom_additional_valid_links_allowed": true,
      "selection_order": "deterministic_audience_then_governing_fallback"
    },
    "redirect_exempt": true,
    "historical_callout": "Warning",
    "historical_required_sentence": "This page is dated context, not current operating authority.",
    "unresolved_required_lines": [
      "**Unresolved reason:** no explicit page-level editorial acceptance state was declared in the migrated source.",
      "**Evidence needed:** an accepted governing source or accountable-owner attestation.",
      "**Review role:** PentaDocs governance.",
      "**Review trigger:** next material edit or source reconciliation."
    ],
    "profile_modes": [
      "managed_v2",
      "custom",
      "redirect_exempt"
    ],
    "profile_mode_source": "generated_page_profile_manifest_only_not_page_frontmatter",
    "managed_input": {
      "schema": "crownthrive.pentadocs.audience-orientation-input/v2",
      "source_fields": [
        "title",
        "description",
        "primary_audience",
        "page_type",
        "content_state"
      ],
      "additional_input": "two_ordered_selected_link_label_target_records",
      "route_included": false,
      "unicode_normalization": "NFC",
      "whitespace_normalization": "collapse_to_single_ascii_space",
      "mdx_escape": "single_pass_from_decoded_source_characters",
      "canonical_encoding": "compact_sorted_key_utf8_json",
      "digest": "sha256"
    },
    "profile_hashes": {
      "orientation_input_sha256": "canonical_managed_or_custom_input_digest",
      "orientation_render_sha256": "exact_bounded_orientation_utf8_bytes_digest"
    },
    "migration": {
      "replace_only_exact_known_generated_v1": true,
      "preserve_registered_custom_prose": true,
      "managed_human_edit_requires_custom_override": true,
      "idempotent": true,
      "normalized_substantive_body_preserved": true
    },
    "required_corpus_metrics": {
      "page_specific_orientation_rate": 1.0,
      "generic_v1_page_count": 0,
      "self_link_page_count": 0,
      "invalid_link_page_count": 0,
      "input_collision_groups": 0,
      "input_collision_excess": 0,
      "render_collision_groups": 0,
      "render_collision_excess": 0
    }
  },
  "redirect_contract": {
    "page_type": "redirect",
    "required": {
      "content_state": "superseded",
      "deprecated": true,
      "noindex": true
    },
    "redirect_to": {
      "root_relative": true,
      "external_target_allowed": false,
      "chain_allowed": false,
      "loop_allowed": false
    },
    "exemptions": [
      "audience_orientation",
      "substantive_body",
      "h1_richness",
      "historical_boundary_body"
    ]
  },
  "archetypes": {
