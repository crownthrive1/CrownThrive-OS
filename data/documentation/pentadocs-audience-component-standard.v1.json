      ]
    }
  },
  "component_semantics": {
    "Columns": "Responsive layout; use instead of CardGroup and prefer two columns for substantive content.",
    "Steps": "Sequential actions or events only.",
    "Tabs": "Equivalent options, platforms, versions, or languages; never access control.",
    "Expandable": "Nested API request or response properties, not generic FAQ content.",
    "Update": "Dated changelog, release note, or product update; not a generic current-state box.",
    "Visibility": "Human-web versus agent-Markdown rendering only; never authentication, redaction, or privacy control.",
    "ParamField": "Exact API or SDK request field bound to a contract.",
    "ResponseField": "Exact API response field bound to a contract.",
    "RequestExample": "Titled request code shown in a sidebar on desktop and inline on mobile.",
    "ResponseExample": "Titled response code shown in a sidebar on desktop and inline on mobile.",
    "Prompt": "Intentional public-safe copyable AI prompt only.",
    "Badge": "Inline label or status metadata; never self-certification.",
    "Warning": "Material caution, hold, or boundary with prohibited action.",
    "Danger": "Irreversible, destructive, legal, financial, privacy, or security risk."
  },
  "claim_boundaries": {
    "content_state_is_not_runtime_state": true,
    "current_claims_require_scope_date_source_and_evidence": true,
    "historical_sources_have_zero_implementation_authority": true,
    "provider_capability_is_not_crownthrive_authority": true,
    "source_acceptance_is_not_projection_deployment": true,
    "projection_readback_is_not_runtime_certification": true,
    "validation_is_not_certification": true,
    "self_certification_prohibited": true
  },
  "status_language": {
    "current": "CURRENT — VERIFIED AS OF [date]",
    "target": "TARGET — not current-state proof",
    "historical": "HISTORICAL — dated context only",
    "hold": "HOLD — name the missing predicate and prohibited action",
    "blocked": "BLOCKED — name dependency, owner, evidence, and next review",
    "failed": "FAILED — no PASS issued",
    "pass": "PASS — exact assertion, environment, timestamp, and evidence",
    "degraded": "DEGRADED — identify working scope, failed scope, workaround, and escalation",
    "certified": "CERTIFIED — authorized certification record required"
  },
  "validation_certification_boundary": {
    "source_parse": "Syntax and machine readability only.",
    "structural_validation": "Required metadata, orientation, sections, and component semantics only.",
    "source_acceptance": "Governed source revision accepted; no projection or runtime claim.",
    "projection_readback": "Specific rendered page retrieved; no underlying runtime claim.",
    "runtime_verification": "Exact operation and evidence scope only.",
    "certification": "Authorized certification record for exact scope, version, environment, and validity period."
  }
}
