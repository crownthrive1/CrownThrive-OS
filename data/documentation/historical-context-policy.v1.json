{
  "schema_version": "1.0.0",
  "policy_id": "ct.policy.historical-context-boundary.v1",
  "canonical_name": "Historical Context Boundary",
  "effective_date": "2026-08-26",
  "default_mode": "historical_only",
  "principle": "Historical and latent material may inform context but may never independently authorize implementation or execution.",
  "historical_classes": {
    "HISTORICAL_CONTEXT": {
      "context_use": true,
      "latent_consideration": true,
      "implementation_authority": "none",
      "execution_authority": "none",
      "production_proof": false
    },
    "LATENT_CONTEXT": {
      "context_use": true,
      "latent_consideration": true,
      "implementation_authority": "none",
      "execution_authority": "none",
      "production_proof": false
    },
    "RESTRICTED_HISTORICAL": {
      "context_use": "minimum_necessary",
      "latent_consideration": true,
      "public_body": false,
      "implementation_authority": "none",
      "execution_authority": "none",
      "production_proof": false
    },
    "SUPERSEDED": {
      "context_use": true,
      "latent_consideration": false,
      "implementation_authority": "none",
      "execution_authority": "none",
      "production_proof": false
    },
    "PRIVATE_CONTEXT": {
      "context_use": "private_only",
      "latent_consideration": false,
      "public_body": false,
      "implementation_authority": "none",
      "execution_authority": "none",
      "production_proof": false
    },
    "UNKNOWN_HOLD": {
      "context_use": "hold",
      "latent_consideration": false,
      "implementation_authority": "none",
      "execution_authority": "none",
      "production_proof": false
    }
  },
  "prohibited_direct_actions": [
    "production_implementation",
    "deployment",
    "provider_write",
    "money_movement",
    "billing_change",
    "token_mint",
    "token_transfer",
    "token_launch",
    "bridge_activation",
    "governance_vote",
    "governance_appointment",
    "governance_removal",
    "rights_grant",
    "rights_transfer",
    "rights_revocation",
    "security_policy_change",
    "credential_operation",
    "current_state_assertion",
    "current_legal_conclusion",
    "agent_auto_promotion"
  ],
  "promotion_contract": {
    "automatic_promotion": false,
    "new_current_record_required": true,
    "required_fields": [
      "historical_source_reference",
      "specific_reused_concept",
      "current_owner",
      "current_evidence",
      "legal_security_commercial_review_as_applicable",
      "implementation_requirements",
      "test_requirements",
      "rollback_or_correction_path",
      "approval_class",
      "explicit_current_authority_statement"
    ]
  },
  "confidentiality": {
    "archival_classification_does_not_make_private_material_public": true,
    "restricted_body_publication": false,
    "contract_effect_modified_by_archive_classification": false
  }
}
