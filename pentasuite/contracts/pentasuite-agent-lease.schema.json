{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/contracts/pentasuite-agent-lease.schema.json",
  "title": "PentaSuite Agent Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "blueprint_id",
    "agent_key",
    "state",
    "ttl_seconds",
    "scope_envelope",
    "scale_ceiling",
    "rollback_contract"
  ],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "blueprint_id": { "type": "string", "format": "uuid" },
    "agent_key": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "staged",
        "active",
        "conditional",
        "remediation",
        "restricted",
        "suspended",
        "rollback_pending",
        "rolled_back",
        "expired",
        "revoked",
        "barred",
        "completed"
      ]
    },
    "lease_generation": { "type": "integer", "minimum": 1 },
    "ttl_seconds": { "type": "integer", "minimum": 1 },
    "starts_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "remediation_due_at": { "type": ["string", "null"], "format": "date-time" },
    "scope_envelope": { "type": "object" },
    "scale_ceiling": { "type": "object" },
    "conditions": { "type": "array" },
    "strike_count": { "type": "integer", "minimum": 0 },
    "rollback_contract": { "type": "object" },
    "reapply_after": { "type": ["string", "null"], "format": "date-time" },
    "status_reason": { "type": ["string", "null"] }
  }
}
