{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/contracts/pentarfa-agent-request.schema.json",
  "title": "PentaRFA Agent Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_key",
    "request_kind",
    "requester_ref",
    "agent_key",
    "display_name",
    "purpose",
    "job_contract",
    "requested_scope",
    "requested_scale",
    "requested_ttl_seconds",
    "authority_class"
  ],
  "properties": {
    "request_key": { "type": "string", "minLength": 1 },
    "request_kind": { "enum": ["new_agent", "amendment", "renewal", "reapplication"] },
    "parent_request_id": { "type": ["string", "null"], "format": "uuid" },
    "requester_ref": { "type": "string", "minLength": 1 },
    "agent_key": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "job_contract": { "type": "object" },
    "requested_scope": { "type": "object" },
    "requested_scale": { "type": "object" },
    "requested_ttl_seconds": { "type": "integer", "minimum": 1 },
    "authority_class": { "enum": ["D0", "D1", "D2", "D3"] }
  }
}
