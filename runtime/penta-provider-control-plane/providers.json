{
  "schema": "ct.penta.provider-control-plane.v1",
  "version": "1.1.0",
  "institutional_phase": "phase_3",
  "priority": "software",
  "policy": {
    "fail_closed": true,
    "required_provider_certifications": [
      "github",
      "supabase",
      "vercel",
      "stripe",
      "resend",
      "mailgun",
      "slack",
      "elevenlabs"
    ],
    "credential_values_in_state": false,
    "credential_values_in_cookies": false,
    "certification_requires_live_provider_readback": true,
    "write_requires_exact_operation_readback": true,
    "certification_ttl_hours": 24,
    "cookie_role": "signed_non_sensitive_priority_health_pointer_only"
  },
  "providers": [
    {
      "provider_id": "github",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "github_token",
      "credential_sets": [{"all_of": ["GITHUB_TOKEN"]}],
      "certification_probe": {
        "operation": "repository_read",
        "method": "GET",
        "url_template": "https://api.github.com/repos/{GITHUB_REPOSITORY}",
        "required_env": ["GITHUB_REPOSITORY"],
        "auth": {"type": "bearer", "env": "GITHUB_TOKEN"},
        "headers": {"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2026-03-10"},
        "success_http": [200]
      },
      "adapter": {
        "adapter_id": "ct.adapter.github.v1",
        "version": "1.1.0",
        "operations": [
          {"operation": "repository_read", "side_effect": false, "authority_class": "D0", "requires_readback": true},
          {"operation": "contents_write", "side_effect": true, "authority_class": "D1", "requires_readback": true},
          {"operation": "branch_write", "side_effect": true, "authority_class": "D1", "requires_readback": true},
          {"operation": "workflow_dispatch", "side_effect": true, "authority_class": "D1", "requires_readback": true}
        ]
      },
      "evidence_hints": [".github/workflows/crownthrive-factory-github-provider.yml", "https://docs.github.com/en/rest/repos/repos#get-a-repository"]
    },
    {
      "provider_id": "supabase",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "anon_read_key",
      "credential_sets": [{"all_of": ["SUPABASE_URL", "SUPABASE_ANON_KEY"]}],
      "certification_probe": {
        "operation": "health_read",
        "method": "GET",
        "url_template": "{SUPABASE_URL}/rest/v1/",
        "required_env": ["SUPABASE_URL"],
        "auth": {"type": "supabase", "env": "SUPABASE_ANON_KEY"},
        "success_http": [200]
      },
      "adapter": {
        "adapter_id": "ct.adapter.supabase.v1",
        "version": "1.1.0",
        "operations": [
          {"operation": "health_read", "side_effect": false, "authority_class": "D0", "requires_readback": true},
          {"operation": "function_invoke", "side_effect": true, "authority_class": "D1", "requires_readback": true},
          {"operation": "state_write", "side_effect": true, "authority_class": "D1", "requires_readback": true}
        ]
      },
      "evidence_hints": [".github/workflows/crownthrive-factory-github-provider.yml"]
    },
    {
      "provider_id": "vercel",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "bearer_token",
      "credential_sets": [{"all_of": ["VERCEL_TOKEN"]}],
      "certification_probe": {
        "operation": "deployment_read",
        "method": "GET",
        "url_template": "https://api.vercel.com/v2/user",
        "required_env": [],
        "auth": {"type": "bearer", "env": "VERCEL_TOKEN"},
        "success_http": [200]
      },
      "adapter": {
        "adapter_id": "ct.adapter.vercel.v1",
        "version": "1.1.0",
        "operations": [
          {"operation": "deployment_read", "side_effect": false, "authority_class": "D0", "requires_readback": true},
          {"operation": "deployment_create", "side_effect": true, "authority_class": "D1", "requires_readback": true}
        ]
      },
      "evidence_hints": ["https://vercel.com/docs/integrations/create-integration/vercel-api-integrations"]
    },
    {
      "provider_id": "stripe",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "secret_key",
      "credential_sets": [{"all_of": ["STRIPE_SECRET_KEY"]}],
      "certification_probe": {
        "operation": "balance_read",
        "method": "GET",
        "url_template": "https://api.stripe.com/v1/balance",
        "required_env": [],
        "auth": {"type": "basic_env_username", "username_env": "STRIPE_SECRET_KEY", "password": ""},
        "success_http": [200]
      },
      "adapter": {
        "adapter_id": "ct.adapter.stripe.v1",
        "version": "2.0.0",
        "transport_variants": [
          {
            "adapter_id": "ct.adapter.stripe.mcp.v1",
            "role": "operator_transport",
            "authority": "inherits_ct.adapter.stripe.v1"
          },
          {
            "adapter_id": "ct.adapter.stripe.runtime.v1",
            "role": "typed_runtime_transport",
            "authority": "inherits_ct.adapter.stripe.v1"
          },
          {
            "adapter_id": "ct.adapter.stripe.webhook.v3",
            "role": "signed_event_transport",
            "authority": "inherits_ct.adapter.stripe.v1"
          },
          {
            "adapter_id": "ct.adapter.stripe.catalog-mirror.v2",
            "role": "provider_readback_transport",
            "authority": "inherits_ct.adapter.stripe.v1"
          }
        ],
        "operations": [
          {"operation": "balance_read", "side_effect": false, "authority_class": "D0", "requires_readback": true},
          {"operation": "product_write", "side_effect": true, "authority_class": "D2", "requires_readback": true},
          {"operation": "price_write", "side_effect": true, "authority_class": "D2", "requires_readback": true},
          {"operation": "payment_link_write", "side_effect": true, "authority_class": "D2", "requires_readback": true},
          {"operation": "webhook_reconcile", "side_effect": true, "authority_class": "D2", "requires_readback": true}
        ]
      },
      "evidence_hints": [
        "contracts/providers/stripe-os-monetization-mesh.v1.json",
        "supabase/migrations/20260901024551_stripe_runtime_typed_adapter_hardening_v2.sql",
        "supabase/migrations/20260901025133_stripe_pentagreen_runtime_contract_repair_v1.sql",
        "https://docs.stripe.com/api/balance/balance_retrieve",
        "https://docs.stripe.com/mcp"
      ]
    },
    {
      "provider_id": "resend",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "api_key",
      "credential_sets": [{"all_of": ["RESEND_API_KEY"]}],
      "certification_probe": {
        "operation": "domain_read",
        "method": "GET",
        "url_template": "https://api.resend.com/domains",
        "required_env": [],
        "auth": {"type": "bearer", "env": "RESEND_API_KEY"},
        "success_http": [200]
