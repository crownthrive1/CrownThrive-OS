          {"operation": "domain_read", "side_effect": false, "authority_class": "D0", "requires_readback": true},
          {"operation": "email_send", "side_effect": true, "authority_class": "D1", "requires_readback": true}
        ]
      },
      "evidence_hints": ["https://resend.com/docs/api-reference/domains/list-domains"]
    },
    {
      "provider_id": "mailgun",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "api_key",
      "credential_sets": [{"all_of": ["MAILGUN_API_KEY", "MAILGUN_DOMAIN"]}],
      "certification_probe": {
        "operation": "domain_read",
        "method": "GET",
        "url_template": "https://api.mailgun.net/v4/domains",
        "required_env": [],
        "auth": {"type": "basic_literal_username", "username": "api", "password_env": "MAILGUN_API_KEY"},
        "success_http": [200]
      },
      "adapter": {
        "adapter_id": "ct.adapter.mailgun.v1",
        "version": "1.1.0",
        "operations": [
          {"operation": "domain_read", "side_effect": false, "authority_class": "D0", "requires_readback": true},
          {"operation": "email_send", "side_effect": true, "authority_class": "D1", "requires_readback": true}
        ]
      },
      "evidence_hints": ["https://documentation.mailgun.com/docs/mailgun/api-reference/send/mailgun/domains"]
    },
    {
      "provider_id": "slack",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "bot_token",
      "credential_sets": [{"all_of": ["SLACK_BOT_TOKEN"]}],
      "certification_probe": {
        "operation": "auth_read",
        "method": "POST",
        "url_template": "https://slack.com/api/auth.test",
        "required_env": [],
        "auth": {"type": "bearer", "env": "SLACK_BOT_TOKEN"},
        "headers": {"Content-Type": "application/x-www-form-urlencoded"},
        "body": "",
        "success_http": [200],
        "json_field_equals": {"ok": true}
      },
      "adapter": {
        "adapter_id": "ct.adapter.slack.v1",
        "version": "1.1.0",
        "operations": [
          {"operation": "auth_read", "side_effect": false, "authority_class": "D0", "requires_readback": true},
          {"operation": "message_write", "side_effect": true, "authority_class": "D1", "requires_readback": true}
        ]
      },
      "evidence_hints": ["https://docs.slack.dev/reference/methods/auth.test/"]
    },
    {
      "provider_id": "elevenlabs",
      "provider_class": "vendor",
      "priority": "software",
      "auth_model": "api_key",
      "credential_sets": [{"all_of": ["ELEVENLABS_API_KEY"]}],
      "certification_probe": {
