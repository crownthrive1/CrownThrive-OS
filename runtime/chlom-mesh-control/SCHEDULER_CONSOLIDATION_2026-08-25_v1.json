{
  "schema": "ct.scheduler-consolidation.v1",
  "effective_date": "2026-08-25",
  "control_plane": "ct.control.chlom-mesh.v1",
  "production_runtime": "CrownThrive OS V2 / CHLOM + ThriveBase",
  "policy": {
    "execution_preference": [
      "thrivebase_pg_cron",
      "github_actions",
      "edge_function_or_queue_worker",
      "mintlify_workflow",
      "external_connector_relay"
    ],
    "dedupe_rule": "Never create a recurring external clock when a certified internal executor already covers the same cadence, authority ceiling, evidence contract, data-access boundary, rollback path, and failure domain.",
    "retirement_disposition": "RETIRED_SCHEDULING_SCAFFOLDING",
    "history_mode": "append_or_supersede_never_silent_delete"
  },
  "founder_authorization": {
    "date": "2026-08-25",
    "scope": "Route all compatible CrownThrive agents and subagents through the production software mesh and existing governed contracts; retire duplicate per-agent ChatGPT clocks.",
    "authority_ceiling": "D2_MAX_AUTONOMOUS",
    "d3_human_reserved": true,
    "vote_or_quorum_effect": false,
    "self_approval": false,
    "money_movement": false,
    "rights_or_entitlement_grant": false,
    "credential_disclosure": false,
    "provider_write_expansion": false,
    "direct_main_or_force_push": false
  },
  "external_failure_domains": {
    "connector_evidence_relay": {
      "schedule_id": "ct.schedule.external-evidence-relay.hourly.v1",
      "state": "RESIDUAL_EXTERNAL_BRIDGE",
      "purpose": "Execute connector-dependent duties only when no certified internal executor can satisfy the route."
    },
    "backup_and_continuity": {
      "state": "INDEPENDENT_FAILURE_DOMAIN",
      "purpose": "Preserve off-runtime recoverability, archive/readback, and continuity evidence independent of the primary execution mesh."
    },
    "communications": {
      "state": "DISABLED_UNTIL_SEPARATE_REACTIVATION",
      "purpose": "Remain separate only when external mailbox access and founder-attention triage are intentionally reactivated."
    }
  },
  "folded_logical_subroutes": [
    "agent_a_orchestration",
    "agent_b_independent_evidence",
    "agent_c_build_and_documentation",
    "agent_d_independent_gatekeeping",
    "agent_e_api_mcp_adapters",
    "agent_f_source_articleization",
    "agent_g_domain_engine_certification",
    "agent_h_webhook_delivery_certification",
    "credential_continuity",
    "engine_and_thrivebase_watch",
    "homepage_reconciliation",
    "music_maker_canon_reconciliation",
    "wallet_independent_review_dispatch",
    "sacred_history_source_monitoring",
    "framework_factory",
    "software_factory",
    "thriveevergreen",
    "cie_chlom_mesh_assurance"
  ],
  "sacred_history_source_monitoring": {
    "execution": "logical_subroute_not_standalone_clock",
    "allowed_effect": "source_evidence_receipt_only",
    "prohibited_effects": [
      "publication",
      "sku_activation",
      "money_or_credit_movement",
      "rights_or_entitlement_grant",
      "cie_or_chlom_approval_manufacture"
    ]
  },
  "verification": {
    "production_control_plane_receipt": "runtime/chlom-mesh-control/PRODUCTION_RECEIPT_2026-08-26_v1.md",
    "expected_internal_heartbeat": "pg_cron_every_5_minutes",
    "require_dail": true,
    "require_exact_identity_receipts": true,
    "require_originator_verifier_separation": true,
    "require_fail_closed_unknowns": true
  }
}
