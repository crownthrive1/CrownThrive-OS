{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/os-v1-batch-plan.schema.json",
  "title": "Penta OS V1.5 Deterministic Batch Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "runtime_version", "registry_sha256", "dependency_graph_sha256",
    "operation_policy_sha256", "all_or_none_gate", "atomic_execution_performed",
    "item_count", "items", "stages", "eligible", "disposition", "reasons",
    "provider_effect_performed", "production_certification_granted",
    "side_effect_performed", "batch_sha256"
  ],
  "properties": {
    "schema": {"const": "crownthrive.penta.batch-plan.v1"},
    "runtime_version": {"const": "1.5.0"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_graph_sha256": {"$ref": "#/$defs/sha256"},
    "operation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "all_or_none_gate": {"const": true},
    "atomic_execution_performed": {"const": false},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "items": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object"}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "eligible": {"type": "boolean"},
    "disposition": {"enum": ["READY_FOR_SPECIALIZED_EXECUTORS", "HOLD_FAIL_CLOSED"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provider_effect_performed": {"const": false},
    "production_certification_granted": {"const": false},
    "side_effect_performed": {"const": false},
    "batch_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
