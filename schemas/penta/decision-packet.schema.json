{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/decision-packet.schema.json",
  "title": "PENTA Governed Decision Packet",
  "description": "Portable decision envelope used by PENTA institutional services. A valid packet records evidence, risk, required capability and human-governance state; validity never creates authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "issuing_system",
    "action_class",
    "summary",
    "evidence_refs",
    "risk_score",
    "impact_score",
    "required_capability",
    "human_gate",
    "approvals",
    "expires_at",
    "override_policy",
    "rollback_strategy",
    "audit_correlation_id",
    "status",
    "created_at"
  ],
  "properties": {
    "packet_id": {"type": "string", "minLength": 8},
    "issuing_system": {
      "type": "string",
      "enum": [
        "penta.capital",
        "penta.impact",
        "penta.analytics",
        "penta.legal",
        "penta.risk",
        "penta.audit",
        "penta.policy",
        "penta.ethics",
        "penta.security"
      ]
    },
    "action_class": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "impact_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "required_capability": {"type": ["string", "null"]},
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "roles", "quorum"],
      "properties": {
        "required": {"type": "boolean"},
        "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "quorum": {"type": "integer", "minimum": 0}
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal", "role", "decision", "timestamp"],
        "properties": {
          "principal": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "enum": ["approve", "deny", "abstain", "recuse"]},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "override_policy": {"type": "string", "minLength": 1},
    "rollback_strategy": {"type": "string", "minLength": 1},
    "audit_correlation_id": {"type": "string", "minLength": 8},
    "status": {"type": "string", "enum": ["proposed", "approved", "rejected", "expired", "executed", "held"]},
    "created_at": {"type": "string", "format": "date-time"},
    "authority_trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chlom_ref": {"type": ["string", "null"]},
        "dail_ref": {"type": ["string", "null"]},
        "accountable_owner": {"type": ["string", "null"]},
        "provider_binding_ref": {"type": ["string", "null"]}
      }
    },
    "metadata": {"type": "object"}
  }
}
