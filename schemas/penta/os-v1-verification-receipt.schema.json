{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/os-v1-verification-receipt.schema.json",
  "title": "Penta OS V1.5 Deterministic Verification Receipt",
  "type": "object",
  "required": [
    "schema", "runtime_version", "registry_id", "registry_version",
    "registry_sha256", "systems_sha256", "dependency_graph_sha256",
    "operation_policy_sha256", "effective_date", "scope", "subject",
    "subject_sha256", "registry_integrity", "source_integrity",
    "production_certification", "release_gate_codes", "disposition",
    "provider_effect_verified", "production_certification_granted",
    "promotion_performed", "side_effect_performed", "receipt_id", "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "crownthrive.penta.verification-receipt.v1"},
    "runtime_version": {"const": "1.5.0"},
    "registry_id": {"const": "crownthrive.penta.os-v1"},
    "registry_version": {"const": "1.5.0"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "systems_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_graph_sha256": {"$ref": "#/$defs/sha256"},
    "operation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "effective_date": {"type": "string", "format": "date"},
    "scope": {"enum": ["registry", "member"]},
    "subject": {"type": "string", "minLength": 1},
    "subject_sha256": {"$ref": "#/$defs/sha256"},
    "registry_integrity": {"const": "PASS"},
    "source_integrity": {"enum": ["PASS", "NOT_CHECKED"]},
    "production_certification": {"const": "HOLD"},
    "release_gate_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "canonical_name": {"type": "string"},
    "maturity": {"type": "string"},
    "execution_eligible_by_registry": {"type": "boolean"},
    "strict_readiness_state": {"type": "string"},
    "disposition": {"enum": ["PASS_REPOSITORY_VERIFIED", "HOLD_RECORDED"]},
    "provider_effect_verified": {"const": false},
    "production_certification_granted": {"const": false},
    "promotion_performed": {"const": false},
    "side_effect_performed": {"const": false},
    "receipt_id": {"type": "string", "pattern": "^pvr-[a-f0-9]{24}$"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
