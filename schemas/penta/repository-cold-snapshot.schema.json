{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/repository-cold-snapshot.v1.json",
  "title": "Independently Verified Read-Only Repository Cold Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stable_id", "created_at", "head_sha", "signature_verified", "restore_mode", "signature", "snapshot_sha256"],
  "properties": {
    "schema": {"const": "ct.penta.repository-cold-snapshot.v1"},
    "stable_id": {"type": "string", "pattern": "^ct\\.repo\\.[a-z0-9][a-z0-9.-]*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "signature_verified": {"const": true},
    "restore_mode": {"const": "read_only"},
    "signature": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
