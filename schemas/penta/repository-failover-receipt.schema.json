{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/repository-failover-receipt.v1.json",
  "title": "Penta Repository Failover Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stable_id", "from_route", "to_route", "trigger", "authority_effect", "readback", "failback_state", "receipt_sha256"],
  "properties": {
    "schema": {"const": "ct.penta.repository-failover-receipt.v1"},
    "stable_id": {"type": "string", "pattern": "^ct\\.repo\\.[a-z0-9][a-z0-9.-]*$"},
    "from_route": {"enum": ["hot_primary", "cold_recovery", "silent_emergency"]},
    "to_route": {"enum": ["hot_primary", "cold_recovery", "silent_emergency"]},
    "trigger": {"type": "string", "minLength": 1},
    "authority_effect": {"enum": ["none", "reduce_only"]},
    "readback": {"type": "boolean"},
    "failback_state": {"enum": ["not_started", "verified", "hold"]},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
