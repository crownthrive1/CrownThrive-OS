{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/penta-families.schema.json",
  "title": "CrownThrive Penta Family of Families Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "canonical_name",
    "owner",
    "status",
    "production_scope",
    "parent_family",
    "parent_registry",
    "doctrine",
    "authority_invariant",
    "inventory_sources",
    "invariants",
    "portal_contract",
    "classification",
    "families",
    "cross_family_assignments"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "registry_id": {"const": "ct.registry.penta-families.v1"},
    "canonical_name": {"const": "Penta Family of Families"},
    "mark": {"type": "string"},
    "owner": {"type": "string", "minLength": 1},
    "status": {"const": "production"},
    "production_scope": {"const": "institutional_topology_and_portal_control_plane"},
    "parent_family": {"const": "Penta Family"},
    "parent_registry": {"const": "data/penta/family.registry.json"},
    "doctrine": {"const": "Discover -> Govern -> Execute -> Verify -> Preserve"},
    "authority_invariant": {"type": "string", "minLength": 80},
    "inventory_sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "path", "rule"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "invariants": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"type": "boolean"}
    },
    "portal_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_route",
        "route_pattern",
        "docs_index",
        "portal_state",
        "portal_state_is_not_frontend_deployment_claim",
        "required_sections"
      ],
      "properties": {
        "index_route": {"const": "/io/pentas/families"},
        "route_pattern": {"const": "/io/pentas/families/{slug}"},
        "docs_index": {"type": "string", "minLength": 1},
        "portal_state": {"const": "contracted"},
        "portal_state_is_not_frontend_deployment_claim": {"const": true},
        "required_sections": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization",
        "precedence",
        "ambiguous_match_disposition",
        "unclassified_disposition",
        "route_primitive_only_family"
      ],
      "properties": {
        "normalization": {"type": "string", "minLength": 1},
        "precedence": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "ambiguous_match_disposition": {"const": "hold_fail_closed"},
        "unclassified_disposition": {"const": "hold_fail_closed"},
        "route_primitive_only_family": {"const": "transport-primitives"}
      }
    },
    "families": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "canonical_name",
          "slug",
          "mission",
          "portal_route",
          "explicit_members",
          "machine_category_patterns",
          "handoffs_to"
        ],
        "properties": {
          "family_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "canonical_name": {"type": "string", "pattern": "^Penta .+ Family$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "mission": {"type": "string", "minLength": 40},
          "portal_route": {"type": "string", "pattern": "^/io/pentas/families/[a-z0-9-]+$"},
          "explicit_members": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^Penta"}
          },
          "machine_category_patterns": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "handoffs_to": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          }
        }
      }
    },
    "cross_family_assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    }
  }
}
