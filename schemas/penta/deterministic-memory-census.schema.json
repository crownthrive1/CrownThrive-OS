{
  "$id": "https://crownthrive.com/schemas/penta/deterministic-memory-census.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "properties": {
          "activation_state": {
            "enum": [
              "ACTIVE_FAIL_CLOSED",
              "COLD_RESERVED"
            ]
          },
          "brain_mesh_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_name": {
            "minLength": 1,
            "type": "string"
          },
          "classification_ceiling": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "degraded_without_model": {
            "type": "boolean"
          },
          "determinism_warrant": {
            "minLength": 32,
            "type": "string"
          },
          "execution_eligible_by_registry": {
            "type": "boolean"
          },
          "fail_closed": {
            "const": true
          },
          "family_key": {
            "minLength": 1,
            "type": "string"
          },
          "hard_quota_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "machine_key": {
            "pattern": "^penta\\.",
            "type": "string"
          },
          "maturity": {
            "minLength": 1,
            "type": "string"
          },
          "memory_namespace": {
            "pattern": "^ct\\.memory\\.penta\\.",
            "type": "string"
          },
          "memory_profile": {
            "enum": [
              "brain-v1",
              "cold-reserved-v1",
              "standard-v1",
              "security-v1",
              "continuity-v1",
              "observability-v1",
              "knowledge-v1",
              "intelligence-v1"
            ]
          },
          "model_dependency": {
            "enum": [
              "none",
              "optional_replaceable",
              "required_replaceable"
            ]
          },
          "model_version_required": {
            "type": "boolean"
          },
          "orchestration_determinism": {
            "const": "strict-v1"
          },
          "provider_version_required": {
            "const": true
          },
          "replaceable_model": {
            "const": true
          },
          "retention_days": {
            "minimum": 1,
            "type": "integer"
          },
          "risk_ceiling": {
            "enum": [
              "D0",
              "D1",
              "D2",
              "D3"
            ]
          },
          "seed": {
            "const": 0
          },
          "semantic_determinism": {
            "enum": [
              "strict-v1",
              "bounded-semantic-v1"
            ]
          },
          "survival_contract": {
            "type": "object"
          },
          "temperature": {
            "const": 0
          },
          "working_set_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "write_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "machine_key",
          "canonical_name",
          "family_key",
          "maturity",
          "risk_ceiling",
          "activation_state",
          "memory_namespace",
          "memory_profile",
          "hard_quota_bytes",
          "working_set_bytes",
          "retention_days",
          "write_enabled",
          "orchestration_determinism",
          "semantic_determinism",
          "fail_closed",
          "determinism_warrant",
          "survival_contract",
          "classification_ceiling",
          "provider_version_required",
          "model_version_required",
          "execution_eligible_by_registry",
          "model_dependency",
          "degraded_without_model",
          "replaceable_model",
          "seed",
          "temperature",
          "brain_mesh_role"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority_invariant": {
      "minLength": 32,
      "type": "string"
    },
    "brain_mesh": {
      "type": "object"
    },
    "canonicalization_profile": {
      "const": "ct.canonical-json.sorted-utf8.v1"
    },
    "counts": {
      "properties": {
        "canonical_pentas": {
          "minimum": 1,
          "type": "integer"
        },
        "cold_reserved": {
          "minimum": 0,
          "type": "integer"
        },
        "families": {
          "minimum": 1,
          "type": "integer"
        },
        "hot_writable": {
          "minimum": 0,
          "type": "integer"
        },
        "semantic_bounded": {
          "minimum": 0,
          "type": "integer"
        },
        "strict_only": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "canonical_pentas",
        "hot_writable",
        "cold_reserved",
        "semantic_bounded",
        "strict_only",
        "families"
      ],
      "type": "object"
    },
    "effective_date": {
      "format": "date",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "production_database": {
      "type": "object"
    },
    "schema": {
      "const": "ct.penta.deterministic-memory-census.v1"
    },
    "source_digests_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 4,
      "type": "object"
    },
    "source_registry_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_registry_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "const": "governed_production_contract"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "version",
    "effective_date",
    "status",
    "authority_invariant",
    "source_registry_id",
    "source_registry_version",
    "source_digests_sha256",
    "canonicalization_profile",
    "production_database",
    "brain_mesh",
    "counts",
    "assignments",
    "manifest_sha256"
  ],
  "title": "CrownThrive Penta Deterministic Memory Census",
  "type": "object"
}
