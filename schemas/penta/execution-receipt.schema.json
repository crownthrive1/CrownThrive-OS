{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ct.penta.execution-receipt.v1",
  "title": "Penta Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runtime_version", "receipt_id", "kind", "disposition", "created_at", "details", "receipt_sha256"],
  "properties": {
    "schema": {"const": "ct.penta.execution-receipt.v1"},
    "runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "receipt_id": {"type": "string", "pattern": "^pex-[a-f0-9]{32}$"},
    "kind": {"type": "string", "minLength": 1}, "disposition": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}, "details": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
