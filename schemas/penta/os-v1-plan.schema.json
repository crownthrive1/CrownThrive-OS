{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/os-v1-plan.schema.json",
  "title": "Penta OS V1.5 Deterministic Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "runtime_version", "registry_version", "registry_sha256",
    "dependency_graph_sha256", "operation_policy_sha256", "request",
    "request_sha256", "five_stage", "dependency_closure", "gate",
    "provider_effect_performed", "production_certification_granted",
    "side_effect_performed", "plan_sha256"
  ],
  "properties": {
    "schema": {"const": "crownthrive.penta.plan.v1"},
    "runtime_version": {"const": "1.5.0"},
    "registry_version": {"const": "1.5.0"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_graph_sha256": {"$ref": "#/$defs/sha256"},
    "operation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "request": {"type": "object"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "five_stage": {"const": ["discover", "govern", "execute", "verify", "preserve"]},
    "dependency_closure": {"type": ["object", "null"]},
    "gate": {"type": "object"},
    "provider_effect_performed": {"const": false},
    "production_certification_granted": {"const": false},
    "side_effect_performed": {"const": false},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
