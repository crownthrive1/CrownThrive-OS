{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/repository-node-attestation.v1.json",
  "title": "Penta Repository Node Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "stable_id", "parent_id", "mesh_contract_version", "default_branch", "visibility_class", "roles", "build_profile", "authority", "information_flow"],
  "properties": {
    "schema": {"const": "ct.penta.repository-node-attestation.v1"},
    "version": {"const": "1.0.0"},
    "stable_id": {"type": "string", "pattern": "^ct\\.repo\\.[a-z0-9][a-z0-9.-]*$"},
    "parent_id": {"const": "ct.repo.crownthrive-support"},
    "mesh_contract_version": {"const": "1.0.0"},
    "default_branch": {"const": "main"},
    "visibility_class": {"enum": ["public", "restricted"]},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "build_profile": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_main_write", "self_activation", "d3_human_reserved", "provider_writes_require_exact_certification"],
      "properties": {
        "direct_main_write": {"const": false},
        "self_activation": {"const": false},
        "d3_human_reserved": {"const": true},
        "provider_writes_require_exact_certification": {"const": true}
      }
    },
    "information_flow": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["afferent", "efferent", "lateral"]}}
  }
}
