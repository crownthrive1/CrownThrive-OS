{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/compliance-license.schema.json",
  "title": "CrownThrive PentaCompliance and PentaLicense Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "owner", "status", "runtime", "systems", "truth_rules"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "ct.penta.compliance-license.catalog.v1"},
    "owner": {"const": "CrownThrive LLC"},
    "status": {"const": "production_control_plane"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "test_path", "stress_path"],
      "properties": {
        "path": {"const": "runtime/penta_compliance_license.py"},
        "test_path": {"const": "tests/test_penta_compliance_license.py"},
        "stress_path": {"const": "scripts/stress_penta_compliance_license.py"}
      }
    },
    "systems": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["penta.compliance", "penta.license"]}
    },
    "truth_rules": {
      "type": "object",
      "additionalProperties": {"const": true},
      "required": [
        "no_invented_obligations", "no_universal_legal_attestation", "no_manufactured_rights",
        "exact_asset_version_required", "signed_grants_immutable", "amendments_append_only",
        "d3_human_reserved", "provider_readback_required"
      ]
    }
  }
}
