{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/interoperability-envelope.schema.json",
  "title": "CrownThrive Penta Interoperability Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "message_id",
    "source_member",
    "target_member",
    "operation",
    "requested_effect",
    "risk_class",
    "trace_id",
    "correlation_id",
    "idempotency_key",
    "evidence_refs",
    "authority_trace",
    "human_gate",
    "provider_effect",
    "provider_binding_ref",
    "readback_strategy",
    "metadata",
    "created_at",
    "envelope_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ct.penta.interoperability-envelope.v1"
    },
    "protocol_version": {
      "const": "1.0.0"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "source_member": {
      "type": "string",
      "pattern": "^penta\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "target_member": {
      "type": "string",
      "pattern": "^penta\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "requested_effect": {
      "enum": [
        "analyze",
        "prepare",
        "route",
        "execute",
        "verify",
        "preserve"
      ]
    },
    "risk_class": {
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_trace": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "chlom_ref",
        "dail_ref",
        "accountable_owner"
      ],
      "properties": {
        "chlom_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "dail_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountable_owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "required",
        "satisfied",
        "approver_refs",
        "separation_of_duties"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "satisfied": {
          "type": "boolean"
        },
        "approver_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "separation_of_duties": {
          "type": "boolean"
        }
      }
    },
    "provider_effect": {
      "type": "boolean"
    },
    "provider_binding_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "readback_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "dail_write_mode": {
          "enum": ["same_transaction", "transactional_outbox"]
        },
        "dail_event_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "dail_receipt_ref": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
