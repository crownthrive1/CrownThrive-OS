{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta/repository-sync-event.v1.json",
  "title": "Penta Repository Sync Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "stable_id", "head_sha", "direction", "idempotency_key", "authority_ref", "observed_at"],
  "properties": {
    "schema": {"const": "ct.penta.repository-sync-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "stable_id": {"type": "string", "pattern": "^ct\\.repo\\.[a-z0-9][a-z0-9.-]*$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "direction": {"enum": ["afferent", "efferent", "lateral"]},
    "idempotency_key": {"type": "string", "minLength": 16},
    "authority_ref": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
