{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ct.penta.execution-request.v1",
  "title": "Penta Member Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_member", "target_member", "operation", "evidence_refs"],
  "properties": {
    "source_member": {"type": "string", "pattern": "^penta\\.[a-z0-9_.-]+$"},
    "target_member": {"type": "string", "pattern": "^penta\\.[a-z0-9_.-]+$"},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "risk_class": {"type": "string", "enum": ["D0", "D1", "D2", "D3"], "default": "D1"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "payload": {"type": "object"}, "authority_trace": {"type": "object"}, "human_gate": {"type": "object"},
    "provider_binding_ref": {"type": ["string", "null"]}, "readback_strategy": {"type": ["string", "null"]}, "idempotency_key": {"type": ["string", "null"]}
  }
}
