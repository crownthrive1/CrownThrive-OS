{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/penta-context-record-v1.schema.json",
  "title": "PentaContext Record v1",
  "description": "Machine-readable contract for a PentaContext retrieval record. Context is evidence/memory and never authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "content",
    "truncated",
    "tags",
    "classification",
    "importance",
    "confidence",
    "observed_at",
    "fingerprint_sha256",
    "source",
    "provenance",
    "score"
  ],
  "properties": {
    "context_id": { "type": "string", "format": "uuid" },
    "title": { "type": ["string", "null"] },
    "content": { "type": "string", "minLength": 1 },
    "truncated": { "type": "boolean" },
    "summary": { "type": ["string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "importance": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "trust_tier"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["github", "drive", "database", "api", "web", "document", "message", "email", "calendar", "event", "system", "manual", "other"]
        },
        "ref": { "type": "string", "minLength": 1 },
        "uri": { "type": ["string", "null"] },
        "trust_tier": {
          "type": "string",
          "enum": ["authoritative", "trusted", "internal", "untrusted"]
        }
      }
    },
    "provenance": { "type": "object" },
    "score": { "type": "number" }
  }
}
