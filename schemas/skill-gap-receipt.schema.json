{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/skill-gap-receipt.v1.json",
  "title": "CrownThrive Convergence Skill Dry-Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "suite_id",
    "task_id",
    "skill_id",
    "subject_id",
    "source_ref",
    "mode",
    "authority",
    "state",
    "side_effects",
    "provider_invoked",
    "readback_required",
    "controls",
    "planned_outputs",
    "hold_reasons",
    "canonical_fingerprint"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "suite_id": {
      "const": "ct.skill-suite.convergence-gap-closure.v2"
    },
    "task_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "mode": {
      "const": "dry-run"
    },
    "authority": {
      "enum": [
        "D0",
        "D1",
        "D2"
      ]
    },
    "state": {
      "enum": [
        "PLANNED",
        "HOLD",
        "DENIED"
      ]
    },
    "side_effects": {
      "const": false
    },
    "provider_invoked": {
      "const": false
    },
    "readback_required": {
      "type": "boolean"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planned_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hold_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}