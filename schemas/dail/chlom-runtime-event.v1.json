{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dail.chlom.runtime-event.v1",
  "title": "CHLOM DAIL Runtime Event",
  "type": "object",
  "required": ["schema", "event_type", "run_id", "timestamp_utc", "state", "event_hash"],
  "properties": {
    "schema": {"const": "dail.chlom.runtime-event.v1"},
    "event_type": {"type": "string"},
    "run_id": {"type": "string"},
    "repository": {"type": "string"},
    "commit": {"type": "string"},
    "trigger": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "state": {"enum": ["READY", "HOLD", "RECONCILED", "FAILED"]},
    "agents": {"type": "array", "items": {"type": "string"}},
    "contracts": {"type": "array"},
    "authority": {"type": "object"},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
