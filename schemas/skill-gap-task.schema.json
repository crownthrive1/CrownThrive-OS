{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/skill-gap-task.v1.json",
  "title": "CrownThrive Convergence Skill Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "directive_id",
    "skill_id",
    "subject_id",
    "source_ref",
    "requested_authority",
    "mode",
    "observed_at",
    "inputs"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 8
    },
    "directive_id": {
      "type": "string",
      "minLength": 3
    },
    "skill_id": {
      "type": "string",
      "pattern": "^ct\\.skill\\.convergence\\."
    },
    "subject_id": {
      "type": "string",
      "minLength": 3
    },
    "source_ref": {
      "type": "string",
      "minLength": 7
    },
    "requested_authority": {
      "enum": [
        "D0",
        "D1",
        "D2"
      ]
    },
    "mode": {
      "const": "dry-run"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}