{
  "service_id": "ct.pentarelease.v1",
  "canonical_name": "PentaRelease",
  "version": "2.0.0",
  "state": "production",
  "maturity_contract": "technical+economic+cultural+governance-provenance",
  "economic_authority": "PentaCosts",
  "market_context_authority": "PentaMarket",
  "treasury_context_authority": "PentaTreasury/SmartTreasury",
  "cultural_authority": "CIE",
  "canonical_repository": "crownthrive1/CrownThrive-OS",
  "request_globs": [
    ".github/release-requests/crownthrive-os-*.json"
  ],
  "default_artifacts": [
    "release-package.zip",
    "release-package.tar.gz",
    "SHA256SUMS",
    "MANIFEST.json",
    "RELEASE_NOTES.md"
  ],
  "prohibited_patterns": [
    ".env",
    ".env.*",
    "*secret*",
    "*credential*",
    "*private_key*",
    "*.pem",
    "*.p12",
    "*.pfx",
    "vault/**"
  ],
  "require_provider_readback": true,
  "require_asset_readback_when_packaged": true,
  "require_release_bound_economic_evidence": true,
  "require_release_bound_cie_evidence": true,
  "require_canonical_repository_identity": true,
  "preserve_prior_versions": true,
  "fail_closed": true,
  "self_approval": false,
  "uncontrolled_recursive_release": false
}
