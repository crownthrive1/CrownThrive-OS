{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrownThrive PentaGreen Skills Handoff",
  "type": "object",
  "required": [
    "handoff_id",
    "tick_id",
    "skill_id",
    "package_hash",
    "rights",
    "price",
    "tax",
    "fulfillment",
    "entitlement",
    "destination",
    "provider_readback",
    "state"
  ],
  "properties": {
    "handoff_id": {
      "type": "string"
    },
    "tick_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "package_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rights": {
      "type": "object"
    },
    "price": {
      "type": "object"
    },
    "tax": {
      "type": "object"
    },
    "fulfillment": {
      "type": "object"
    },
    "entitlement": {
      "type": "object"
    },
    "destination": {
      "type": "object"
    },
    "provider_readback": {
      "type": "object"
    },
    "state": {
      "enum": [
        "ECAC",
        "HOLD",
        "DENY"
      ]
    },
    "hold_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
