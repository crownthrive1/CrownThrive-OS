# CrownThrive PentaFabric / RTC self-hosted runner contract
# Copy values into the machine environment. Never put GH_TOKEN in this file.

GITHUB_REPOSITORY=crownthrive1/CrownThrive-OS
GITHUB_REPOSITORY_ID=1336348391
PENTA_RUNNER_NAME=pentafabric-rtc-01
PENTA_RUNNER_ROOT=/opt/crownthrive/actions-runner
PENTA_RUNNER_USER=github-runner
PENTA_RUNNER_ARCH=x64
PENTA_RUNNER_LABELS=crownthrive,pentafabric,rtc,trusted,provider,pentamail

# Runtime trust policy
# - self-hosted + trusted labels: main, schedule, workflow_dispatch only
# - public pull_request/fork validation: GitHub-hosted runner only
# - provider secrets: only trusted jobs, never pull_request jobs
# - runner registration credentials: environment/in-memory only
# - runner proof: Penta Runner Fabric Certification + artifact attestation
