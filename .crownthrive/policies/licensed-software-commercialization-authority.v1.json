{
  "policy": "ct.policy.licensed-software-commercialization-authority.v1",
  "version": "1.0.0",
  "status": "active",
  "effective_at": "2026-09-02T22:42:00Z",
  "approved_by": "Kavonte Jones Sr., Founding Member, CrownThrive, LLC",
  "source_ref": "founder-directive:2026-09-02:licensed-software-commercialization",
  "scope": "CrownThrive ecosystem-wide",
  "rule": "CrownThrive may monetize CrownThrive-branded products and services powered by software it has purchased, licensed, subscribed to, contracted for, built, or otherwise recorded as authorized for use.",
  "default_resolution": {
    "active_authority_found": "continue_commercialization",
    "generic_third_party_or_license_uncertainty": "not_a_hold",
    "public_identity": "CrownThrive_product_brand",
    "implementation_provider_identity": "restricted_unless_disclosure_required"
  },
  "authorized_activities": [
    "productization",
    "saas",
    "hosting",
    "customer_intake",
    "implementation",
    "configuration",
    "automation",
    "production",
    "delivery",
    "support",
    "advertising",
    "analytics",
    "affiliate_sales",
    "licensing_packages",
    "managed_services",
    "commercial_deals"
  ],
  "separate_gates": [
    "customer_content_rights",
    "payment_and_entitlement",
    "specific_current_provider_access_or_restriction",
    "security_and_privacy",
    "quality_and_accessibility",
    "deployment_and_delivery",
    "legal_order_or_statutory_prohibition",
    "exact_release_evidence"
  ],
  "valid_new_hold_evidence": [
    "written_revocation_or_termination",
    "expiration_or_provider_suspension",
    "proven_scope_contradiction_not_cleared_or_superseded",
    "counterfeit_corrupt_or_untraceable_source",
    "credential_or_live_readback_failure",
    "missing_customer_content_rights",
    "binding_legal_prohibition",
    "security_incident",
    "exact_operational_failure"
  ],
  "systems": {
    "authority_ledger": "ThriveBase public.ct_software_commercialization_authority_v1",
    "resolver": "ThriveBase public.ct_resolve_software_commercialization_authority_v1",
    "commercial_router": "PentaGreen",
    "certifier": "PentaAssure",
    "source_resolution": "Master Registry + ThriveBase + Drive + all accessible private GitHub repositories + runtime readback",
    "knowledge_projection": "PentaDocs",
    "preservation": "additive_versioned"
  },
  "go_flipbooks": {
    "authority_id": "ct.software-commercialization-authority.go-flipbooks.v1",
    "state": "monetization_authorized",
    "public_brand": "Go Flipbooks",
    "cleared_lanes": ["standard","pro","managed_services"],
    "superseded_hold": "HOLD_STANDARD_RUNTIME_MULTI_CUSTOMER_COMMERCIAL_RIGHTS_NOT_BOUND"
  }
}
