{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/command-v3.html" },
    { "source": "/command", "destination": "/command-v3.html" },
    { "source": "/wallet", "destination": "/command-v3.html" },
    { "source": "/dail", "destination": "/command-v3.html" },
    { "source": "/atlas", "destination": "/command-v3.html" },
    { "source": "/ops", "destination": "/command-v3.html" },
    { "source": "/infrastructure", "destination": "/command-v3.html" },
    { "source": "/commerce", "destination": "/command-v3.html" },
    { "source": "/evidence", "destination": "/command-v3.html" },
    { "source": "/integrations", "destination": "/command-v3.html" },
    { "source": "/go-flipbooks", "destination": "/go-flipbooks.html" },
    { "source": "/go-flipbooks/standard", "destination": "/go-flipbooks.html" },
    { "source": "/go-flipbooks/static", "destination": "/go-flipbooks.html" },
    { "source": "/go-flipbooks/self-hosted", "destination": "/go-flipbooks.html" },
    { "source": "/go-flipbooks/pro", "destination": "/go-flipbooks.html" },
    { "source": "/go-flipbooks/api", "destination": "/go-flipbooks.html" },
    { "source": "/go-flipbooks/managed", "destination": "/go-flipbooks.html" },
    { "source": "/go-flipbooks/managed-services", "destination": "/go-flipbooks.html" },
    { "source": "/marketplace/go-flipbooks", "destination": "/go-flipbooks.html" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/fabric", "destination": "/api/fabric" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/health", "destination": "/api/mcp" },
    { "source": "/penta", "destination": "/api/penta" },
    { "source": "/pentafabric/health", "destination": "/api/pentafabric-health" },
    { "source": "/pentafabric/ingest", "destination": "/api/penta" },
    { "source": "/chlom", "destination": "/api/chlom" },
    { "source": "/chlom/health", "destination": "/api/chlom" },
    { "source": "/api/chlom/health", "destination": "/api/chlom" }
  ]
}
