{
  "schema": "ct.penta.chlom.bridge-contract.v1",
  "version": "1.0.0",
  "state": "IMPLEMENTED_CONFIGURATION_HOLD",
  "runtime": {
    "provider": "vercel",
    "project_id": "prj_x6AcQaYdt6lkuyoWkdzv9TSL9lAN",
    "service": "crownthrive-os-control-plane",
    "upstream": "https://chlom-protocol.vercel.app"
  },
  "routes": {
    "public_health": ["/api/chlom", "/chlom/health"],
    "protected_bridge": "/api/chlom",
    "mcp": "/api/mcp"
  },
  "actions": {
    "rpc_read": {
      "upstream_path": "/api/v1/rpc",
      "arbitrary_methods": false,
      "chain_broadcast": false
    },
    "analytics": {
      "upstream_path": "/api/v1/analytics",
      "arbitrary_sql": false,
      "maximum_lookback_days": 31,
      "maximum_rows": 250
    },
    "attest": {
      "upstream_path": "/api/v1/attest",
      "broadcast": false
    }
  },
  "authentication": {
    "inbound": "CROWNTHRIVE_CONTROL_TOKEN",
    "upstream": "CHLOM_API_TOKEN",
    "credentials_separated": true,
    "private_key_custody": false
  },
  "mcp": {
    "primary_protocol": "2026-07-28",
    "legacy_fallbacks": ["2025-11-25", "2025-06-18", "2025-03-26"],
    "stateless": true,
    "protected_tools": [
      "run_chlom_chain_read",
      "run_chlom_blockchain_analytics",
      "prepare_chlom_evidence_anchor"
    ],
    "broadcast_tool_exposed": false
  },
  "evidence": {
    "upstream_digest_preserved": true,
    "bridge_receipt_schema": "ct.penta.chlom.bridge-receipt.v1",
    "dail_projection_preserved": true,
    "dail_persistence_claimed": false,
    "chain_publication_claimed": false
  }
}
