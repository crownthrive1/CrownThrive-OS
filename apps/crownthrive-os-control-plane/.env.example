# Canonical upstream. The runtime rejects any other base URL.
CHLOM_BASE_URL=https://chlom-protocol.vercel.app

# Server-to-server credential used only by CrownThrive OS when calling CHLOM.
# Configure the same secret value as CHLOM_API_TOKEN in the chlom-protocol Vercel project.
CHLOM_API_TOKEN=

# Independent inbound credential for protected CrownThrive OS API and MCP calls.
# Do not reuse a provider API key, wallet key, or service-account key.
CROWNTHRIVE_CONTROL_TOKEN=

# Optional comma-separated browser origins. Server-to-server clients normally send no Origin header.
CROWNTHRIVE_ALLOWED_ORIGINS=https://crown-thrive-os.vercel.app

# Existing PentaFabric bindings
PENTAFABRIC_SIGNING_SECRET=
PENTAFABRIC_INGEST_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
