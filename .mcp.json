{
  "mcpServers": {
    "crownthrive-os": {
      "url": "https://crown-thrive-os.vercel.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${CROWNTHRIVE_CONTROL_TOKEN}"
      }
    },
    "chlom-chain-evidence": {
      "url": "https://chlom-protocol.vercel.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${CHLOM_API_TOKEN}"
      }
    },
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "paddle-docs": {
      "type": "http",
      "url": "https://paddlehq.mcp.kapa.ai"
    },
    "paddle-live": {
      "type": "http",
      "url": "https://mcp.paddle.com/mcp"
    },
    "paddle-sandbox": {
      "type": "http",
      "url": "https://sandbox-mcp.paddle.com/mcp",
      "bearer_token_env_var": "PADDLE_SANDBOX_API_KEY"
    }
  }
}
