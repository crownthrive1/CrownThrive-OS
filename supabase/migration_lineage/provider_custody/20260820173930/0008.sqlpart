lass,'check_url',r.check_url),
      r.auto_repair_class in ('D0','D1'),
      r.auto_repair_class in ('D2','D3'),
      r.result_id,
      jsonb_build_object('external_mutation_allowed',false,'reason','Sites/provider write adapter not certified; queue is planning evidence only')
    );
    v_created := v_created + 1;
  end loop;
  return jsonb_build_object('surface_id',p_surface_id,'planned_updates_created',v_created,'external_mutation_allowed',false,'planned_at',now());
end;
$$;

