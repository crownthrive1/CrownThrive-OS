_results_service_role_all on integration_control.site_interaction_check_results for all to service_role using (true) with check (true);
create policy site_update_queue_service_role_all on integration_control.site_update_queue for all to service_role using (true) with check (true);

insert into integration_control.services(service_id,display_name,base_url,docs_url,auth_scheme,credential_ref,credential_state,integration_state,write_gate,monthly_request_limit,timezone,metadata)
values(
  'website_surface_control',
  'CrownThrive Website Surface Control',
  'https://tzajnzshmtzjenqulehq.supabase.co/rest/v1/rpc',
  'https://crown-thrive.mintlify.io/technology/web-surface-contact-interaction-automation',
  'Supabase service-role through governed CrownThrive API/MCP control plane',
  'supabase-runtime-auth',
  'verified',
  'configured',
  false,
  null,
  'UTC',
  jsonb_build_object(
    'stable_id','ct.service.website-surface-control',
    'provider','CrownThrive-owned/Supabase',
    'mode','public_surface_read_probe_and_update_planning',
    'external_site_writes_enabled',false,
    'sites_write_adapter_state','not_certified',
    'design_authority','ct.connector.figma',
    'creative_production','ct.connector.canva',
    'contact_submission_tests','synthetic_or_sandbox_only_until_separately_authorized'
  )
)
on conflict(service_id) do update set
  display_name=excluded.display_name,
  base_url=excluded.base_url,
  docs_url=excluded.docs_url,
  auth_scheme=excluded.auth_scheme,
  credential_ref=excluded.credential_ref,
  credential_state=excluded.credential_state,
  integration_state=excluded.integration_state,
  write_gate=false,
  metadata=integration_control.services.metadata || excluded.metadata,
  updated_at=now();

create or replace function integration_control.website_surface_list()
returns jsonb
language sql
security definer
set search_path = pg_catalog, integration_control
as $$
  select jsonb_build_object(
    'surfaces', coalesce(jsonb_agg(to_jsonb(s) order by s.surface_id), '[]'::jsonb),
    'retrieved_at