create table integration_control.website_surfaces (
  surface_id text primary key,
  platform_id text not null,
  display_name text not null,
  provider_system text not null default 'unverified',
  provider_project_ref text,
  provider_version_ref text,
  environment text not null default 'unknown' check (environment in ('production','staging','development','preview','unknown')),
  canonical_url text not null,
  contact_url text,
  api_service_id text,
  repository_ref text,
  design_authority_ref text not null default 'ct.connector.figma',
  creative_production_ref text not null default 'ct.connector.canva',
  source_evidence_ref text,
  provider_connection_state text not null default 'unverified' check (provider_connection_state in ('verified','documented','unverified','blocked','not_connected','retired')),
  health_state text not null default 'unknown' check (health_state in ('unknown','healthy','degraded','blocked')),
  update_mode text not null default 'observe_only' check (update_mode in ('observe_only','plan_only','bounded_auto','human_approval')),
  auto_update_enabled boolean not null default false,
  last_checked_at timestamptz,
  metadata jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table integration_control.creative_asset_routes (
  route_id text primary key,
  surface_id text not null references integration_control.website_surfaces(surface_id) on delete cascade,
  source_system text not null,
  source_asset_ref text not null,
  source_version_ref text,
  asset_class text not null,
  destination_slot text not null,
  delivery_mode text not null default 'unknown' check (delivery_mode in ('api','cdn','embedded','manual','unknown')),
  rights_state text not null default 'unverified' check (rights_state in ('verified','unverified','blocked','not_applicable')),
  accessibility_state text not null default 'unverified' check (accessibility_state in ('verified','unverified','blocked','not_applicable')),
  public