
  response_bytes integer,
  has_form boolean,
  has_mailto boolean,
  has_tel boolean,
  text_match boolean,
  success boolean not null,
  failure_class text,
  evidence jsonb not null default '{}'::jsonb
);

create table integration_control.site_update_queue (
  update_id uuid primary key default gen_random_uuid(),
  surface_id text not null references integration_control.website_surfaces(surface_id) on delete cascade,
  trigger_key text not null,
  operation_key text not null,
  risk_class text not null check (risk_class in ('D0','D1','D2','D3')),
  requested_change jsonb not null default '{}'::jsonb,
  state text not null default 'planned' check (state in ('planned','approved','executing','completed','blocked','failed','cancelled')),
  autonomous_eligible boolean not null default false,
  requires_human_approval boolean not null default false,
  source_result_id bigint references integration_control.site_interaction_check_results(result_id) on delete set null,
  rollback_ref text,
  metadata jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table integration_control.website_surfaces enable row level security;
alter table integration_control.creative_asset_routes enable row level security;
alter table integration_control.site_interaction_checks enable row level security;
alter table integration_control.site_interaction_check_results enable row level security;
alter table integration_control.site_update_queue enable row level security;

create policy website_surfaces_service_role_all on integration_control.website_surfaces for all to service_role using (true) with check (true);
create policy creative_asset_routes_service_role_all on integration_control.creative_asset_routes for all to service_role using (true) with check (true);
create policy site_interaction_checks_service_role_all on integration_control.site_interaction_checks for all to service_role using (true) with check (true);
create policy site_interaction_check