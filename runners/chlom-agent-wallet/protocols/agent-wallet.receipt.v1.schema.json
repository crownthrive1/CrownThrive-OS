{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ct.protocol.chlom-agent-wallet.receipt.v1",
  "title":"CHLOM Agent Wallet Receipt v1",
  "type":"object",
  "required":["schema","receipt_id","intent_id","idempotency_key","status","decision","execution","signer_material_exported","created_at","receipt_sha256"],
  "properties": {
    "schema":{"const":"ct.protocol.chlom-agent-wallet.receipt.v1"},
    "receipt_id":{"type":"string"},
    "intent_id":{"type":"string"},
    "idempotency_key":{"type":"string"},
    "status":{"enum":["HOLD","OBSERVED","SIMULATED","CONFIRMED","BROADCAST_UNCONFIRMED"]},
    "decision":{"type":"object"},
    "authorization_id":{"type":["string","null"]},
    "execution":{"type":"object"},
    "signer_material_exported":{"const":false},
    "created_at":{"type":"string","format":"date-time"},
    "idempotent_replay":{"type":"boolean"},
    "receipt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "event_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
