{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ct.protocol.chlom-agent-wallet.authorization.v1",
  "title":"CHLOM Agent Wallet Exact ECAC Authorization v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","authorization_id","decision","intent_sha256","policy_sha256","scope","issued_at","expires_at","evidence_refs"],
  "properties": {
    "schema":{"const":"ct.protocol.chlom-agent-wallet.authorization.v1"},
    "authorization_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "decision":{"enum":["ECAC","HOLD","DENY"]},
    "intent_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "policy_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "scope":{"type":"object","additionalProperties":false,"required":["money_movement","chain_broadcast","settlement_write","signer_key_material_release"],"properties":{"money_movement":{"type":"boolean"},"chain_broadcast":{"type":"boolean"},"settlement_write":{"type":"boolean"},"signer_key_material_release":{"const":false}}},
    "issued_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "evidence_refs":{"type":"array","items":{"type":"string","minLength":1,"maxLength":500},"maxItems":50}
  }
}
