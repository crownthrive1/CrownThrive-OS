{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ct.event.chlom-agent-wallet.v1",
  "title":"CHLOM Agent Wallet DAIL/Penta Outbox Event v1",
  "type":"object",
  "required":["schema","event_id","event_type","source","subject","occurred_at","receipt_sha256","previous_event_sha256","delivery","event_sha256"],
  "properties": {
    "schema":{"const":"ct.event.chlom-agent-wallet.v1"},
    "event_id":{"type":"string"},
    "event_type":{"type":"string"},
    "source":{"const":"chlom-agent-wallet"},
    "subject":{"type":"string"},
    "occurred_at":{"type":"string","format":"date-time"},
    "receipt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "previous_event_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "delivery":{"type":"object","required":["mode","dail_eligible","remote_delivery_claimed","penta_routes"],"properties":{"mode":{"const":"append_only_outbox"},"dail_eligible":{"const":true},"remote_delivery_claimed":{"const":false},"penta_routes":{"type":"array","items":{"type":"string"}}}},
    "event_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
