[Unit]
Description=CrownThrive CHLOM Agent Wallet - Trust Wallet Agent Kit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=%h/.local/share/crownthrive/chlom-agent-wallet/config/runtime.env
ExecStart=/usr/bin/env twak serve --rest --host 127.0.0.1 --port 8787 --auto-lock 15 --watch --watch-interval 60s
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.twak %h/.local/share/crownthrive/chlom-agent-wallet
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=default.target
