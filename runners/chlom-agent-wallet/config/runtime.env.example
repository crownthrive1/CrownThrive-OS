# Copy only to the runner's protected local config directory; never commit secrets.
# TWAK_WALLET_PASSWORD is intentionally omitted from this example.
CT_AGENT_WALLET_PRIMARY_CHAIN=base
CT_AGENT_WALLET_CHAIN_ID=8453
CT_AGENT_WALLET_PRIMARY_ASSET=USDC
CT_AGENT_WALLET_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
CT_AGENT_WALLET_MAX_UNATTENDED_VALUE_MINOR=0
CT_AGENT_WALLET_PORT=8787
# Optional future adapter. Current policy prevents chain broadcast regardless.
# CT_AGENT_WALLET_ADAPTER=/absolute/path/to/reviewed-adapter
