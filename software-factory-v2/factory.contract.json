{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "ct.factory.v2",
  "canonical_product": "PentaFactory",
  "runtime_name": "Software Factory v2",
  "classification": "pentafactory_executable_compatibility_runtime",
  "control_plane": "ThriveBase",
  "compatibility_identifiers": [
    "ct.factory.v2",
    "ct_factory_*",
    "ct-software-factory-*",
    "ct.pentaframework-factory.v1"
  ],
  "autonomy": {
    "enabled": true,
    "fail_closed": true,
    "human_chat_dependency": false,
    "production_requires_verified_adapters": true
  },
  "throughput": {
    "unit": "production_package",
    "max_per_build_run": 1,
    "implementation_required_for_success": true
  },
  "lanes": [
    {"id":"discover","ordinal":10},
    {"id":"architect","ordinal":20},
    {"id":"generate","ordinal":30},
    {"id":"security","ordinal":40},
    {"id":"test","ordinal":50},
    {"id":"package","ordinal":60},
    {"id":"deploy","ordinal":70},
    {"id":"assurance","ordinal":80}
  ],
  "package_manifest_required": [
    "source_changes",
    "database_migrations",
    "api_and_mcp_contracts",
    "edge_functions",
    "workflows",
    "tests",
    "documentation_delta",
    "rights_and_authority_evidence",
    "deployment_evidence",
    "rollback_plan",
    "sha256"
  ],
  "production_gates": [
    "all_required_lanes_passed",
    "tests_passed",
    "security_passed",
    "rights_authority_satisfied",
    "deployment_target_verified",
    "provider_native_or_supported_feed_write_verified",
    "rollback_material_present",
    "single_production_package_invariant",
    "post_deploy_health_passed"
  ],
  "governance": {
    "D0": "mechanical",
    "D1": "bounded operational",
    "D2": "material commercial/security/rights",
    "D3": "institutional/high consequence"
  },
  "naming_rule": "Human-facing identity is PentaFactory. Compatibility identifiers are preserved until a governed migration proves a safe replacement."
}
