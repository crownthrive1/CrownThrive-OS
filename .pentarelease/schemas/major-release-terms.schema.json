{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/pentarelease/major-release-terms.v1.json",
  "title": "CrownThrive PentaRelease public major-release terms",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "terms_id",
    "terms_version",
    "repository",
    "release",
    "content_binding",
    "compatibility_effect",
    "institutional_namespaces",
    "abandoned_candidate",
    "authority_boundaries",
    "release_scope",
    "artifact_policy",
    "privacy",
    "validity"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "terms_id": { "const": "ct.pentarelease.major.v4.0.0.0.terms" },
    "terms_version": { "const": "1.0.0" },
    "repository": { "const": "crownthrive1/CrownThrive-Support" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_class", "version", "tag", "version_scheme"],
      "properties": {
        "release_class": { "const": "major" },
        "version": { "const": "4.0.0.0" },
        "tag": { "const": "v4.0.0.0" },
        "version_scheme": { "const": "crownthrive_extended" }
      }
    },
    "content_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_sha_in_terms", "content_change_after_approval_prohibited"],
      "properties": {
        "mode": { "const": "provider_pull_request_head_plus_public_terms_sha256" },
        "source_sha_in_terms": { "const": false },
        "content_change_after_approval_prohibited": { "const": true }
      }
    },
    "compatibility_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "component_versions_remain_independent", "component_states_promoted"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "component_versions_remain_independent": { "const": true },
        "component_states_promoted": { "const": false }
      }
    },
    "institutional_namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institutional_phase_before",
        "institutional_phase_after",
        "phase_transition_authorized",
        "os_release_family_before",
        "os_release_family_after",
        "os_4x_effective_only_after_v4_provider_readback"
      ],
      "properties": {
        "institutional_phase_before": { "const": 3 },
        "institutional_phase_after": { "const": 3 },
        "phase_transition_authorized": { "const": false },
        "os_release_family_before": { "const": "3.x" },
        "os_release_family_after": { "const": "4.x" },
        "os_4x_effective_only_after_v4_provider_readback": { "const": true }
      }
    },
    "abandoned_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tag",
        "commit_sha",
        "branch_ref",
        "state",
        "provider_tag_observed",
        "provider_release_observed",
        "branch_and_commit_preserved",
        "tag_and_version_reuse_prohibited"
      ],
      "properties": {
        "version": { "const": "3.14.0.0" },
        "tag": { "const": "v3.14.0.0" },
        "commit_sha": { "const": "ede88f08c3c93eac12adec306811573bfff27a19" },
        "branch_ref": { "const": "refs/remotes/origin/pentarelease/auto-3.14.0.0-33024509722" },
        "state": { "const": "ABANDONED_INVALID_LINEAGE_CANDIDATE" },
        "provider_tag_observed": { "const": false },
        "provider_release_observed": { "const": false },
        "branch_and_commit_preserved": { "const": true },
        "tag_and_version_reuse_prohibited": { "const": true }
      }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_founder_only",
        "surrogate_used",
        "silence_is_authority",
        "agent_authority",
        "quorum_substitution",
        "D3_auto",
        "provider_release_creates_authority",
        "provider_write_scope_only"
      ],
      "properties": {
        "human_founder_only": { "const": true },
        "surrogate_used": { "const": false },
        "silence_is_authority": { "const": false },
        "agent_authority": { "const": false },
        "quorum_substitution": { "const": false },
        "D3_auto": { "const": false },
        "provider_release_creates_authority": { "const": false },
        "provider_write_scope_only": { "const": true }
      }
    },
    "release_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_publication_only", "authority_delegation", "component_promotion"],
      "properties": {
        "provider_publication_only": { "const": true },
        "authority_delegation": { "const": false },
        "component_promotion": { "const": false }
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "required_assets"],
      "properties": {
        "mode": { "const": "governed_package_and_checksums" },
        "required_assets": {
          "const": [
            "CrownThrive-OS-v4.0.0.0-package.zip",
            "CrownThrive-OS-v4.0.0.0-package.tar.gz",
            "SHA256SUMS",
            "MANIFEST.json",
            "RELEASE_NOTES.md"
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_terms_only", "chat_transcript_included", "private_conversation_digest_included"],
      "properties": {
        "public_terms_only": { "const": true },
        "chat_transcript_included": { "const": false },
        "private_conversation_digest_included": { "const": false }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_at", "not_before", "expires_at", "single_use_nonce"],
      "properties": {
        "requested_at": { "type": ["string", "null"], "format": "date-time" },
        "not_before": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "single_use_nonce": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
