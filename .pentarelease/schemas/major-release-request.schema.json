{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/pentarelease/major-release-request.v1.json",
  "title": "CrownThrive PentaRelease D3 major-release request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "release_id",
    "repository",
    "release_class",
    "authority_class",
    "version",
    "tag",
    "version_scheme",
    "title",
    "package",
    "target_binding",
    "draft",
    "prerelease",
    "published_baseline",
    "authority_terms",
    "authority",
    "candidate_binding",
    "abandoned_candidate",
    "institutional_namespaces",
    "prepublication_gates",
    "artifact_policy",
    "publisher_controls",
    "carry_forward_holds",
    "rollback_correction",
    "idempotency_key",
    "requested_at"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "request_id": { "const": "ct.os.v4.0.0.0.major" },
    "release_id": { "const": "ct.os.v4.0.0.0" },
    "repository": { "const": "crownthrive1/CrownThrive-Support" },
    "release_class": { "const": "major" },
    "authority_class": { "const": "D3_HUMAN_RESERVED" },
    "version": { "const": "4.0.0.0" },
    "tag": { "const": "v4.0.0.0" },
    "version_scheme": { "const": "crownthrive_extended" },
    "title": { "const": "CrownThrive OS 4.0.0.0 — Human-Authorized Major Release" },
    "package": { "const": "releases/4.0.0.0" },
    "target_binding": { "const": "github_event_merge_sha" },
    "draft": { "const": false },
    "prerelease": { "const": false },
    "published_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "tag_sha", "source_baseline_sha"],
      "properties": {
        "tag": { "const": "v3.13.0.1" },
        "tag_sha": { "const": "3b5ab399cc4a3014554f95736fcea7032972989a" },
        "source_baseline_sha": { "const": "eb2662b57e47384a85bdaa97df5a7ad9c13c78f2" }
      }
    },
    "authority_terms": { "$ref": "#/$defs/fileBinding" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_marker",
        "authorized_actor_login",
        "authorized_actor_association",
        "authority_subject_role",
        "human_founder_only",
        "surrogate_used",
        "silence_is_authority",
        "agent_authority",
        "quorum_substitution",
        "D3_auto",
        "provider_evidence_resolution"
      ],
      "properties": {
        "approval_marker": { "const": "CROWNTHRIVE_D3_MAJOR_RELEASE_APPROVED" },
        "authorized_actor_login": { "const": "crownthrive1" },
        "authorized_actor_association": { "const": "OWNER" },
        "authority_subject_role": { "const": "ct.role.founder" },
        "human_founder_only": { "const": true },
        "surrogate_used": { "const": false },
        "silence_is_authority": { "const": false },
        "agent_authority": { "const": false },
        "quorum_substitution": { "const": false },
        "D3_auto": { "const": false },
        "provider_evidence_resolution": { "const": "event_merge_pull_request_review_or_comment" }
      }
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "frozen_head_sha", "pull_request_number", "provider_approval_id"],
      "properties": {
        "mode": { "const": "provider_event_pull_request_head" },
        "frozen_head_sha": { "const": null },
        "pull_request_number": { "const": null },
        "provider_approval_id": { "const": null }
      }
    },
    "abandoned_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "commit_sha", "branch_ref", "state", "preserve_evidence", "reuse_prohibited"],
      "properties": {
        "version": { "const": "3.14.0.0" },
        "tag": { "const": "v3.14.0.0" },
        "commit_sha": { "const": "ede88f08c3c93eac12adec306811573bfff27a19" },
        "branch_ref": { "const": "refs/remotes/origin/pentarelease/auto-3.14.0.0-33024509722" },
        "state": { "const": "ABANDONED_INVALID_LINEAGE_CANDIDATE" },
        "preserve_evidence": { "const": true },
        "reuse_prohibited": { "const": true }
      }
    },
    "institutional_namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institutional_phase", "phase_transition_authorized", "os_release_family_after_readback", "os_4x_effective_only_after_v4_provider_readback"],
      "properties": {
        "institutional_phase": { "const": 3 },
        "phase_transition_authorized": { "const": false },
        "os_release_family_after_readback": { "const": "4.x" },
        "os_4x_effective_only_after_v4_provider_readback": { "const": true }
      }
    },
    "prepublication_gates": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "predicate", "state", "evidence_refs"],
        "properties": {
          "gate_id": { "pattern": "^CT-MAJOR-(00[1-9]|01[0-3])$" },
          "predicate": { "type": "string", "minLength": 1 },
          "state": { "enum": ["PASS", "HOLD", "UNKNOWN"] },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "required_assets"],
      "properties": {
        "mode": { "const": "governed_package_and_checksums" },
        "required_assets": {
          "const": [
            "CrownThrive-OS-v4.0.0.0-package.zip",
            "CrownThrive-OS-v4.0.0.0-package.tar.gz",
            "SHA256SUMS",
            "MANIFEST.json",
            "RELEASE_NOTES.md"
          ]
        }
      }
    },
    "publisher_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "blind_edit_prohibited",
        "blind_clobber_prohibited",
        "provider_readback_required",
        "downloaded_checksum_verification_required",
        "partial_retry_identity_match_required"
      ],
      "properties": {
        "append_only": { "const": true },
        "blind_edit_prohibited": { "const": true },
        "blind_clobber_prohibited": { "const": true },
        "provider_readback_required": { "const": true },
        "downloaded_checksum_verification_required": { "const": true },
        "partial_retry_identity_match_required": { "const": true }
      }
    },
    "carry_forward_holds": {
      "allOf": [
        { "$ref": "#/$defs/fileBinding" },
        {
          "type": "object",
          "required": ["states_promoted"],
          "properties": { "states_promoted": { "const": false } }
        }
      ]
    },
    "rollback_correction": { "$ref": "#/$defs/fileBinding" },
    "idempotency_key": { "type": ["string", "null"], "minLength": 1 },
    "requested_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
