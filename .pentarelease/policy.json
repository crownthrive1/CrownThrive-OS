{
  "policy_id": "ct.pentarelease.autonomous.v2",
  "version": "2.2.0",
  "enabled": true,
  "mode": "production",
  "decision_interval_minutes": 15,
  "default_version_scheme": "crownthrive_extended",
  "release_prefix": "v",
  "minimum_release_relevant_changes": 1,
  "docs_only_default": "hold",
  "generated_commit_prefixes": [
    "pentarelease(auto):",
    "release:",
    "docs(pentarelease):"
  ],
  "ignored_paths": [
    "releases/",
    ".github/release-requests/",
    ".pentarelease/state/",
    "docs/archive/"
  ],
  "governed_docs_paths": [
    "docs/versioning/",
    "docs/phase3/",
    "PENTARELEASE.md",
    "AGENTS.md",
    "SECURITY.md"
  ],
  "runtime_paths": [
    "supabase/functions/",
    "runtime/",
    "services/",
    "src/",
    "api/",
    "mcp/",
    "penta/runtime/"
  ],
  "integration_paths": [
    ".github/workflows/",
    "integrations/",
    "adapters/",
    "providers/"
  ],
  "security_paths": [
    "SECURITY.md",
    "security/",
    "policies/security/"
  ],
  "release_rules": {
    "breaking": {
      "signals": ["BREAKING CHANGE", "!:", "breaking:"],
      "bump": "major",
      "requires_human_authority": true
    },
    "feature": {
      "signals": ["feat:", "feat(", "add subsystem", "new runtime", "new adapter", "new provider"],
      "bump": "minor",
      "requires_human_authority": false
    },
    "fix": {
      "signals": ["fix:", "fix(", "security:", "hardening", "repair"],
      "bump": "patch",
      "requires_human_authority": false
    },
    "evidence": {
      "signals": ["docs:", "docs(", "ci:", "chore:", "governance"],
      "bump": "evidence",
      "requires_human_authority": false
    }
  },
  "human_release_authority": {
    "enabled": true,
    "directory": ".pentarelease/authority",
    "accepted_authority_types": ["interactive_explicit_directive"],
    "accepted_issuer_classes": ["founder_human"],
    "require_exact_tag": true,
    "require_exact_target": true,
    "required_target": "main",
    "require_one_shot": true,
    "require_no_scope_widening": true,
    "required_scope_keys": ["release", "phase_closeout"],
    "authority_never_grants": [
      "provider_credentials",
      "money_movement",
      "rights_transfer",
      "security_override",
      "legal_conclusion",
      "child_system_production_maturity",
      "unrelated_d3_authority"
    ]
  },
  "proprietary_assurance": {
    "enabled": true,
    "policy_file": "data/penta/proprietary-software-policy.json",
    "gate_script": "scripts/penta_proprietary_gate.py",
    "required_before_release_materialization": true,
    "required_on_materialized_package": true
  },
  "published_release_reconciliation": {
    "enabled": true,
    "max_releases": 20,
    "repair_missing_assets": true,
    "latest_release_required": true,
    "historical_backfill": "best_effort",
    "preserve_existing_notes": true,
    "preserve_existing_target": true,
    "required_assets": [
      "CrownThrive-OS-{tag}-package.zip",
      "CrownThrive-OS-{tag}-package.tar.gz",
      "SHA256SUMS",
      "MANIFEST.json",
      "RELEASE_NOTES.md"
    ]
  },
  "gates": {
    "require_clean_json": true,
    "require_python_compile": true,
    "require_secret_scan": true,
    "require_release_notes": true,
    "require_manifest": true,
    "require_sha256": true,
    "require_provider_readback": true,
    "require_proprietary_assurance": true,
    "d3_human_reserved": true,
    "hold_never_promoted_by_version_only": true
  }
}
