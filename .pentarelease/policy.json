{
  "policy_id": "ct.pentarelease.autonomous.v2",
  "version": "2.3.3",
  "enabled": true,
  "mode": "production",
  "decision_interval_minutes": 15,
  "default_version_scheme": "crownthrive_extended",
  "release_prefix": "v",
  "minimum_release_relevant_changes": 1,
  "docs_only_default": "hold",
  "generated_commit_prefixes": [
    "pentarelease(auto):",
    "PentaRelease release intelligence",
    "release:",
    "docs(pentarelease):"
  ],
  "ignored_paths": [
    "releases/",
    ".github/release-requests/",
    ".pentarelease/state/",
    "docs/archive/"
  ],
  "governed_docs_paths": [
    "docs/versioning/",
    "docs/phase3/",
    "PENTARELEASE.md",
    "AGENTS.md",
    "SECURITY.md"
  ],
  "runtime_paths": [
    "supabase/functions/",
    "runtime/",
    "services/",
    "src/",
    "api/",
    "mcp/"
  ],
  "integration_paths": [
    ".github/workflows/",
    "integrations/",
    "adapters/",
    "providers/"
  ],
  "security_paths": [
    "SECURITY.md",
    "security/",
    "policies/security/"
  ],
  "release_rules": {
    "breaking": {
      "signals": [
        "BREAKING CHANGE",
        "!:",
        "breaking:"
      ],
      "bump": "major",
      "requires_human_authority": true
    },
    "feature": {
      "signals": [
        "feat:",
        "feat(",
        "add subsystem",
        "new runtime",
        "new adapter",
        "new provider"
      ],
      "bump": "minor",
      "requires_human_authority": false
    },
    "fix": {
      "signals": [
        "fix:",
        "fix(",
        "security:",
        "hardening",
        "repair"
      ],
      "bump": "patch",
      "requires_human_authority": false
    },
    "evidence": {
      "signals": [
        "docs:",
        "docs(",
        "ci:",
        "chore:",
        "governance"
      ],
      "bump": "evidence",
      "requires_human_authority": false
    }
  },
  "published_release_reconciliation": {
    "enabled": true,
    "max_releases": 20,
    "repair_missing_assets": true,
    "latest_release_required": true,
    "historical_backfill": "best_effort",
    "preserve_existing_notes": true,
    "preserve_existing_target": true,
    "required_assets": [
      "CrownThrive-OS-{tag}-package.zip",
      "CrownThrive-OS-{tag}-package.tar.gz",
      "SHA256SUMS",
      "MANIFEST.json",
      "RELEASE_NOTES.md"
    ]
  },
  "release_surface": {
    "enabled": true,
    "max_repository_surfaces": 7,
    "max_pentadocs_tabs": 8,
    "state_file": ".pentarelease/state/release-surface.json",
    "managed_block_start": "<!-- pentarelease:managed-release-surface:start -->",
    "managed_block_end": "<!-- pentarelease:managed-release-surface:end -->",
    "delete_only_created_files": true,
    "preserve_unmanaged_content": true,
    "repository_surfaces": [
      {
        "path": "README.md",
        "label": "README",
        "mode": "managed_block"
      },
      {
        "path": "ABOUT_ME.md",
        "label": "About Us",
        "mode": "managed_block"
      },
      {
        "path": "LICENSE",
        "label": "License",
        "mode": "managed_block",
        "legal_text_preserved": true
      },
      {
        "path": "CODE_OF_CONDUCT.md",
        "label": "Code of Conduct",
        "mode": "managed_block"
      },
      {
        "path": "PARTNERS.md",
        "label": "Partners",
        "mode": "managed_block"
      },
      {
        "path": "FAQ.md",
        "label": "FAQ",
        "mode": "managed_block"
      },
      {
        "path": "CHANGELOG.md",
        "label": "Changelog",
        "mode": "managed_block"
      }
    ],
    "pentadocs": {
      "enabled": true,
      "config": "docs.json",
      "tab": "Releases & Evidence",
      "group": "PentaRelease",
      "pages": [
        "pentarelease/latest",
        "pentarelease/faq",
        "pentarelease/changelog",
        "pentarelease/costs",
        "pentarelease/cie",
        "pentarelease/data",
        "pentarelease/evidence"
      ]
    },
    "required_release_fields": [
      "official_release_url",
      "what_pentarelease_is",
      "what_changed",
      "why",
      "targets",
      "payload_costs",
      "cie_score",
      "data_availability",
      "evidence",
      "provenance"
    ]
  },
  "comprehensive_release_assets": {
    "enabled": true,
    "assets": [
      "PENTARELEASE_COMPREHENSIVE_RELEASE.md",
      "PENTARELEASE_RELEASE_RECORD.json",
      "PENTARELEASE_COSTS.json",
      "PENTARELEASE_CIE_SCORE.json",
      "PENTARELEASE_DATA_CATALOG.json",
      "PENTARELEASE_EVIDENCE.json",
      "PENTARELEASE_FAQ.md",
      "PENTARELEASE_CHANGELOG.md"
    ],
    "never_invent_costs": true,
    "never_invent_cie_scores": true,
    "unknown_value": null
  },
  "gates": {
    "require_clean_json": true,
    "require_python_compile": true,
    "require_secret_scan": true,
    "require_release_notes": true,
    "require_manifest": true,
    "require_sha256": true,
    "require_provider_readback": true,
    "d3_human_reserved": true,
    "hold_never_promoted_by_version_only": true
  }
}
