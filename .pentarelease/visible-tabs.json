{
  "schema": "ct.pentarelease.visible-tabs.v1",
  "enabled": true,
  "mode": "managed_blocks_only",
  "release_source": "latest_published_pentarelease",
  "managed_block_start": "<!-- pentarelease:managed-release-surface:start -->",
  "managed_block_end": "<!-- pentarelease:managed-release-surface:end -->",
  "preserve_unmanaged_content": true,
  "fail_closed_on_missing_surface": true,
  "surfaces": [
    {
      "path": "CONTRIBUTING.md",
      "label": "Contributing"
    },
    {
      "path": "SECURITY.md",
      "label": "Security"
    }
  ],
  "reconciliation": {
    "after_comprehensive_release": true,
    "scheduled_recheck": true,
    "state_file": ".pentarelease/state/visible-tabs.json"
  },
  "drive_projection": {
    "required": true,
    "mode": "provider_bound_fail_closed",
    "queue_contract": "ct.pentarelease.drive-sync.v1",
    "never_fabricate_provider_write": true
  }
}
