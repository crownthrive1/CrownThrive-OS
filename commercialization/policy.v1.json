{
  "schema_version": "1.0.0",
  "policy_id": "ct.policy.cos-v1-commercialization-fabric.v1",
  "component_id": "ct.cos.commercialization-fabric",
  "component_version": "1.0.0-rc.1",
  "institutional_generation": "phase_3",
  "os_compatibility": "3.x",
  "owner": "CrownThrive, LLC",
  "licensing_contact": "contact@crownthrive.com",
  "mode": "evidence_derived_fail_closed",
  "source_roots": [
    "developers/manifests",
    "commercialization/products",
    "data",
    "penta/registry",
    "releases"
  ],
  "exclude_roots": [
    "docs/archive",
    "commercialization/generated",
    "releases/archive"
  ],
  "record_collections": [
    "components",
    "plugins",
    "pallet_plugins",
    "pallets",
    "modules",
    "root_assets",
    "assets",
    "packages",
    "products"
  ],
  "identity_keys": [
    "component_id",
    "plugin_id",
    "pallet_id",
    "module_id",
    "asset_id",
    "package_id",
    "product_id",
    "suite_id",
    "manifest_id"
  ],
  "name_keys": [
    "canonical_name",
    "name",
    "title"
  ],
  "type_keys": [
    "component_type",
    "asset_type",
    "package_type",
    "product_type",
    "type"
  ],
  "version_keys": [
    "version",
    "component_version",
    "schema_version"
  ],
  "certification": {
    "accepted_values": [
      "PASS",
      "PRODUCTION_CERTIFIED",
      "CERTIFIED_PRODUCTION"
    ],
    "explicit_paths": [
      "production_certification",
      "certification_state",
      "certification.status",
      "certification.state",
      "production.status",
      "release.certification_state"
    ],
    "composite_release_rule": {
      "enabled": true,
      "lifecycle_values": [
        "released",
        "production"
      ],
      "required_nonempty_paths": [
        "release_tag"
      ],
      "required_pass_paths": [
        "provider_readback_state",
        "independent_verification_state"
      ]
    },
    "never_infer_from": [
      "lifecycle_state",
      "version",
      "workflow_success",
      "provider_http_success",
      "public_visibility",
      "documentation_claim"
    ]
  },
  "visibility": {
    "blocked_values": [
      "restricted",
      "confidential",
      "private",
      "vault_only",
      "no_release"
    ],
    "explicit_paths": [
      "visibility",
      "classification",
      "release_class",
      "data_class"
    ],
    "public_repository_source_is_public_safe_projection_only": true
  },
  "commercialization": {
    "default_paid_mode": "NEGOTIATED_COMMERCIAL",
    "self_service_requires_approved_fixed_price": true,
    "self_service_requires_economic_gate_pass": true,
    "paid_offer_without_price_becomes_request_quote": true,
    "free_evaluation_offer_enabled": true,
    "free_evaluation_license_id": "ct.license.cos-community-evaluation.v1",
    "free_evaluation_price_minor": 0,
    "free_evaluation_currency": "USD",
    "free_evaluation_creates_production_rights": false,
    "paid_settlement_requires_chlom_wallet_authorization": true,
    "paid_settlement_requires_exact_ecac": true,
    "paid_settlement_requires_dail_receipt": true,
    "pricing_unknown_value": null,
    "never_invent_prices": true,
    "never_invent_certification": true,
    "free_evaluation_requires_explicit_authorization": true,
    "free_evaluation_authorization_paths": [
      "free_evaluation_authorized",
      "commercialization.free_evaluation_authorized"
    ]
  },
  "publication": {
    "default": "dry_run",
    "universal_formats": [
      "git",
      "github_release",
      "oci_artifact",
      "zip",
      "tar_gz",
      "json_schema",
      "openapi",
      "mcp"
    ],
    "required_evidence": [
      "exact_source_sha",
      "manifest",
      "release_notes",
      "sha256",
      "sbom_spdx_2_3",
      "provenance",
      "tests",
      "independent_verification",
      "provider_readback"
    ],
    "secrets_allowed": false,
    "direct_main_publication_allowed": false,
    "penta_release_required": true
  },
  "routing_policy_ref": "commercialization/routing/mesh-routing.v1.json",
  "wallet_contract_ref": "commercialization/chlom/wallet-bridge.contract.v1.json",
  "package_targets_ref": "commercialization/package-targets.v1.json",
  "rollback_ref": "commercialization/ROLLBACK.md"
}
