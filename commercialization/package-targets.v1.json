{
  "schema_version": "1.0.0",
  "manifest_id": "ct.manifest.cos-commercial-package-targets.v1",
  "universal_contract": {
    "purpose": "Language-neutral installation and interoperability baseline for every certified package.",
    "required": [
      "Git source reference pinned to an immutable tag or SHA",
      "GitHub Release ZIP and TAR.GZ",
      "OCI artifact descriptor",
      "JSON Schema contracts",
      "OpenAPI contract where HTTP is exposed",
      "MCP tool contract where agent access is exposed",
      "SPDX 2.3 SBOM",
      "SLSA-compatible provenance statement",
      "SHA-256 checksum manifest"
    ]
  },
  "native_registry_adapters": [
    {
      "ecosystem": "JavaScript/TypeScript",
      "registry": "npm",
      "descriptor": "package.json",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": "Python",
      "registry": "PyPI",
      "descriptor": "pyproject.toml",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": "Java/Kotlin/JVM",
      "registry": "Maven Central",
      "descriptor": "pom.xml",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": ".NET",
      "registry": "NuGet",
      "descriptor": "*.nuspec",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": "Rust",
      "registry": "crates.io",
      "descriptor": "Cargo.toml",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": "Go",
      "registry": "Go module proxy via Git tags",
      "descriptor": "go.mod",
      "publish_state": "git_tag_required"
    },
    {
      "ecosystem": "PHP",
      "registry": "Packagist/Composer",
      "descriptor": "composer.json",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": "Ruby",
      "registry": "RubyGems",
      "descriptor": "*.gemspec",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": "Swift",
      "registry": "Swift Package Manager",
      "descriptor": "Package.swift",
      "publish_state": "git_tag_required"
    },
    {
      "ecosystem": "Dart/Flutter",
      "registry": "pub.dev",
      "descriptor": "pubspec.yaml",
      "publish_state": "descriptor_ready_credentials_required"
    },
    {
      "ecosystem": "Containers and any language",
      "registry": "OCI/GitHub Container Registry",
      "descriptor": "oci-layout/index.json",
      "publish_state": "descriptor_ready_protected_environment_required"
    }
  ],
  "unsupported_language_rule": "Use the universal Git + OCI + JSON Schema/OpenAPI/MCP package until a native adapter is certified; do not block interoperability solely because a language lacks a dedicated registry adapter.",
  "adapter_factory": {
    "generator_ref": "scripts/commercialization/generate_adapters.py",
    "output_ref": "dist/commercialization/registry-adapters",
    "state": "BUILT_BY_CI_PROVIDER_VALIDATION_REQUIRED",
    "publication_authorized": false,
    "package_semantics": "public-safe metadata and immutable source-coordinate adapters; no restricted implementation or implied license"
  }
}
