{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/chlom/license-offer.v1.json",
  "title": "CrownThrive CHLOM Commercial License Offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offer_id",
    "component_id",
    "component_version",
    "offer_type",
    "license_id",
    "offer_state",
    "price_mode",
    "currency",
    "wallet_route",
    "entitlement_type"
  ],
  "properties": {
    "offer_id": {"type": "string", "minLength": 3},
    "component_id": {"type": "string", "minLength": 3},
    "component_version": {"type": "string", "minLength": 1},
    "offer_type": {
      "enum": ["FREE_EVALUATION", "NEGOTIATED_COMMERCIAL", "FIXED_PRICE", "METERED"]
    },
    "license_id": {"type": "string", "minLength": 3},
    "offer_state": {
      "enum": ["ACTIVE", "REQUEST_QUOTE", "HOLD", "RETIRED"]
    },
    "price_mode": {
      "enum": ["FREE", "NEGOTIATED", "FIXED", "METERED"]
    },
    "amount_minor": {"type": ["integer", "null"], "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3,8}$"},
    "wallet_route": {"enum": ["NONE", "CHLOM_WALLET", "CHLOM_QUOTE_THEN_WALLET"]},
    "entitlement_type": {"type": "string", "minLength": 1},
    "economic_gate_state": {"enum": ["PASS", "HOLD", "NOT_REQUIRED"]},
    "rights_gate_state": {"enum": ["PASS", "HOLD"]},
    "certification_fingerprint": {"type": ["string", "null"]},
    "source_sha": {"type": ["string", "null"]}
  }
}
