{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/schemas/maintenance-preflight-v1.json",
  "title": "CrownThrive Maintenance Preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor_id", "capability_id", "mutation_requested", "d3_requested"],
  "properties": {
    "actor_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "mutation_requested": {"type": "boolean"},
    "d3_requested": {"type": "boolean"},
    "maintenance_event_id": {"type": ["string", "null"]},
    "change_id": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "$defs": {
    "decision": {
      "type": "string",
      "enum": ["PASS_NOT_IN_MAINTENANCE", "PASS_READ_ONLY", "PASS_MAINTENANCE_SCOPE", "HOLD_PAUSED_FOR_TARGETED_MAINTENANCE", "HOLD_D3_HUMAN_RESERVED"]
    }
  }
}
