{
  "manifest_version": "1.0.0",
  "package_id": "{{PACKAGE_ID}}",
  "framework_id": "{{FRAMEWORK_ID}}",
  "tools": [
    {
      "tool_id": "{{FRAMEWORK_ID}}.health",
      "name": "Framework package health",
      "risk": "D0",
      "enabled": true,
      "implementation": "python3 engine/engine.py health",
      "provider_write": false,
      "customer_write": false
    },
    {
      "tool_id": "{{FRAMEWORK_ID}}.validate",
      "name": "Validate framework package",
      "risk": "D0",
      "enabled": true,
      "implementation": "python3 scripts/validate_child_repository.py",
      "provider_write": false,
      "customer_write": false
    },
    {
      "tool_id": "{{FRAMEWORK_ID}}.evaluate",
      "name": "Governed framework evaluation",
      "risk": "D2",
      "enabled": false,
      "implementation": "governed_private_runtime_via_api_mcp_federation",
      "provider_write": false,
      "customer_write": false,
      "activation_requires": [
        "bounded_schema",
        "private_runtime_digest_available",
        "workflow_ref_environment_agent_capability_binding",
        "parent_certification",
        "governed_framework_acceptance"
      ]
    }
  ]
}
