      "material_transitions": ["work.claimed", "work.completed", "work.failed", "schedule.changed", "escalation.created"],
      "write_mode": "transactional_outbox",
      "body_custody": "agent_work_queue",
      "binding_state": "EXISTING_RELAY_REUSED_ADAPTER_PENDING"
    },
    {
      "surface_id": "ct.os.mesh-continuity",
      "material_transitions": ["route.changed", "failover.activated", "recovery.completed", "service.held"],
      "write_mode": "same_transaction_or_fail_closed_outbox",
      "body_custody": "mesh_control_plane",
      "binding_state": "CONTRACT_REQUIRED_ADAPTER_CENSUS_PENDING"
    },
    {
      "surface_id": "ct.os.backup-preservation",
      "material_transitions": ["backup.completed", "backup.readback", "restore.tested", "custody.changed"],
      "write_mode": "receipt_then_independent_readback_then_dail",
      "body_custody": "authorized_archive_and_object_store",
      "binding_state": "CONTRACT_REQUIRED_ADAPTER_CENSUS_PENDING"
    },
    {
      "surface_id": "ct.os.docs-public-projections",
      "material_transitions": ["documentation.published", "public_claim.corrected", "projection.changed"],
