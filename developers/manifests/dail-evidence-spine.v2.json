    },
    {
      "surface_id": "ct.os.rights-licensing",
      "material_transitions": ["rights.asserted", "license.issued", "license.revoked", "remedy.changed"],
      "write_mode": "same_transaction_fail_closed",
      "body_custody": "Rights_Vault_and_ThriveBase_restricted",
