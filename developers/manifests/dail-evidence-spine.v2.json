    },
    {
      "surface_id": "ct.os.thrivebase-domain-state",
      "material_transitions": ["domain_state.created", "domain_state.changed", "domain_state.corrected"],
      "write_mode": "transactional_rpc_or_fail_closed_outbox",
      "body_custody": "owning_database_schema",
      "binding_state": "DAIL_V2_RPC_SOURCE_IMPLEMENTED_DOMAIN_ADAPTER_CENSUS_PENDING"
    },
    {
