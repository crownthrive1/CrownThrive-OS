    },
    {
      "surface_id": "ct.os.observability-telemetry",
      "material_transitions": ["incident.opened", "incident.closed", "security.finding", "assurance.changed"],
      "write_mode": "material_events_fail_closed_low_risk_samples_may_queue_unsealed",
      "body_custody": "telemetry_store",
      "binding_state": "REFERENCE_QUEUE_POLICY_IMPLEMENTED_RUNTIME_ADAPTER_PENDING"
    }
  ],
  "runtime_bindings": [
    {
      "binding_id": "ct.dail.postgres.v2",
      "surface": "chlom_runtime.dail_events",
      "role": "canonical_append_only_chain",
      "state": "SOURCE_IMPLEMENTED_RUNTIME_APPLY_PENDING"
    },
    {
      "binding_id": "ct.dail.external-ingress.stripe.v1",
      "surface": "supabase/functions/dail-external-ingress",
      "role": "provider_authenticated_raw_body_ingress",
      "state": "SOURCE_IMPLEMENTED_SECRET_AND_RUNTIME_BINDING_PENDING"
    },
    {
      "binding_id": "ct.dail.external-evidence-relay.v1",
      "surface": "ct.schedule.external-evidence-relay.hourly.v1",
      "role": "separate_provider_readback_and_anchor_dispatch",
      "state": "EXISTING_CLOCK_ADAPTER_PENDING"
    },
    {
      "binding_id": "ct.dail.penta-serialized-wal.v1",
      "surface": "penta/runtime/serialized",
      "role": "local_failover_spool_not_canonical_authority",
      "state": "ADAPTER_CONTRACT_IMPLEMENTED"
    },
    {
      "binding_id": "ct.dail.factory-continuation.v2",
      "surface": "developers/manifests/dail-factory-continuation.v2.json",
      "role": "deterministic_factory_checkpoint_and_resume",
      "state": "PARTIAL_SOURCE_IMPLEMENTATION_CLAIM_RECLAIM_PENDING"
    },
    {
      "binding_id": "ct.dail.independent-anchor.v1",
      "surface": "chlom_runtime.external_anchor_receipts_v2",
      "role": "independent_checkpoint_write_and_readback",
      "state": "SCHEMA_IMPLEMENTED_ADAPTER_NOT_BUILT_NO_PRODUCTION_CLAIM"
    }
  ],
  "coverage_controls": {
    "material_event_inventory_required": true,
    "exactly_one_canonical_receipt_per_material_transition": true,
    "domain_receipt_tables_are_projections_not_competing_authorities": true,
    "certification_blocks_on_missing_or_unsealed_receipt": true,
    "raw_payload_in_dail": false,
    "secret_in_dail": false,
    "corrections_append_only": true
  },
  "promotion_gates": [
    "migration applies to a disposable database and preserves legacy chain verification",
    "RLS, privileges, update, delete and truncate negative tests pass",
    "valid, invalid, stale, rotated-secret and replay webhook tests pass",
    "provider readback is executed by a distinct authenticated trust domain",
    "factory crash, lease, fencing, deterministic digest and rollback tests pass",
    "external checkpoint write and independent readback pass",
    "cross-repository exact-SHA projection is independently verified",
    "D3 human promotion decision is recorded"
  ]
