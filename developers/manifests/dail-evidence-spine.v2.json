      "binding_state": "SOURCE_CONTRACT_IMPLEMENTED_RUNTIME_ADAPTER_PENDING"
    },
    {
      "surface_id": "ct.os.release-distribution",
      "material_transitions": ["release.candidate", "release.published", "artifact.readback", "release.rolled_back"],
