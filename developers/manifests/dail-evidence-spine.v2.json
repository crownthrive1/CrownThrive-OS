{
  "schema_version": "2.0.0",
  "manifest_id": "ct.manifest.dail-evidence-spine.v2",
  "contract": "developers/contracts/dail-evidence-spine.contract.v2.json",
  "lifecycle_state": "SOURCE_IMPLEMENTED_PENDING_INDEPENDENT_VERIFICATION_AND_RUNTIME_APPLY",
  "framework_count_delta": 0,
  "native_substrate_state": "DEFERRED_TARGET_ARCHITECTURE",
  "canonical_chain_id": "ct.dail.global.v1",
  "integration_rule": "Every material state transition must receive one canonical DAIL receipt in the same transaction or through a fail-closed transactional outbox. Raw bodies and high-volume telemetry remain in authorized stores and are represented by digests and references.",
  "pentafabric_layer_bindings": [
    {
      "layer_id": "ct.pentafabric.identity-imprint",
      "material_event_families": ["identity.created", "identity.changed", "custody.changed", "provenance.corrected"],
      "write_mode": "same_transaction",
      "minimum_evidence_class": "E2_SEPARATE_WORKLOAD_VERIFIED"
    },
    {
      "layer_id": "ct.pentafabric.rights-conditions",
      "material_event_families": ["rights.asserted", "rights.approved", "license.issued", "license.revoked", "policy.decision", "hold.changed"],
      "write_mode": "same_transaction",
      "minimum_evidence_class": "E2_SEPARATE_WORKLOAD_VERIFIED"
    },
    {
      "layer_id": "ct.pentafabric.ledger-assurance",
      "material_event_families": ["evidence.accepted", "verification.completed", "checkpoint.anchored", "correction.appended", "certification.decided"],
      "write_mode": "canonical_append",
      "minimum_evidence_class": "E1_INTERNAL_HASHED"
    },
    {
      "layer_id": "ct.pentafabric.execution-interoperability",
      "material_event_families": ["build.transitioned", "deployment.transitioned", "provider.operation", "mesh.failover", "rollback.completed"],
      "write_mode": "same_transaction_or_transactional_outbox",
      "minimum_evidence_class": "E2_SEPARATE_WORKLOAD_VERIFIED"
    },
    {
      "layer_id": "ct.pentafabric.economy-distribution",
      "material_event_families": ["commerce.activated", "payment.provider_event", "entitlement.changed", "settlement.reconciled", "payout.transitioned"],
      "write_mode": "same_transaction_fail_closed",
      "minimum_evidence_class": "E4_EXTERNAL_SYMMETRIC_VERIFIED"
    }
  ],
  "capability_pallet_bindings": [
    {"pallet_id": "P-01", "name": "Identity & Access", "event_families": ["identity", "access", "authentication"], "classification": "restricted", "dail_receipt_required": true},
    {"pallet_id": "P-02", "name": "Governance & Compliance", "event_families": ["authority", "approval", "policy", "compliance", "hold"], "classification": "internal_or_restricted", "dail_receipt_required": true},
    {"pallet_id": "P-03", "name": "Rights & Licensing", "event_families": ["rights", "license", "revocation", "remedy"], "classification": "restricted", "dail_receipt_required": true},
    {"pallet_id": "P-04", "name": "Media & Intellectual Property", "event_families": ["asset", "provenance", "custody", "publication"], "classification": "mixed", "dail_receipt_required": true},
    {"pallet_id": "P-05", "name": "Growth, Advertising & Measurement", "event_families": ["campaign", "attribution", "conversion", "measurement"], "classification": "mixed", "dail_receipt_required": true},
    {"pallet_id": "P-06", "name": "Commerce, Booking & Loyalty", "event_families": ["product", "offer", "order", "booking", "entitlement", "loyalty"], "classification": "restricted", "dail_receipt_required": true},
    {"pallet_id": "P-07", "name": "Community, Directory & Events", "event_families": ["membership", "directory", "community_event"], "classification": "mixed", "dail_receipt_required": true},
    {"pallet_id": "P-08", "name": "Education, Incubator & Impact", "event_families": ["enrollment", "credential", "incubation", "impact"], "classification": "mixed", "dail_receipt_required": true},
    {"pallet_id": "P-09", "name": "Physical Suites & Place-Based", "event_families": ["place", "suite", "occupancy", "facility"], "classification": "restricted", "dail_receipt_required": true},
    {"pallet_id": "P-10", "name": "Operations & Institutional Memory", "event_families": ["operation", "incident", "backup", "restore", "documentation", "factory"], "classification": "internal", "dail_receipt_required": true},
    {"pallet_id": "P-11", "name": "Capital, Revenue & Settlement", "event_families": ["price", "payment", "revenue", "royalty", "commission", "settlement"], "classification": "restricted", "dail_receipt_required": true},
    {"pallet_id": "P-12", "name": "Sustainability & Impact Evidence", "event_families": ["sustainability", "impact_evidence", "attestation"], "classification": "mixed", "dail_receipt_required": true}
  ],
