{
  "schema_version": "1.0.0",
  "stable_id": "ct.capability.authoritative-expert-source-router.v1",
  "name": "CrownThrive Authoritative Expert Source Fabric",
  "program_phase": "2.99",
  "phase_3_entry": "blocked_pending_phase_2_99_hard_exit",
  "status": "prepared_not_activated",
  "authority_model": {
    "precedence_reference": "/knowledge/source-authority-hierarchy",
    "default_rule": "Primary authoritative sources outrank secondary/open sources within the source's actual claim scope.",
    "three_layer_provider_rule": [
      "provider_capability",
      "crownthrive_account_entitlement",
      "crownthrive_deployed_integration"
    ],
    "material_claim_promotion": "fail_closed_without_authoritative_evidence"
  },
  "inheritance": {
    "scope": "institution_wide",
    "agents": "all_registered_agents",
    "projects": "all_current_and_future_crownthrive_projects",
    "mcp_surfaces": [
      "CrownThrive IO / MCP",
      "project MCP adapters",
      "governed child-repository federation"
    ],
    "runtime_dispatch_binding": "pending_collision_safe_registry_and_federation_reconciliation",
    "child_repository_binding": "pending_pr_169_or_successor_reconciliation",
    "effective_contract": "Every research, verification, reconciliation, policy, technical, market, legal, security, health, economic, rights, accessibility, procurement, standards, or public-claim task must route through this fabric before consequential state promotion."
  },
  "safety": {
    "phase_2_99_methods": [
      "GET",
      "HEAD"
    ],
    "provider_mutation": false,
    "credential_storage_in_git": false,
    "credential_runtime_rule": "vault_or_provider_secret_store_only",
    "high_consequence_domains": [
      "legal_regulatory",
      "tax_finance",
      "securities",
      "health_biomedical",
      "ip_rights_licensing",
      "cybersecurity",
      "accessibility_consumer_protection"
    ],
    "high_consequence_rule": "Sources inform evidence; applicable specialist and human/governed authority remain required for consequential decisions.",
    "founder_overrides": [
      {
        "id": "ct.override.soundcloud-api.2026-08-20",
        "provider": "SoundCloud API",
        "status": "removed_by_founder_override",
        "rule": "Do not request, store, configure, certify, depend on, or route tasks through SoundCloud APIs."
      }
    ]
  },
  "mcp_contracts": [
    {
      "tool": "expert_sources.route",
      "purpose": "Return ranked source records and review policy for a task/domain.",
      "mode": "local_read_only",
      "state": "contracted"
    },
    {
      "tool": "expert_sources.search",
      "purpose": "Search an approved provider through a scoped read adapter.",
      "mode": "read_only",
      "state": "prepared_not_activated"
    },
    {
      "tool": "expert_sources.fetch",
      "purpose": "Fetch a specific approved public/authorized record and preserve provenance metadata.",
      "mode": "read_only",
      "state": "prepared_not_activated"
    },
    {
      "tool": "expert_sources.health",
      "purpose": "Check configured source/adaptor reachability without promoting provider capability to CrownThrive deployment.",
      "mode": "read_only",
      "state": "prepared_not_activated"
    }
  ],
  "domain_profiles": {
    "economics_demographics": {
      "sources": [
        "us_census",
        "bls",
        "bea",
        "world_bank"
      ],
      "review_policy": "primary_stats_then_crosscheck"
    },
    "securities": {
      "sources": [
        "sec_edgar",
        "federal_register",
        "congress_gov"
      ],
      "review_policy": "primary_authority_plus_finance_legal_review"
    },
    "cybersecurity": {
      "sources": [
        "nvd",
        "cisa_kev",
        "nist_standards"
      ],
      "review_policy": "primary_security_sources_plus_security_review"
    },
    "legal_regulatory": {
      "sources": [
        "federal_register",
        "regulations_gov",
        "congress_gov",
        "ftc_legal_library",
        "doj_ada"
      ],
      "review_policy": "primary_law_policy_sources_plus_legal_review"
    },
    "health_biomedical": {
      "sources": [
        "openfda",
        "clinicaltrials_gov",
        "ncbi_eutilities"
      ],
      "review_policy": "primary_health_sources_plus_health_safety_review"
    },
    "energy_environment": {
      "sources": [
        "eia",
        "nasa_open_apis"
      ],
      "review_policy": "primary_agency_data"
    },
    "procurement_grants": {
      "sources": [
        "sam_gov"
      ],
      "review_policy": "official_opportunity_record"
    },
    "research_scholarship": {
      "sources": [
        "crossref",
        "openalex",
        "ncbi_eutilities"
      ],
      "review_policy": "metadata_discovery_then_primary_work"
    },
    "ip_rights_licensing": {
      "sources": [
        "copyright_office",
        "federal_register",
        "congress_gov"
      ],
      "review_policy": "primary_ip_authority_plus_rights_review"
    },
    "accessibility_consumer_protection": {
      "sources": [
        "doj_ada",
        "ftc_legal_library",
        "w3c_standards"
      ],
      "review_policy": "primary_regulator_and_standard_plus_specialist_review"
    },
    "standards_protocols": {
      "sources": [
        "nist_standards",
        "w3c_standards",
        "crossref"
      ],
      "review_policy": "official_standard_or_registry"
    },
    "open_entity_research": {
      "sources": [
        "openalex",
        "crossref"
      ],
      "review_policy": "secondary_open_discovery_only_do_not_override_primary"
    }
  },
