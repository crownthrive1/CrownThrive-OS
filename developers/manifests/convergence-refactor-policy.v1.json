{
  "manifest_id": "ct.manifest.convergence-refactor-policy.v1",
  "version": "1.0.0",
  "phase": "2.99",
  "state": "controlled_test_pending_governed_acceptance",
  "parent_packet": "ct.manifest.collision-governance-founder-orchestration.v1",
  "purpose": "Rotate CrownThrive attention from uncontrolled expansion toward convergence, canonicalization, and refactoring when repository/runtime/documentation sprawl rises, while preserving all knowledge and history.",
  "authority": {
    "sovereign_voter_pool_changes": false,
    "d3_remains_human_reserved": true,
    "provider_write_authority": false,
    "merge_authority": false,
    "branch_delete_authority": false,
    "file_delete_authority": false,
    "force_push_authority": false,
    "silent_pr_close_authority": false,
    "unknown_to_pass_authority": false
  },
  "extension_agents": [
    {
      "agent_id": "ct.subagent.convergence.rotor",
      "display_name": "Convergence Rotor",
      "vote_eligible": false,
      "authority": "D1_attention_routing_only",
      "responsibilities": [
        "measure_open_pr_and_staleness_pressure",
        "measure_material_collision_pressure",
        "select_expansion_balanced_convergence_or_incident_attention_mode",
        "rotate_final_review_attention_toward_hard_exit_and_canonicalization",
        "deprioritize_new_noncritical_promotion_without_discarding_work",
        "emit_bounded_attention_budget_and_reason"
      ]
    },
    {
      "agent_id": "ct.subagent.refactor.steward",
      "display_name": "Refactor Steward",
      "vote_eligible": false,
      "authority": "D1_lineage_and_refactor_planning",
      "responsibilities": [
        "identify_duplicate_or_superseded_current_claims",
        "preserve_predecessor_branch_pr_page_manifest_and_decision_lineage",
        "recommend_stack_extract_unique_delta_rebase_or_supersede_with_lineage",
        "prefer_current_owner_update_over_new_parallel_surface",
        "preserve_historical_content_before_current_projection_changes",
        "emit_refactor_plan_without_destructive_mutation"
      ]
    }
  ],
  "reuse_existing_roles": [
    "ct.subagent.collision.preflight-sentinel",
    "ct.subagent.collision.adjudicator",
    "ct.subagent.collision.postmerge-reconciler",
    "ct.subagent.queue.priority-throttle",
    "ct.subagent.quorum.session-router",
    "ct.agent.founder-orchestrator"
  ],
  "attention_modes": {
    "EXPANSION": {
      "closure_percent": 35,
      "current_build_percent": 45,
      "research_percent": 20
    },
    "BALANCED": {
      "closure_percent": 50,
      "current_build_percent": 35,
      "research_percent": 15
    },
    "CONVERGENCE": {
      "closure_percent": 70,
      "current_build_percent": 20,
      "research_percent": 10
    },
    "INCIDENT": {
      "closure_percent": 80,
      "current_build_percent": 15,
      "research_percent": 5
    }
  },
  "mode_thresholds": {
    "convergence_if_open_prs_at_least": 20,
    "convergence_if_stale_main_prs_at_least": 8,
    "convergence_if_material_collisions_at_least": 8,
    "balanced_if_open_prs_at_least": 10,
    "balanced_if_stale_main_prs_at_least": 3,
    "incident_requires_explicit_critical_security_or_founder_priority_signal": true
  },
  "refactor_sequence": [
    "canonical_main_and_merge_perimeter",
    "phase_2_99_hard_exit_and_full_documentation_gate",
    "current_truth_documentation_and_source_registry",
    "runtime_api_mcp_provider_state",
    "agent_framework_and_federation_state",
    "product_and_platform_verticals",
    "future_research_and_experimental_work"
  ],
  "refactor_dispositions": [
    "preserve_active",
    "preserve_and_rebase",
    "preserve_and_stack_on_current_owner",
    "preserve_and_extract_unique_delta",
    "preserve_as_superseded_history_with_successor_link",
    "hold_for_adjudication",
    "continue_research_without_promotion"
  ],
  "knowledge_preservation": {
    "never_silently_destroy_knowledge": true,
    "never_silently_overwrite_history": true,
    "no_automation_branch_deletion": true,
    "no_automation_file_deletion": true,
    "no_force_push": true,
    "no_silent_pr_closure": true,
    "supersession_requires_successor_or_reason": true,
    "supersession_requires_predecessor_reference": true,
    "material_current_page_change_requires_version_or_changelog": true,
    "historical_claims_remain_preserved_even_when_no_longer_current": true
  },
  "whole_system_refactor_rule": {
    "prefer_update_existing_owner_over_create_parallel_owner": true,
    "prefer_extract_unique_delta_over_wholesale_stale_pr_promotion": true,
    "runtime_ahead_of_main_is_convergence_pressure": true,
    "documentation_ahead_or_behind_runtime_is_convergence_pressure": true,
    "registry_growth_alone_is_not_certification_debt": true,
    "research_may_continue_while_final_promotion_is_throttled": true,
    "final_quorum_attention_must_follow_current_priority_and_collision_state": true
  },
  "phase_3_boundary": {
    "phase_3_advancement": false,
    "this_policy_closes_no_hard_gate_by_itself": true,
    "purpose_before_phase_3": "reduce canonical/runtime/docs divergence and refactor the estate into one accepted exact snapshot"
  }
}
