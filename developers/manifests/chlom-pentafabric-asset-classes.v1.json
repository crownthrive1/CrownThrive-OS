{
  "schema_version": "1.0.0",
  "manifest_id": "ct.manifest.chlom-pentafabric-asset-classes.v1",
  "system": "CHLOM",
  "architecture": "ct.architecture.pentafabric.v1",
  "purpose": "Ensure important CHLOM-designed assets are individually identifiable, versionable, documentable, factory-addressable, public/private classifiable, and commercially packageable rather than disappearing inside umbrella pages.",
  "articleization_required_for_material_assets": true,
  "classes": [
    "pallet",
    "module",
    "container",
    "component",
    "service",
    "framework",
    "plugin",
    "skill",
    "algorithm",
    "formula",
    "prompt",
    "script",
    "workflow",
    "agent",
    "sub_agent",
    "oracle",
    "contract",
    "schema",
    "registry",
    "event",
    "api",
    "mcp_server",
    "mcp_tool",
    "mcp_resource",
    "sdk",
    "webhook",
    "adapter",
    "wireframe",
    "scaffold",
    "portal",
    "dashboard",
    "widget",
    "website_surface",
    "mesh_route",
    "license_class",
    "dynamic_licensing_asset",
    "identity_profile",
    "did_profile",
    "fingerprint_profile",
    "dail_record_type",
    "policy_pack",
    "compliance_rule",
    "remedy_profile",
    "commercial_package",
    "research_program",
    "paper",
    "runbook",
    "evaluation_pack",
    "test_suite"
  ],
  "minimum_record": [
    "stable_id",
    "canonical_name",
    "asset_class",
    "version",
    "lifecycle_state",
    "pentafabric_layers",
    "purpose",
    "source_or_authority_reference",
    "rights_classification",
    "public_private_classification",
    "dependencies",
    "verification_state",
    "factory_state",
    "commercialization_state",
    "supersedes_or_successor_relationships"
  ],
  "documentation_rules": {
    "combination_article_may_replace_material_asset_article": false,
    "historical_assets_are_preserved": true,
    "historical_asset_may_be_marked_current_without_evidence": false,
    "new_evidence_versions_existing_record": true,
    "material_formulas_and_algorithms_require_vault_or_public_safe_classification": true,
    "public_article_may_expose_private_body": false,
    "public_article_may_reference_private_body_opaquely": true
  },
  "factory_rules": {
    "each_material_asset_is_individually_addressable": true,
    "parent_child_projection_may_bundle_delivery_but_not_identity": true,
    "build_receipt_is_certification": false,
    "independent_verification_required_for_promotion": true
  },
  "commercial_rules": {
    "verified_asset_can_be_considered_for_packaging": true,
    "commercial_package_may_bundle_multiple_assets": true,
    "bundle_does_not_erase_component_rights": true,
    "sku_issuance_authority": "ThriveEvergreen",
    "economic_decision": "ECAC"
  }
}
