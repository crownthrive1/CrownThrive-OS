{
  "schema_version": "1.0.0",
  "factory_id": "ct.release-factory.commercial-sites.v1",
  "originating_agent_id": "ct.agent.commercial-release-packager",
  "originator_vote_eligible": false,
  "originator_self_approval": false,
  "exact_head_required": true,
  "review_routes": [
    {"dimension": "rights_provenance", "reviewer_ref": "ct.reviewer.rights-governance", "required": true},
    {"dimension": "pricing_tax", "reviewer_ref": "ct.reviewer.finance-tax", "required": true},
    {"dimension": "private_fulfillment", "reviewer_ref": "ct.reviewer.operations-sre", "required": true},
    {"dimension": "credit_checkout_webhook", "reviewer_ref": "ct.reviewer.commerce-payments", "required": true},
    {"dimension": "entitlement_license", "reviewer_ref": "ct.reviewer.rights-entitlement", "required": true},
    {"dimension": "refund_dispute_rollback", "reviewer_ref": "ct.reviewer.commerce-remedies", "required": true},
    {"dimension": "accessibility_device", "reviewer_ref": "ct.reviewer.accessibility", "required": true},
    {"dimension": "dns_tls_route", "reviewer_ref": "ct.reviewer.domain-release", "required": true},
    {"dimension": "governed_acceptance_publication", "reviewer_ref": "ct.relay.agent-d", "required": true}
  ],
  "promotion_policy": "ct.site.autopublish.v1",
  "minimum_yes_votes": 4,
  "mandatory_vote_agent": "ct.relay.agent-d",
  "synthetic_votes_authoritative": false,
  "authority_receipt_required": true,
  "current_disposition": "HOLD",
  "reopen_conditions": [
    "head_or_content_hash_changes",
    "source_or_rights_authority_changes",
    "price_or_tax_policy_changes",
    "fulfillment_or_entitlement_contract_changes",
    "provider_or_route_state_changes",
    "accessibility_evidence_changes",
    "negative_or_stale_reviewer_disposition"
  ]
}
