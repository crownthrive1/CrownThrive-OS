{
  "schema_version": "1.0.0",
  "factory_id": "ct.release-factory.commercial-sites.v1",
  "receipt_requirements": [
    "exact subject and version",
    "content digest",
    "evidence class",
    "source authority",
    "producer identity",
    "independent reviewer identity when required",
    "observed or asserted time",
    "expiry or freshness semantics",
    "rollback reference when consequential",
    "public/private disclosure classification"
  ],
  "invalid_for_pass": ["missing","stale","contradictory","wrong_version","originator_only_when_independent_required","synthetic_vote_without_authority_receipt"],
  "public_receipts": "digest and sanitized reason codes only"
}
