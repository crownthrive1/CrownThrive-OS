{
  "manifest_version": "1.0.0",
  "manifest_id": "ct.manifest.security-self-healing-policy.v1",
  "phase": "2.99",
  "control_model": "continuous_detect_triage_repair_revalidate_independent_verify",
  "framework_alignment": ["NIST_CSF_2.0", "NIST_SSDF_1.1", "NIST_AI_RMF_1.0", "NIST_AI_600-1_Generative_AI_Profile"],
  "github_security_evidence": {
    "codeql": "required_when_applicable",
    "dependency_review": "required_when_dependency_change_and_available",
    "secret_scanning": "provider_capability_to_be_monitored_when_enabled",
    "github_blocking": "not_relied_upon_as_sovereign_merge_authority"
  },
  "severity_policy": {
    "critical": "block_and_escalate",
    "high": "block_and_heal_or_escalate",
    "medium": "heal_or_open_bounded_delta_before_promotion",
    "low": "queue_or_fix_with_d1_controls",
    "informational": "record_if_material"
  },
  "self_heal": {
    "mechanical_d1": "may_auto_patch_after_local_validation",
    "bounded_d2": "requires_specialist_independent_verifier_quorum",
    "d3": "human_reserved",
    "post_heal_requirements": ["rerun_original_failing_check", "rerun_institutional_governance", "rerun_security_governance", "independent_agent_verification"]
  },
  "crypto_blockchain_guardrails": {
    "production_token_or_currency_status": "research_target_not_activated",
    "phase_9_dependency": true,
    "requires_before_activation": [
      "legal_classification_by_qualified_counsel",
      "securities_analysis",
      "money_transmission_and_bsa_aml_analysis",
      "sanctions_compliance_design",
      "tax_accounting_design",
      "jurisdiction_by_jurisdiction_review",
      "custody_key_management_threat_model",
      "smart_contract_and_bridge_security_review",
      "consumer_disclosures_and_market_integrity_controls",
      "incident_recovery_and_reversibility"
    ],
    "no_claims": ["legal_currency", "security_status", "non_security_status", "registered_status", "compliance_status", "production_ready"]
  },
  "decision_id": "CT-ADR-GOV-011",
  "source_basis": ["founder_directive_2026-08-18", "S106_repository_enforcement_audit"]
}
