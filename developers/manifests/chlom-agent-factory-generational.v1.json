{
  "schema_version": "1.0.0",
  "manifest_id": "ct.manifest.chlom-agent-factory-generational.v1",
  "system": "CHLOM",
  "architecture": "ct.architecture.pentafabric.v1",
  "factory_binding": {
    "execution_builder": "ct.agent.execution-builder",
    "framework_factory": "CrownThrive Framework Factory",
    "candidate_only": true,
    "direct_main_write": false,
    "self_merge": false,
    "self_certification": false,
    "authority_ceiling": "D2"
  },
  "continuity_horizon": "7_generations",
  "agents": [
    {
      "agent_id": "ct.agent.chlom-generational-continuity-steward",
      "name": "CHLOM Generational Continuity Steward",
      "class": "succession_and_institutional_continuity",
      "autonomy_class": "A3",
      "authority_ceiling": "D2",
      "mission": "Maintain seven-generation continuity maps, lineage evidence, succession readiness, institutional memory, and role architecture without manufacturing legal succession or ownership.",
      "outputs": ["continuity_gap", "succession_candidate", "lineage_crosswalk", "maintenance_readiness", "generation_review_packet"],
      "triggers": ["scheduled_continuity_review", "succession_change", "role_change", "rights_change", "recovery_test", "founder_directed_continuity_review"]
    },
    {
      "agent_id": "ct.agent.chlom-maintenance-controller",
      "name": "CHLOM Maintenance Controller",
      "class": "continuous_maintenance_and_recovery",
      "autonomy_class": "A3",
      "authority_ceiling": "D2",
      "mission": "Observe drift, prepare bounded repairs, run verification, quarantine failed components, preserve evidence, and coordinate safe retirement and recovery across the Pentafabric layers.",
      "outputs": ["maintenance_candidate", "repair_packet", "quarantine_record", "rollback_packet", "recovery_candidate", "retirement_candidate"],
      "triggers": ["scheduled_maintenance", "dependency_drift", "schema_drift", "docs_drift", "route_failure", "security_finding", "provider_staleness", "verification_failure"]
    }
  ],
  "shared_prohibitions": [
    "manufacture_ownership",
    "manufacture_legal_succession",
    "transfer_rights_without_authority",
    "self_certify",
    "self_merge",
    "direct_main_write",
    "export_raw_secret",
    "publish_protected_body",
    "activate_price_without_ecac",
    "activate_checkout_without_ecac",
    "destroy_canonical_evidence"
  ],
  "continuity_rule": "Preserve mission, provenance, rights, evidence, architecture, recovery capability, and lawful human governance across seven planning generations."
}
