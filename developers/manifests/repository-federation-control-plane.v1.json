  "information_flow": {
    "afferent": "repository telemetry -> PentaNerves -> PentaSpine -> PentaBrain",
    "efferent": "PentaBrain disposition -> exact authority -> PentaFactory/PentaPR",
    "lateral": "repository attestation -> PentaFederation -> peer receipt -> PentaSpine"
  },
  "failover": {
    "hot_primary": {
      "mode": "live_provider_readback",
      "ttl_seconds": 3900,
      "required": ["repository_identity", "exact_head", "node_attestation", "build_readback"]
    },
    "cold_recovery": {
      "mode": "read_only_authority_reducing",
      "max_age_seconds": 86400,
      "required": ["content_digest", "external_signature_verification", "exact_head"],
      "provider_writes": false
    },
    "silent_emergency": {
      "mode": "local_hash_chained_restricted_handoff",
      "public_address": "restricted_ref_only",
      "external_broadcast": false,
      "authority_effect": "reduce_only"
    }
  },
  "release_governance": {
    "stable_id": "ct.repo.crownthrive-support",
    "active_default_branch_ruleset_required": true,
    "required_check_contexts": ["CrownThrive governed merge gate"],
    "max_bypass_actor_count": 0,
    "exact_head_success_required": true
  },
  "build_dispatch": {
    "event_type": "crownthrive_penta_build_v1",
    "default": "candidate_only",
    "requires_exact_authority_lease": true,
    "allowed_effects": ["validate", "test", "compile", "package", "preserve-evidence"],
    "prohibited_effects": ["merge", "visibility-change", "delete", "release-publish", "provider-secret-return"]
  },
  "invariants": {
    "private_coordinates_prohibited_in_public_source": true,
    "awareness_never_grants_authority": true,
    "direct_main_write_prohibited": true,
    "child_self_activation_prohibited": true,
    "unknown_or_stale_fails_closed": true,
    "build_dispatch_requires_exact_authority": true,
    "emergency_route_is_authority_reducing": true
  },
  "implementation": {
    "runtime": "penta/repository_fabric",
    "validator": "scripts/validate_repository_federation.py",
    "workflow": ".github/workflows/penta-repository-convergence.yml",
    "tests": "tests/test_penta_repository_fabric.py",
    "node_schema": "schemas/penta/repository-node-attestation.schema.json"
  }
