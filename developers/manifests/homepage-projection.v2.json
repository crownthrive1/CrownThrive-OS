{
  "manifest_version": "2.0.0",
  "manifest_id": "ct.manifest.homepage-projection.v2",
  "classification": "public",
  "target_path": "index.mdx",
  "phase_gate_path": "technology/phase-3-readiness-gate.mdx",
  "policy_path": "standards/documentation-source-of-truth-and-autonomous-governance.mdx",
  "automation": {
    "cadence": "hourly",
    "cron": "17 * * * *",
    "update_semantics": "render_when_governed_projection_state_changes",
    "direct_main_write": false,
    "candidate_branch_pattern": "automation/homepage-{canonical_main_sha}",
    "candidate_diff_invariant": "index.mdx_only",
    "automatic_promotion": "exact_head_documentation_security_and_governed_merge_gates_only",
    "mintlify_public_access_is_merge_blocker": false,
    "custom_domain_is_merge_blocker": false,
    "indexing_is_merge_blocker": false,
    "projection_claims_require_separate_evidence": true,
    "rollback": "pre_merge_main_sha_and_index_content"
  },
  "governance": {
    "source_acceptance": "exact_head_required_gates",
    "projection_availability": "separate_state_dimension",
    "public_deployment_claim": "fail_closed_without_projection_readback",
    "history_rule": "append_version_reconcile_preserve"
  }
}
