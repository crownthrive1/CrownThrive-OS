{
  "schema_version": "1.0",
  "manifest_id": "ct.manifest.credential-vault-ingestion-policy.v1",
  "decision_id": "CT-ADR-GOV-011",
  "phase": "2.99",
  "status": "active_fail_closed",
  "policy": {
    "founder_or_user_supplied_secret": "vault_ingest_before_runtime_use",
    "default_secret_store": "supabase_vault",
    "primary_and_recovery_reference": "required_when_supported_and_operationally_appropriate",
    "raw_secret_repository": "prohibited",
    "raw_secret_documentation": "prohibited",
    "raw_secret_examples": "prohibited",
    "raw_secret_logs_ci_email_screenshots": "prohibited",
    "raw_secret_retransmission_in_chat": "prohibited_after_ingestion",
    "registry_storage": "references_fingerprints_presence_and_continuity_state_only",
    "runtime_consumption": "server_side_vault_reference_only",
    "vault_unavailable_behavior": "fail_closed_and_request_connector_or_secure_binding",
    "rotation_behavior": "update_vault_then_revalidate_fingerprint_runtime_and_recovery",
    "deletion_behavior": "retire_registry_reference_only_after_runtime_dependency_check"
  },
  "controls": [
    "never_commit_or_publish_secret_values",
    "never_log_secret_values_or_authorization_headers",
    "never_store_secret_values_in_integration_control_tables",
    "record_only_sanitized_evidence_and_sha256_fingerprints",
    "require_runtime_readback_or_health_validation_after_binding",
    "keep_provider_writes_closed_until_separately_authorized_and_certified"
  ],
  "source_basis": [
    "founder_directive_2026-08-19",
    "existing_supabase_vault_runtime_pattern",
    "CT-ADR-GOV-011_fail_closed_secret_handling"
  ]
}
