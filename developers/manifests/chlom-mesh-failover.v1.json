{
  "schema_version": "1.0.0",
  "manifest_id": "ct.manifest.chlom-mesh-failover.v1",
  "system": "CHLOM",
  "architecture": "ct.architecture.pentafabric.v1",
  "state": "DOCUMENTED_AND_MONITORED_NOT_INFRASTRUCTURE_FAILOVER_CERTIFIED",
  "observer_agent": "ct.agent.chlom-mesh-reliability",
  "public_routes": [
    {
      "priority": 1,
      "route": "https://crownthrive.com",
      "role": "corporate_commercial_partnership",
      "fallback_to": ["https://crownthrivesupport.com", "https://github.com/crownthrive/chlom-protocol"]
    },
    {
      "priority": 2,
      "route": "https://crownthrivesupport.com",
      "role": "institutional_documentation_support",
      "fallback_to": ["https://github.com/crownthrive/chlom-protocol", "https://github.com/crownthrive1/CrownThrive-OS"]
    },
    {
      "priority": 3,
      "route": "https://crownthrive.io",
      "role": "developer_integration_discovery",
      "fallback_to": ["https://github.com/crownthrive/chlom-protocol", "https://crownthrivesupport.com"]
    },
    {
      "priority": 4,
      "route": "https://github.com/crownthrive/chlom-protocol",
      "role": "public_commercial_chlom_source",
      "fallback_to": ["https://github.com/crownthrive1/CrownThrive-OS", "https://crownthrivesupport.com"]
    },
    {
      "priority": 5,
      "route": "https://github.com/crownthrive1/CrownThrive-OS",
      "role": "canonical_public_safe_governance_parent",
      "fallback_to": ["https://crownthrivesupport.com", "https://crownthrive.com"]
    }
  ],
  "high_consequence_runtime_rules": {
    "api_or_mcp_unreachable": "FAIL_CLOSED",
    "rights_state_inferred_from_cached_provider": false,
    "economic_state_inferred_from_cached_provider": false,
    "provider_outage_may_erase_dail_evidence": false,
    "fallback_route_may_bypass_authentication": false,
    "fallback_route_may_bypass_license": false
  },
  "infrastructure_failover_domains": [
    "dns",
    "cdn_edge",
    "application_runtime",
    "api_mcp_gateway",
    "database_and_ledger",
    "queues_and_schedulers",
    "provider_adapters",
    "archive_and_object_storage",
    "observability_and_incident_routing",
    "human_recovery_path"
  ],
  "certification_boundary": "Fallback URLs and reachability monitoring are not proof that DNS, CDN, database, runtime, provider, or machine-interface failover is deployed. Infrastructure failover requires separate live readback and recovery testing."
}
