  "hard_boundaries": [
    "no specialist vote",
    "no self approval",
    "no unknown to pass",
    "no historical design to current implementation promotion without evidence",
    "no legal tax rights or regulatory sufficiency claims without required authority",
    "no provider credential secret or restricted evidence publication",
    "no money movement rights transfer token issuance or production value-bearing deployment",
    "no phase advancement from research or documentation alone"
