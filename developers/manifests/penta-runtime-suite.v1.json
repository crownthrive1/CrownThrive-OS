{
  "schema": "ct.penta.runtime-suite.manifest.v1",
  "version": "1.2.0",
  "name": "Penta Runtime Suite",
  "not_pentasuite_agent_lab": true,
  "purpose": "Shared executable runtime, family-wide interoperability certification, truth inventory, PentaMail transport, provider certification integration, testing and evidence projection across registered Penta systems.",
  "authority_invariant": "No runtime, interoperability envelope, provider credential, workflow, implementation signal, or test result manufactures authority or child registry maturity.",
  "assets": [
    "runtime/penta_mail.py",
    "runtime/penta_runtime_suite.py",
    "runtime/penta_interop.py",
    "runtime/penta_family.py",
    "runtime/penta_compliance_license.py",
    "runtime/penta_self_build.py",
    "runtime/penta_observability.py",
    "runtime/penta_error.py",
    "runtime/penta_logger.py",
    "runtime/penta_trace.py",
    "runtime/penta_metric.py",
    "tests/test_penta_mail.py",
    "tests/test_penta_runtime_suite.py",
    "tests/test_penta_interop.py",
    "tests/test_penta_compliance_license.py",
    "tests/test_penta_self_build.py",
    "tests/test_penta_observability.py",
    "data/penta/interoperability.registry.json",
    "schemas/penta/interoperability-envelope.schema.json",
    "schemas/penta/compliance-license.schema.json",
    "schemas/penta/self-build-candidate.schema.json",
    ".github/workflows/penta-runtime-suite.yml",
    ".github/workflows/penta-interoperability-production.yml",
    ".github/workflows/penta-mail-live-certification.yml",
    ".github/workflows/penta-observability-production.yml"
  ],
  "integrations": {
    "penta_family": "data/penta/family.registry.json",
    "interoperability_registry": "data/penta/interoperability.registry.json",
    "interoperability_envelope": "schemas/penta/interoperability-envelope.schema.json",
    "provider_control_plane": "runtime/penta-provider-control-plane",
    "compliance_license_control_plane": "data/penta/compliance-license.catalog.json",
    "self_build_contract": "data/penta/self-build.contract.json",
    "pentamail_providers": [
      "resend",
      "mailgun"
    ],
    "observability_spine": [
      "penta.error",
      "penta.logger",
      "penta.trace",
      "penta.metric"
    ],
    "status_origin": "penta.status",
    "docs_contract": "automation/penta-interoperability-fabric.mdx"
  },
  "interoperability": {
    "protocol_version": "1.0.0",
    "all_registered_members_addressable": true,
    "unknown_members_fail_closed": true,
    "child_maturity_independent": true,
    "execute_requires_source_and_target_maturity": [
      "certified",
      "production"
    ],
    "consequential_execute_requires_authority": true,
    "provider_execute_requires_certified_binding_and_readback": true,
    "trace_id_required": true,
    "idempotency_key_required": true,
    "sha256_receipts": true
  },
  "pentamail": {
    "provider_write_operation": "email_send",
    "minimum_authority": "D1",
    "live_certification_requires": [
      "credential_binding",
      "domain_read_live_readback",
      "explicit_authorization",
      "email_send_provider_id",
      "email_send_exact_readback"
    ],
    "idempotency": true,
    "append_only_evidence": true,
    "secret_material_in_logs_or_state": false
  },
  "promotion_rule": "The Penta interoperability fabric is production only when exact-head certification passes. Code merge never auto-promotes a child Penta; child maturity advances only on independent capability evidence and applicable governance."
}
