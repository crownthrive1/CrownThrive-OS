{
  "manifest_version": "1.0.0",
  "policy_id": "ct.policy.highest-known-version-staging.v1",
  "effective_date": "2026-08-20",
  "authority": "founder_directive",
  "scope": [
    "software-backed platforms",
    "engines",
    "services",
    "plugins",
    "applications",
    "framework runtimes",
    "provider software"
  ],
  "rules": {
    "highest_known_version_becomes_target_immediately": true,
    "installed_version_is_independent_fact": true,
    "installed_version_may_be_unverified": true,
    "target_version_must_equal_highest_known_version_when_known": true,
    "unknown_highest_known_version_requires_null_target": true,
    "staging_is_not_installation_or_deployment_proof": true,
    "production_upgrade_requires_preflight": true,
    "newer_authoritative_evidence_advances_target_prospectively": true,
    "historical_installed_and_target_versions_are_preserved": true
  },
  "required_preflight": [
    "version evidence source and observation date",
    "current installed-version verification or explicit unverified state",
    "compatibility and runtime requirements",
    "migrations and customizations",
    "license and support prerequisites",
    "backup checkpoint",
    "staging validation",
    "security and data-impact review",
    "rollback path",
    "documentation and downstream-impact propagation"
  ],
  "authoritative_version_evidence_examples": [
    "current first-party admin update notice",
    "official provider release or download portal",
    "official release notes or current documentation",
    "provider support or purchase/update record",
    "current governed founder-supplied provider evidence"
  ],
  "not_platform_version_evidence_by_itself": [
    "API protocol version",
    "internal adapter version",
    "Edge Function version",
    "database engine version unrelated to the target platform release",
    "historical source-document version",
    "naming similarity or inferred semantic version"
  ],
  "known_targets": [
    {
      "platform_id": "ct.platform.crownpulse",
      "service_ids": ["crownpulse_admin"],
      "installed_version": "unverified",
      "highest_known_version": "v61.0.0",
      "target_version": "v61.0.0",
      "upgrade_status": "staged_pending_preflight",
      "evidence_ref": "S109 + founder-observed current Admin UI update notice"
    },
    {
      "platform_id": "ct.platform.crownrewards",
      "service_ids": ["crownrewards", "reward_loyalty"],
      "installed_version": "v4_family_exact_unverified",
      "highest_known_version": "5.27.0",
      "target_version": "5.27.0",
      "upgrade_status": "staged_pending_preflight",
      "evidence_ref": "THIVEBASE reward_loyalty.vendor_target_version / vendor evidence dated 2026-08-19"
    },
    {
      "platform_id": "ct.platform.thrivetools-opt",
      "service_ids": ["thrivetools_opt"],
      "installed_version": "unverified",
      "highest_known_version": "v4.0.0",
      "target_version": "v4.0.0",
      "upgrade_status": "staged_pending_installed_version_resolution",
      "evidence_ref": "founder-supplied ThriveTools OPT developer interface"
    }
  ],
  "phase_3_promotion": false
}
