{
  "schema": "ct.integration-manifest.v1",
  "manifest_id": "ct.crown-connect.github-oauth.v1",
  "version": "1.0.0",
  "state": "PRODUCTION_CALLBACK_READY",
  "application": {
    "name": "Crown Connect",
    "provider": "GitHub",
    "owner": "crownthrive1",
    "homepage_url": "https://crownthrive.com",
    "client_id": "Ov23li1GfgXaVE01Uo6l",
    "callback_url": "https://tzajnzshmtzjenqulehq.supabase.co/functions/v1/crown-connect-github-oauth",
    "device_flow_enabled": false,
    "requested_scopes": ["read:user", "user:email"]
  },
  "credential_binding": {
    "owner_system": "PentaCredentials",
    "credential_id": "cred.provider.github.crown-connect.oauth-client-secret",
    "raw_secret_in_repository": false,
    "runtime_resolution": "server_side_vault_only"
  },
  "runtime": {
    "edge_function": "crown-connect-github-oauth",
    "start_path": "?action=start",
    "state_storage": "sha256_digest_only",
    "state_ttl_seconds": 300,
    "provider_user_readback_required": true,
    "oauth_token_storage": "vault_only",
    "token_version_history": "append_only",
    "event_history": "append_only_hash_chain"
  },
  "penta_bindings": [
    "PentaCredentials",
    "PentaCertify",
    "PentaOD",
    "PentaHeartbeat",
    "PentaStatus",
    "PentaReports",
    "PentaNotifs",
    "PentaMail",
    "PentaScribe",
    "PentaSerialized",
    "PentaVersion"
  ],
  "invariants": [
    "no_client_secret_in_repository",
    "no_access_or_refresh_token_in_relational_state",
    "raw_oauth_state_not_persisted",
    "provider_identity_readback_required_before_connection_acceptance",
    "oauth_code_state_and_tokens_never_echoed",
    "service_role_only_internal_rpc_execution",
    "device_flow_disabled",
    "least_privilege_user_identity_scopes_only",
    "repository_write_authority_is_not_implied"
  ]
}
