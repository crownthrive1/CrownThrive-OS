    "dimensions": {
      "evidence_quality": 0.3,
      "validation_strength": 0.25,
      "security_posture": 0.25,
      "reversibility": 0.1,
      "authority_fit": 0.1
    },
    "hard_blocks_override_score": true,
    "weighted_votes": false
  },
  "specialist_activation": {
    "security": {
      "required_patterns": ["auth", "secret", "credential", "security", "crypto", "blockchain", "wallet", "key", "production", "dependency", "workflow", "api", "node", "runner", "github-actions"],
      "agent_id": "ct.relay.agent-s",
      "critical_or_high_finding_blocks": true
    },
    "legal_regulatory": {
      "required_patterns": ["license", "rights", "legal", "contract", "token", "cryptocurrency", "securities", "investment", "royalty", "franchise", "privacy", "cross-border", "sanctions", "aml", "kyc"],
      "authority": "advisory_agent_plus_authorized_human_for_d3"
    },
    "operations": {
      "required_patterns": ["deployment", "incident", "provider", "domain", "billing", "fulfillment", "support", "continuity", "recovery", "runner"],
      "authority": "bounded_by_d0_d3"
    },
    "blockchain_protocol": {
      "required_patterns": ["chain", "ledger", "token", "smart_contract", "oracle", "bridge", "wallet", "custody", "consensus"],
      "authority": "research_and_design_only_until_phase_9_entry_and_legal_security_gates"
    },
    "ai_ml_llm": {
      "required_patterns": ["agent", "ai", "ml", "llm", "model", "prompt", "eval", "autonomy"],
      "authority": "bounded_tevv_and_policy_gate"
    }
  },
  "github_main_enforcement_gate": {
    "target_manifest": "developers/manifests/github-main-enforcement-target.v1.json",
    "required_for_phase_3": true,
    "required_status_context": "CrownThrive governed merge gate",
    "pull_request_required": true,
    "strict_update_with_main": true,
    "force_pushes_allowed": false,
    "branch_deletion_allowed": false,
    "provider_bypass": "explicit_d3_break_glass_only",
    "sovereign_authority": false
  },
  "github_actions_runtime_gate": {
    "policy_manifest": "developers/manifests/github-actions-runtime-policy.v1.json",
    "applies_to": "every_merge_and_every_agent_handoff_touching_workflows_or_action_policy",
    "target_runtime": "node24",
    "node20": "prohibited",
    "remote_action_refs": "full_commit_sha_only",
    "dependency_update_source": "dependabot_pull_request",
    "direct_to_main_dependency_repair": false,
    "runtime_escape_hatch": "prohibited"
  },
  "self_healing": {
    "enabled": true,
    "default_mode": "propose_validate_vote_then_apply",
    "automatic_levels": ["D0", "D1"],
    "d2_requires": ["independent_verifier", "applicable_specialist", "quorum", "rollback"],
    "d3_requires": ["authorized_human", "specialist_review", "quorum_advisory_only", "rollback_or_break_glass_plan"],
    "never": [
