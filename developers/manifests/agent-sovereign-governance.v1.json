{
  "manifest_version": "1.0.0",
  "manifest_id": "ct.manifest.agent-sovereign-governance.v1",
  "phase": "2.99",
  "effective_date": "2026-08-18",
  "authority_model": "agent_sovereign_fail_closed",
  "repository_provider_role": "evidence_ci_scan_and_transport_not_sovereign_authority",
  "github_branch_protection_dependency": false,
  "canonical_roadmap_generation": "ten_phase_v1",
  "voter_pool": [
    {"agent_id": "ct.relay.agent-a", "role": "orchestrator_integrator", "vote_eligible": true},
    {"agent_id": "ct.relay.agent-b", "role": "evidence_reconciliation_auditor", "vote_eligible": true},
    {"agent_id": "ct.relay.agent-c", "role": "build_documentation_executor", "vote_eligible": true},
    {"agent_id": "ct.relay.agent-d", "role": "independent_gatekeeper", "vote_eligible": true},
    {"agent_id": "ct.relay.agent-s", "role": "security_resilience_sentinel", "vote_eligible": true}
  ],
  "quorum": {
    "approval_ratio": 0.75,
    "rounding": "ceil",
    "current_eligible_voters": 5,
    "current_minimum_approvals": 4,
    "abstention_counts_as_approval": false,
    "missing_vote_counts_as_approval": false,
    "deny_or_block_vote_prevents_automatic_merge": true,
    "quorum_cannot_override_d3": true
  },
  "merge_policy": {
    "default": "deny",
    "required": [
      "current_main_baseline_reconciled",
      "no_competing_packet_or_collision_resolved",
      "institutional_documentation_validation_passed",
      "security_governance_validation_passed",
      "applicable_github_code_or_dependency_scans_passed_or_documented_not_applicable",
      "no_secret_exposure",
      "authority_class_allows_agent_merge",
      "risk_score_meets_threshold",
      "required_specialist_endorsements_present",
      "quorum_met",
      "independent_gatekeeper_approval_present",
      "rollback_or_recovery_path_present",
      "documentation_impact_completed",
      "downstream_phase_impact_reconciled"
    ],
    "github_required_check": "advisory_defense_in_depth_not_trust_anchor",
    "post_merge_revalidation": true,
    "human_reserved_actions": [
      "legal_terms_or_binding_contract",
      "securities_or_token_issuance_or_public_sale",
      "ip_assignment_or_transfer",
      "rights_grant_or_ownership_change",
      "production_credential_rotation",
      "privileged_access_change",
      "destructive_or_irreversible_production_change",
      "money_movement_or_material_price_payout_change",
      "privacy_or_security_policy_exception",
      "cross_border_regulatory_activation"
    ]
  },
  "risk_rating": {
    "scale": "0_to_100",
    "minimum_automatic_merge_score": 85,
    "dimensions": {
      "evidence_quality": 0.3,
      "validation_strength": 0.25,
      "security_posture": 0.25,
      "reversibility": 0.1,
      "authority_fit": 0.1
    },
    "hard_blocks_override_score": true,
    "weighted_votes": false
  },
  "specialist_activation": {
    "security": {
      "required_patterns": ["auth", "secret", "credential", "security", "crypto", "blockchain", "wallet", "key", "production", "dependency", "workflow", "api"],
      "agent_id": "ct.relay.agent-s",
      "critical_or_high_finding_blocks": true
    },
    "legal_regulatory": {
      "required_patterns": ["license", "rights", "legal", "contract", "token", "cryptocurrency", "securities", "investment", "royalty", "franchise", "privacy", "cross-border", "sanctions", "aml", "kyc"],
      "authority": "advisory_agent_plus_authorized_human_for_d3"
    },
    "operations": {
      "required_patterns": ["deployment", "incident", "provider", "domain", "billing", "fulfillment", "support", "continuity", "recovery"],
      "authority": "bounded_by_d0_d3"
    },
    "blockchain_protocol": {
      "required_patterns": ["chain", "ledger", "token", "smart_contract", "oracle", "bridge", "wallet", "custody", "consensus"],
      "authority": "research_and_design_only_until_phase_9_entry_and_legal_security_gates"
    },
    "ai_ml_llm": {
      "required_patterns": ["agent", "ai", "ml", "llm", "model", "prompt", "eval", "autonomy"],
      "authority": "bounded_tevv_and_policy_gate"
    }
  },
  "self_healing": {
    "enabled": true,
    "default_mode": "propose_validate_vote_then_apply",
    "automatic_levels": ["D0", "D1"],
    "d2_requires": ["independent_verifier", "applicable_specialist", "quorum", "rollback"],
    "d3_requires": ["authorized_human", "specialist_review", "quorum_advisory_only", "rollback_or_break_glass_plan"],
    "never": [
      "weaken_validation_to_make_a_failure_pass",
      "disable_security_scan_to_clear_a_gate",
      "expose_or_reconstruct_secret_material",
      "auto_rotate_production_credentials",
      "self_approve_originating_material_change",
      "reinterpret_missing_evidence_as_permission"
    ]
  },
  "phase_3_effect": "github_branch_protection_not_a_phase_3_dependency; agent_sovereign_controls_and_other_phase_2_99_hard_exit_requirements_remain_binding",
  "decision_id": "CT-ADR-GOV-011",
  "source_basis": ["founder_directive_2026-08-18", "S106_repository_enforcement_audit"]
}
