      "disable_security_scan_to_clear_a_gate",
      "expose_or_reconstruct_secret_material",
      "auto_rotate_production_credentials",
      "self_approve_originating_material_change",
      "reinterpret_missing_evidence_as_permission",
      "force_node24_for_an_unupgraded_action",
      "allow_insecure_node_runtime_escape_hatch",
      "auto_merge_dependency_update_without_governed_validation",
      "treat_provider_branch_protection_as_sovereign_authority"
    ]
  },
  "phase_3_effect": "blocked_until_github_main_required_check_enforcement_is_provider_verified_and_all_other_phase_2_99_hard_exit_requirements_pass",
