{
  "contract_version": "1.0.0",
  "contract_id": "ct.contract.cie.retroactive-scan.v1",
  "state": "D1_PLANNED_READ_ONLY",
  "agent_id": "ct.subagent.cie-interoperability",
  "voting": false,
  "authority_ceiling": "D1",
  "writes_allowed": false,
  "scan_targets": [
    "public_docs",
    "repository_manifests",
    "public_product_metadata",
    "canon_records_with_publication_authority",
    "research_candidate_registries"
  ],
  "excluded_targets": [
    "credentials",
    "private_evidence_bodies",
    "private_eval_corpora",
    "vault_secret_values",
    "private_fingerprints",
    "unlicensed_content_bodies"
  ],
  "findings": [
    "missing_cie_envelope",
    "unknown_rights_state",
    "canon_continuity_unknown",
    "private_evidence_publication_risk",
    "stale_contract_digest",
    "unapproved_commercial_claim"
  ],
  "finding_state": "RESEARCH_CANDIDATE_OR_D1_REMEDIATION_QUEUE",
  "automatic_certification": false,
  "automatic_provider_mutation": false,
  "automatic_publication": false,
  "promotion_gate": "separate_governed_packet_with_independent_verification",
  "rollback": "delete_queue_candidate_or_revert_scan_contract_without_erasing_evidence"
