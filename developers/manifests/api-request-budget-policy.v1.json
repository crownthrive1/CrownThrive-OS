{
  "schema_version": "1.0",
  "manifest_id": "ct.manifest.api-request-budget-policy.v1",
  "phase": "2.99",
  "status": "active",
  "authority": "founder_platform_policy_2026-08-19",
  "default_policy": "unknown_provider_limit_must_not_be_invented",
  "unlimited_api_families": [
    "crownthrive_io",
    "thrivetools_seo",
    "thrivepush",
    "crownpulse",
    "crownlytics",
    "thrivetools",
    "thrivetools_opt"
  ],
  "enforcement": {
    "monthly_hard_ceiling": false,
    "request_counters": "observability_abuse_detection_capacity_and_cost_telemetry_only",
    "fail_closed_on_monthly_count": false,
    "rate_limiting": "may_exist_for_security_fairness_or_provider_health_but_not_as_monthly_quota",
    "writes": "remain_independently_governed_and_fail_closed",
    "provider_documented_limits": "record_if_present_but_do_not_override_founder_owned_unlimited_policy_without_reconciliation"
  },
  "notes": "For named CrownThrive-owned API families, request ledgers are telemetry rather than monthly exhaustion gates. Services not yet registered in integration_control inherit this policy when onboarded."
}
