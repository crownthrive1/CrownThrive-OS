{
  "manifest_version": "1.0.0",
  "manifest_id": "ct.manifest.ip-disclosure-commercialization-policy.v1",
  "phase": "2.99",
  "status": "candidate_governed_policy",
  "governing_issue": 131,
  "pre_publication_gate": {
    "mandatory": true,
    "default_on_uncertainty": "HOLD",
    "triggers": [
      "public_repository_commit",
      "public_mintlify_projection",
      "open_source_distribution",
      "external_partner_distribution",
      "commercial_license_distribution",
      "conference_or_media_disclosure",
      "public_api_sdk_example",
      "external_model_ingestion_of_restricted_material"
    ]
  },
  "classification_classes": {
    "PUBLIC_STANDARD": {
      "default_visibility": "PUBLIC",
      "may_publish": true,
      "requirements": ["rights_checked", "no_restricted_detail", "patent_review_dispositioned_when_triggered"]
    },
    "PUBLIC_DOCTRINE": {
      "default_visibility": "PUBLIC",
      "may_publish": true,
      "requirements": ["rights_checked", "claims_evidence_checked"]
    },
    "COPYRIGHT_LICENSED": {
      "default_visibility": "LICENSED",
      "may_publish": "sanitized_or_license_permits",
      "requirements": ["human_authorship_or_selection_record", "license_terms_defined", "third_party_rights_checked"]
    },
    "TRADE_SECRET_CANDIDATE": {
      "default_visibility": "RESTRICTED",
      "may_publish": false,
      "requirements": ["economic_value_basis", "secrecy_measures_plan", "owner", "access_boundary"]
    },
    "TRADE_SECRET_CONTROLLED": {
      "default_visibility": "RESTRICTED",
      "may_publish": false,
      "requirements": ["need_to_know_access", "confidentiality_controls", "access_logging", "controlled_export", "incident_response"]
    },
    "PATENT_CANDIDATE": {
      "default_visibility": "RESTRICTED",
      "may_publish": false,
      "requirements": ["human_inventive_contribution_record", "prior_art_research_packet", "counsel_or_authorized_filing_disposition"]
    },
    "TRADEMARK_CANDIDATE": {
      "default_visibility": "INTERNAL_OR_PUBLIC_BY_STRATEGY",
      "may_publish": "brand_strategy_dependent",
      "requirements": ["owner", "goods_services_scope", "clearance_or_risk_review"]
    },
    "CERTIFICATION_MARK_CANDIDATE": {
      "default_visibility": "INTERNAL_OR_PUBLIC_BY_STRATEGY",
      "may_publish": "standards_strategy_dependent",
      "requirements": ["certification_standard_owner", "non_self_certification_model", "legal_review_before_registration_claim"]
    },
    "RESTRICTED_INSTITUTIONAL": {
      "default_visibility": "RESTRICTED",
      "may_publish": false,
      "requirements": ["authorized_need_to_know"]
    },
    "THIRD_PARTY_LICENSED": {
      "default_visibility": "LICENSE_DEPENDENT",
      "may_publish": "license_dependent",
      "requirements": ["exact_license", "attribution_notice", "distribution_rights", "modification_obligations"]
    },
    "RIGHTS_REVIEW": {
      "default_visibility": "HOLD",
      "may_publish": false,
      "requirements": ["rights_disposition"]
    }
  },
  "projection_layers": {
    "public_specification": "Explains what the system does using public-safe doctrine, interfaces and standards.",
    "licensed_implementation": "Explains how an authorized licensee deploys approved capabilities without receiving CrownThrive sovereign authority.",
    "restricted_institutional_implementation": "Contains CrownThrive-specific configuration, authority mappings and restricted operational detail.",
    "trade_secret_kernel": "Contains high-value confidential policy, economic, evaluation, orchestration, security or implementation know-how that is not generally distributed."
  },
  "prohibited_public_content": [
    "production_credentials_or_fingerprints",
    "private_policy_bundles",
    "private_economic_calibration",
    "internal_security_findings",
    "proprietary_adversarial_or_eval_corpora",
    "private_dail_or_evidence_bodies",
    "customer_partner_or_personal_records",
    "internal_break_glass_details",
    "unpublished_patent_candidate_mechanisms_before_disposition",
    "trade_secret_controlled_implementation_details"
  ],
  "ai_assisted_ip": {
    "human_contribution_record_required_when_material": true,
    "ai_provider_provenance_required_when_material": true,
    "ai_output_alone_proves_copyright_ownership": false,
    "ai_output_alone_proves_inventorship": false
  },
  "commercialization_state_model": [
    "concept",
    "candidate",
    "packaged",
    "rights_cleared",
    "pricing_authorized",
    "fulfillment_certified",
    "checkout_staged",
    "live"
  ],
  "live_sale_requirements": [
    "rights_cleared",
    "package_license_adopted",
    "exact_price_authorized",
    "tax_accounting_review_as_applicable",
    "fulfillment_certified",
    "support_refund_dispute_terms_ready",
    "checkout_and_entitlement_certified",
    "ip_disclosure_gate_passed"
  ],
  "agent_enforcement": {
    "agent_a": "route_ip_classification_and_commercialization_dependencies",
    "agent_b": "audit_source_rights_and_classification_evidence",
    "agent_c": "build_only_from_approved_public_or_licensed_projection",
    "agent_d": "block_publication_or_live_sale_when_gate_incomplete",
    "agent_s": "block_secret_security_or_sensitive_implementation_leakage",
    "agent_f": "classify_public_documentation_before_articleization_or_publication",
    "agent_n": "verify_that_classification_evidence_supports_the_disposition",
    "rnd_fabric": "default_new_high_value_mechanisms_to_research_and_ip_review_before_public_promotion"
  },
  "phase_3_entry_effect": "does_not_open_phase_3",
  "stripe": {
    "product_creation_authorized_by_manifest": false,
    "price_creation_authorized_by_manifest": false,
    "checkout_enabled": false
  }
}
