{
  "schema_version": "1.0",
  "manifest_id": "ct.manifest.chlom-upstream-components.v1",
  "state": "evaluating_not_production_adopted",
  "policy": {
    "prefer_adapter_over_vendor_lock_in": true,
    "preserve_upstream_license_and_notice": true,
    "pin_release_or_commit_before_use": true,
    "security_review_before_runtime_adoption": true,
    "sbom_required_on_adoption": true,
    "contribute_generic_fixes_upstream_when_practical": true,
    "fork_only_when_needed_for_governed_divergence": true,
    "fork_does_not_transfer_upstream_trademark_or_authority": true,
    "no_copy_without_license_verification": true
  },
  "candidates": [
    {
      "component_id": "ct.upstream.opa",
      "repository": "open-policy-agent/opa",
      "role": "policy_decision_engine_candidate",
      "license": "Apache-2.0",
      "license_evidence": "GitHub LICENSE verified 2026-08-19",
      "adoption_state": "adapter_candidate",
      "chlom_authority": false,
      "notes": "Candidate execution engine for compiled CrownThrive policy bundles; CHLOM policy IDs, applicability, approvals and DAIL remain CrownThrive authority."
    },
    {
      "component_id": "ct.upstream.openfga",
      "repository": "openfga/openfga",
      "role": "relationship_authorization_candidate",
      "license": "Apache-2.0",
      "license_evidence": "GitHub LICENSE verified 2026-08-19",
      "adoption_state": "adapter_candidate",
      "chlom_authority": false,
      "notes": "Candidate relationship/tuple authorization service behind CrownThrive actor, organization, role and delegation contracts."
    },
    {
      "component_id": "ct.upstream.cedar",
      "repository": "cedar-policy/cedar",
      "role": "formal_policy_language_candidate",
      "license": "Apache-2.0",
      "license_evidence": "GitHub LICENSE verified 2026-08-19",
      "adoption_state": "compatibility_lab_candidate",
      "chlom_authority": false,
      "notes": "Evaluate as a formal policy-language/backend alternative; do not operate two contradictory policy authorities."
    },
    {
      "component_id": "ct.upstream.temporal",
      "repository": "temporalio/temporal",
      "role": "durable_workflow_candidate",
      "license": "MIT",
      "license_evidence": "GitHub LICENSE verified 2026-08-19",
      "adoption_state": "adapter_candidate",
      "chlom_authority": false,
      "notes": "Candidate durable scheduler/orchestration backend for approvals, holds, retries and remedies after operational/cost/security evaluation."
    }
  ],
  "adoption_gate": [
    "validated_need",
    "exact_version_or_commit",
    "license_and_notice_review",
    "security_and_supply_chain_review",
    "data_and_privacy_review",
    "operational_exit_plan",
    "contract_compatibility_tests",
    "docs_impact",
    "governed_quorum_if_D2",
    "human_or_professional_authority_if_D3"
  ]
}
