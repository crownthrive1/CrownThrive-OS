{
  "manifest_version": "2.0.0",
  "manifest_id": "ct.manifest.agent-sovereign-governance.v2",
  "decision_id": "CT-ADR-GOV-012",
  "supersedes_on_acceptance": "CT-ADR-GOV-011",
  "effective_only_after_governed_merge": true,
  "base_manifest": "developers/manifests/agent-sovereign-governance.v1.json",
  "founder_authorization": "founder_directive_2026-08-20_cie_framework_agent_and_permanent_framework_voter_expansion",
  "voter_pool_additions": [
    {
      "agent_id": "ct.framework-agent.cie",
      "role": "cultural_imprint_sovereign_framework_agent",
      "vote_eligible": true,
      "permanent": true,
      "operational_parent": "ct.relay.agent-a",
      "vote_independence_required": true
    }
  ],
  "quorum": {
    "approval_ratio": 0.75,
    "rounding": "ceil",
    "current_eligible_voters": 6,
    "current_minimum_approvals": 5,
    "mandatory_gatekeeper": "ct.relay.agent-d",
    "deny_or_block_vote_prevents_automatic_merge": true,
    "abstention_counts_as_approval": false,
    "missing_vote_counts_as_approval": false,
    "quorum_cannot_override_d3": true
  },
  "foundational_framework_voter_policy": {
    "enabled": true,
    "new_framework_agent_requires_explicit_founder_authorization": true,
    "new_framework_agent_requires_machine_contract": true,
    "new_framework_agent_requires_independent_eval_suite": true,
    "new_framework_agent_requires_parent_assignment": true,
    "new_framework_agent_becomes_permanent_voter_only_after_governed_acceptance": true,
    "framework_subagents_are_non_voting": true,
    "approval_ratio_remains_75_percent_ceil": true,
    "agent_d_remains_mandatory": true,
    "d3_remains_human_reserved": true,
    "one_framework_agent_one_vote": true,
    "vote_multiplication_by_subagent_prohibited": true
  },
  "cie_integration": {
    "framework_manifest": "developers/manifests/cie-framework-agent.v1.json",
    "changed_domain_token": "cultural_imprint",
    "mandatory_review_patterns": [
      "culture", "cultural", "canon", "narrative", "representation", "identity", "imprint",
      "community", "legacy", "attribution", "cross-imprint", "likeness", "voice", "heritage"
    ],
    "hard_block_must_prevent_merge": true,
    "cie_vote_does_not_replace_rights_legal_security_or_human_review": true
  }
}
