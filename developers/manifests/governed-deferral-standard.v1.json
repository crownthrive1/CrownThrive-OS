{
  "schema_version": "1.0.0",
  "contract_id": "ct.governance.governed-deferral-standard.v1",
  "issue": 107,
  "purpose": "Define a finite, evidence-backed, fail-closed lifecycle for unresolved external or otherwise bounded conditions without converting a deferral into PASS or mutating the underlying gate.",
  "required_fields": [
    "deferral_id",
    "scope_type",
    "scope_key",
    "title",
    "status",
    "risk_class",
    "external_dependency",
    "unresolved_condition",
    "accountable_owner",
    "compensating_controls",
    "evidence_refs",
    "reopening_trigger",
    "review_due_at",
    "approved_by",
    "approved_at"
  ],
  "risk_classes": ["D0", "D1", "D2", "D3"],
  "status_lifecycle": ["candidate", "approved", "resolved", "expired", "revoked"],
  "forbidden_statuses": ["pass", "passed", "certified", "complete"],
  "rules": {
    "approval_never_means_pass": true,
    "underlying_gate_state_must_not_be_mutated_by_deferral": true,
    "unknown_evidence_must_remain_unknown": true,
    "reopening_trigger_required": true,
    "compensating_controls_required": true,
    "evidence_refs_required": true,
    "accountable_owner_required": true,
    "review_due_required_while_candidate_or_approved": true,
    "expiry_required_unless_explicit_exception": true,
    "expiry_exception_requires_reason": true,
    "resolved_requires_resolved_at": true,
    "expired_or_revoked_cannot_be_treated_as_active": true,
    "d3_remains_human_reserved": true
  },
  "projection_contract": {
    "machine_authority": "integration_control.governed_deferrals",
    "github_issue": 104,
    "github_projection_is_secondary": true,
    "stale_projection_must_be_reconciled_to_machine_state": true
  }
}
