{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "ct.api.mcp.control.v4",
  "contract_version": "4.0.0",
  "protocol_version": "2026-07-28",
  "status": "active_private_runtime_pending_external_conformance",
  "upgrade_mode": "additive_no_delete",
  "compatibility": {
    "preserved_server_contracts": [
      "3.0.0"
    ],
    "removed_contracts": [],
    "removed_tools": [],
    "existing_enabled_tools_changed": false
  },
  "transport": {
    "json_rpc": "2.0",
    "methods": [
      "server/discover",
      "tools/list",
      "tools/call"
    ],
    "request_body_limit_bytes": 256000,
    "provider_timeout_ms": 20000,
    "provider_response_limit": "bounded_per_provider_profile",
    "cache_scope": "private",
    "schema_validation": {
      "input": "fail_closed",
      "output": "fail_closed"
    }
  },
  "catalog": {
    "new_v4_control_contracts": [
      "health",
      "catalog",
      "conformance"
    ],
    "new_contract_activation": "registered_disabled_until_exact_conformance_and_governance",
    "mutation_tools_enabled": false
  },
  "authority": {
    "sovereign_vote_authority": false,
    "sync_agents_vote_authority": false,
    "child_certification_authority": false,
    "d3_authority": "human_reserved",
    "provider_writes_enabled": false,
    "commercial_customer_write_access": false
  },
  "public_private_projection": {
    "public": [
      "interface names",
      "version identifiers",
      "bounded transport behavior",
      "compatibility and activation state"
    ],
    "private": [
      "credentials and fingerprints",
      "runtime locators",
      "repo-agent authority mappings",
      "private policy hooks",
      "optimized adapters",
      "protected algorithms and calibration",
      "restricted tests and evidence"
    ]
  },
  "acceptance_gates": [
    "external client conformance",
    "exact-artifact security and privacy review",
    "exact-artifact IP and rights disposition",
    "governed release review"
  ]
}
