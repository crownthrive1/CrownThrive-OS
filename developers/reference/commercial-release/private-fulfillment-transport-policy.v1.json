{
  "schema_version": "1.0.0",
  "effective_date": "2026-08-22",
  "policy_id": "ct.policy.commercial-private-fulfillment-transport.v1",
  "applies_to": [
    "ct.platform.crownthrive-launch",
    "ct.platform.crownthrive-ready",
    "ct.platform.crownthrive-procure"
  ],
  "purpose": "Fail-closed exact-byte transport from restricted recovery custody to private fulfillment storage without making source masters public or expanding commerce authority.",
  "authority": {
    "maximum_execution": "D2",
    "may_activate_checkout": false,
    "may_move_money": false,
    "may_create_live_entitlement": false,
    "may_grant_rights": false,
    "may_publish_product_bytes": false,
    "may_weaken_recovery_asset_sharing": false,
    "provider_success_is_evidence_only": true
  },
  "source_master_controls": {
    "owner_private_required": true,
    "public_link_for_plaintext_prohibited": true,
    "exact_candidate_version_required": true,
    "registry_sha256_and_byte_size_match_required": true,
    "rebuild_or_mutation_during_transport_prohibited": true
  },
  "transport_controls": {
    "fresh_transport_id_required": true,
    "fresh_or_freshly_wrapped_ephemeral_payload_key_required": true,
    "transport_expiry_required": true,
    "expired_transport_execution_prohibited": true,
    "oidc_exact_repository_and_ref_binding_required": true,
    "plaintext_in_git_prohibited": true,
    "plaintext_in_public_drive_prohibited": true,
    "signed_download_url_persistence_prohibited": true,
    "accepted_payload_modes": [
      "file_native_authenticated_service_to_service",
      "encrypted_ciphertext_with_authenticated_receiver",
      "max_19999_character_contiguous_hash_bound_ciphertext_chunks"
    ],
    "repository_text_chunk_max_characters": 19999,
    "per_chunk_readback_required": true,
    "per_chunk_sha256_required": true,
    "per_chunk_character_count_required": true,
    "chunk_sequence_contiguous_required": true,
    "concatenated_ciphertext_sha256_required": true,
    "concatenated_ciphertext_byte_size_required": true,
    "aad_sha256_required": true,
    "authenticated_decryption_required": true,
    "decrypted_bundle_sha256_required": true
  },
  "private_storage_canary": {
    "private_bucket_required": true,
    "single_use_exact_content_grant_required": true,
    "temporary_write_readback_required": true,
    "temporary_delete_absence_proof_required": true,
    "exact_reapply_readback_required": true,
    "second_delete_absence_proof_required": true,
    "canonical_private_write_required": true,
    "canonical_signed_readback_required": true,
    "canonical_sha256_and_byte_size_match_required": true,
    "signed_url_persisted": false,
    "independent_review_after_technical_canary_required": true
  },
  "failure_behavior": {
    "any_length_or_hash_mismatch": "HOLD",
    "writer_truncation_detected": "ABANDON_TRANSPORT_AND_ROTATE",
    "working_buffer_or_variable_drift_detected": "ABANDON_TRANSPORT_AND_ROTATE",
    "expired_transport": "DENY_EXECUTION",
    "source_master_public_exposure_required_to_proceed": "DENY_AND_USE_ANOTHER_TRANSPORT",
    "receiver_or_storage_uncertainty": "HOLD",
    "partial_write": "ROLLBACK_OR_QUARANTINE_AND_REQUIRE_READBACK",
    "salvage_of_unproven_chunks": false
  },
  "institutionalization": {
    "machine_readable": true,
    "release_factory_binding": "ct.agent-suite.commercial-release-factory.v1",
    "thivebase_target_gate": "private_fulfillment",
    "chlom_evidence_role": "technical transport and custody evidence only",
    "vault_scope": "transport algorithms and restricted implementation details remain vaulted/private; public contract contains no secret material",
    "drift_reconciliation_required": true,
    "future_agents_must_apply_this_policy_before_transport": true
  },
  "negative_controls": [
    "reject_public_plaintext_master",
    "reject_chunk_over_19999_characters_on_repository_contents_writer",
    "reject_chunk_hash_mismatch",
    "reject_noncontiguous_chunk_sequence",
    "reject_concatenated_ciphertext_hash_mismatch",
    "reject_expired_transport",
    "reject_self-certified_private_fulfillment",
    "reject_checkout_or_entitlement_side_effect"
  ]
}
