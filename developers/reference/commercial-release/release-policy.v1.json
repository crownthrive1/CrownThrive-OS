{
  "automatic_publication": {
    "cash_checkout": false,
    "direct_main_write": false,
    "eligible_only_after_acceptance": true,
    "human_reserved": [
      "legal conclusion",
      "tax conclusion",
      "final rights grant",
      "contract signature",
      "money movement",
      "credential recovery",
      "D3/A4 action"
    ],
    "provider_write_default": false,
    "self_merge": false,
    "stripe_object_creation": false
  },
  "decision_rule": "all required gates must be independently accepted on the exact package digest; any BLOCK or stale required evidence holds publication",
  "effective_date": "2026-08-22",
  "gates": [
    {"code":"G01_EDITORIAL","human_required":false,"label":"Editorial and product completeness","reviewer_class":"editorial"},
    {"code":"G02_DESIGN","human_required":false,"label":"Design and usable asset quality","reviewer_class":"design"},
    {"code":"G03_ACCESSIBILITY","human_required":true,"label":"Accessibility review","reviewer_class":"accessibility_specialist"},
    {"code":"G04_EXECUTABLE","human_required":false,"label":"Executable and formula checks where applicable","reviewer_class":"technical"},
    {"code":"G05_RIGHTS","human_required":true,"label":"Rights and chain of title","reviewer_class":"rights_specialist"},
    {"code":"G06_TAX","human_required":true,"label":"Tax profile and jurisdiction decision","reviewer_class":"tax_specialist"},
    {"code":"G07_LICENSING","human_required":true,"label":"Customer license, assent, and rights grant","reviewer_class":"licensing_specialist"},
    {"code":"G08_SECURITY","human_required":false,"label":"Security and privacy","reviewer_class":"security"},
    {"code":"G09_PRICING","human_required":false,"label":"Comparable-backed credit price","reviewer_class":"price_certifier"},
    {"code":"G10_REPRODUCIBILITY","human_required":false,"label":"Deterministic package reproduction","reviewer_class":"integrity"},
    {"code":"G11_MALWARE","human_required":false,"label":"Malware and dangerous-content scan","reviewer_class":"security"},
    {"code":"G12_FULFILLMENT","human_required":false,"label":"Protected fulfillment and rollback canary","reviewer_class":"delivery"},
    {"code":"G13_SUPPORT","human_required":false,"label":"Support boundary and correction path","reviewer_class":"operations"},
    {"code":"G14_CREDIT_CHECKOUT","human_required":false,"label":"Credit-only checkout and atomic redemption","reviewer_class":"commerce"},
    {"code":"G15_WEBHOOK_IDEMPOTENCY","human_required":false,"label":"Webhook signature, replay, and ordering controls","reviewer_class":"webhook_delivery"},
    {"code":"G16_ENTITLEMENT_REMEDY","human_required":false,"label":"Entitlement, license, refund, dispute, and reversal","reviewer_class":"rights_delivery"},
    {"code":"G17_DNS_TLS","human_required":false,"label":"DNS authority, TLS, HTTPS, and canonical route","reviewer_class":"domain_delivery"},
    {"code":"G18_SITE_PUBLICATION","human_required":false,"label":"ChatGPT Sites publish, readback, rollback, and reapply","reviewer_class":"sites_delivery"},
    {"code":"G19_CREDENTIAL_CUSTODY","human_required":false,"label":"Vault-brokered provider credentials and recovery aliases","reviewer_class":"secret_custodian"},
    {"code":"G20_GOVERNED_ACCEPTANCE","human_required":false,"label":"Exact-digest governance and specialist acceptance","reviewer_class":"governance"}
  ],
  "inherits": ["ct-release-policy-v2","ct-pricing-v2"],
  "policy_version": "ct-commercial-sites-v1",
  "schema_version": "1.0.0",
  "sovereign_rule": {
    "agent_d_required": true,
    "any_block_holds": true,
    "minimum_approvals": 4,
    "voters": ["A","B","C","D","S"]
  }
}
