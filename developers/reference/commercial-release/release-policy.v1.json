{
  "automatic_publication": {
    "cash_checkout": false,
    "direct_main_write": false,
    "eligible_only_after_acceptance": true,
    "human_reserved": [
      "legal conclusion",
      "tax conclusion",
      "final rights grant",
      "contract signature",
      "money movement",
      "credential recovery",
      "D3/A4 action"
    ],
    "provider_write_default": false,
    "self_merge": false,
    "stripe_object_creation": false
  },
  "decision_rule": "all applicable canonical dimensions must be independently accepted on the exact package digest; any BLOCK or stale required evidence holds publication",
  "effective_date": "2026-08-22",
  "gates": [
    {"code":"package_integrity","human_required":false,"label":"Package integrity, editorial, design, executable, malware and support boundary","reviewer_class":"integrity"},
    {"code":"rights_provenance","human_required":true,"label":"Rights provenance and chain of title","reviewer_class":"rights_specialist"},
    {"code":"rights_licensing","human_required":true,"label":"Customer license, assent and final rights boundary","reviewer_class":"licensing_specialist"},
    {"code":"pricing_tax","human_required":true,"label":"Comparable-backed credit price and jurisdiction tax decision","reviewer_class":"pricing_tax_specialist"},
    {"code":"fulfillment","human_required":false,"label":"Fulfillment package and delivery canary","reviewer_class":"delivery"},
    {"code":"private_fulfillment","human_required":false,"label":"Protected private fulfillment custody and rollback","reviewer_class":"delivery_security"},
    {"code":"checkout_webhook","human_required":false,"label":"Checkout and signed webhook controls","reviewer_class":"webhook_delivery"},
    {"code":"credit_checkout_webhook","human_required":false,"label":"Credit-only atomic redemption, replay and ordering controls","reviewer_class":"credit_commerce"},
    {"code":"entitlement","human_required":false,"label":"Entitlement issuance and delivery chain","reviewer_class":"entitlement"},
    {"code":"entitlement_license","human_required":true,"label":"License acceptance, entitlement, revocation and rights separation","reviewer_class":"rights_delivery"},
    {"code":"accessibility","human_required":true,"label":"Accessibility review","reviewer_class":"accessibility_specialist"},
    {"code":"accessibility_device","human_required":true,"label":"Mobile, keyboard and assistive-technology evidence","reviewer_class":"accessibility_specialist"},
    {"code":"dns_tls","human_required":false,"label":"DNS authority and TLS evidence","reviewer_class":"domain_delivery"},
    {"code":"dns_tls_route","human_required":false,"label":"HTTPS, canonical route and redirect readback","reviewer_class":"domain_delivery"},
    {"code":"destination_readiness","human_required":false,"label":"ChatGPT Sites feed consumer, publish, readback, rollback and reapply","reviewer_class":"sites_delivery"},
    {"code":"refund_dispute_rollback","human_required":false,"label":"Refund, dispute, reversal and rollback controls","reviewer_class":"remedy_rollback"},
    {"code":"governed_acceptance_publication","human_required":false,"label":"Exact-digest governed acceptance and publication authority","reviewer_class":"governance"},
    {"applies_to":["ready"],"code":"qualified_professional_review","human_required":true,"label":"Qualified professional scope review without delegated conclusion","reviewer_class":"human_specialist"}
  ],
  "inherits": ["ct-release-policy-v2","ct-pricing-v2","ct.site.autopublish.v1"],
  "policy_version": "ct-commercial-sites-v1",
  "schema_version": "1.1.0",
  "sovereign_rule": {
    "agent_d_required": true,
    "any_block_holds": true,
    "minimum_approvals": 4,
    "voters": ["A","B","C","D","S"]
  }
}
