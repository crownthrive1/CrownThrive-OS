{
  "automatic_publication": {
    "cash_checkout": false,
    "direct_main_write": false,
    "eligible_only_after_acceptance": true,
    "human_reserved": [
      "legal conclusion",
      "tax conclusion",
      "final rights grant",
      "contract signature",
      "money movement",
      "credential recovery",
      "D3/A4 action"
    ],
    "provider_write_default": false,
    "self_merge": false,
    "stripe_object_creation": false
  },
  "decision_rule": "all applicable canonical dimensions must be independently accepted on the exact package digest; any BLOCK or stale required evidence holds publication",
  "effective_date": "2026-08-22",
  "gates": [
    {"code":"package_integrity","human_required":false,"label":"Exact asset, deterministic package, editorial, design, executable, malware and support-boundary integrity","legacy_aliases":[],"reviewer_class":"integrity"},
    {"code":"rights_provenance","human_required":true,"label":"Rights provenance, chain of title, customer-license and assent boundary","legacy_aliases":["rights_licensing"],"reviewer_class":"rights_licensing_specialist"},
    {"code":"pricing_tax","human_required":true,"label":"Comparable-backed Crown Credits price and jurisdiction tax decision","legacy_aliases":[],"reviewer_class":"pricing_tax_specialist"},
    {"code":"private_fulfillment","human_required":false,"label":"Protected private fulfillment, exact-byte delivery, rollback and reapply","legacy_aliases":["fulfillment"],"reviewer_class":"delivery_security"},
    {"code":"credit_checkout_webhook","human_required":false,"label":"Credit-only atomic redemption, signed webhook, replay and ordering controls","legacy_aliases":["checkout_webhook"],"reviewer_class":"credit_commerce"},
    {"code":"entitlement_license","human_required":true,"label":"License acceptance, entitlement, delivery, revocation and rights separation","legacy_aliases":["entitlement"],"reviewer_class":"rights_delivery"},
    {"code":"refund_dispute_rollback","human_required":false,"label":"Refund, dispute, reversal and rollback controls","legacy_aliases":[],"reviewer_class":"remedy_rollback"},
    {"code":"accessibility_device","human_required":true,"label":"Accessibility, exact device widths, keyboard and assistive-technology evidence","legacy_aliases":["accessibility"],"reviewer_class":"accessibility_specialist"},
    {"code":"dns_tls_route","human_required":false,"label":"DNS authority, TLS, HTTPS, canonical route and application readback","legacy_aliases":["dns_tls"],"reviewer_class":"domain_delivery"},
    {"code":"governed_acceptance_publication","human_required":false,"label":"Exact-digest governance, ChatGPT Sites feed consumer, publish/readback/rollback/reapply and publication authority","legacy_aliases":["destination_readiness"],"reviewer_class":"governance_sites_delivery"},
    {"applies_to":["ready"],"code":"qualified_professional_review","human_required":true,"label":"Qualified professional scope review without delegated professional conclusion","legacy_aliases":[],"reviewer_class":"human_specialist"}
  ],
  "gate_topology": {
    "all_product_canonical_dimensions": 10,
    "legacy_alias_count": 7,
    "ready_only_dimensions": 1,
    "ready_required_dimension_count": 11,
    "standard_product_required_dimension_count": 10
  },
  "inherits": ["ct-release-policy-v2", "ct-pricing-v2", "ct.site.autopublish.v1"],
  "policy_version": "ct-commercial-sites-v1",
  "schema_version": "1.2.1",
  "sovereign_rule": {
    "agent_d_required": true,
    "any_block_holds": true,
    "minimum_approvals": 4,
    "voters": ["A", "B", "C", "D", "S"]
  }
}
