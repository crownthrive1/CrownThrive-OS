{
  "rulepack_id": "ct.rulepack.chlom-wallet.policy-assurance.v1",
  "semantic_version": "1.0.0",
  "state": "CONTROLLED_TEST",
  "allowed_actions": [
    "allocation_preview",
    "entitlement_evaluate",
    "passkey_assertion",
    "passkey_recovery",
    "passkey_registration",
    "pricing_candidate",
    "proof_anchor_prepare",
    "provider_event_translate",
    "provider_exit",
    "smart_account_intent",
    "thrivefund_obligation",
    "wallet_public_projection"
  ],
  "allowed_value_classes": ["identity", "impact", "money", "proof", "rewards", "rights", "unknown"],
  "allowed_environments": ["controlled_test", "testnet"],
  "authority_ceiling": {"autonomy": "A2", "decision": "D2"},
  "risk_thresholds": {"low_max": 24, "medium_max": 49, "high_max": 74},
  "rules": [
    {"rule_id":"ct.rule.wallet.authority.ceiling.v1","effect":"DENY","reason_code":"AUTHORITY_CEILING_EXCEEDED","weight":100,"description":"Authority may not exceed the compiled A2/D2 ceiling."},
    {"rule_id":"ct.rule.wallet.authority.self-approval.v1","effect":"DENY","reason_code":"ORIGINATOR_SELF_APPROVAL_FORBIDDEN","weight":100,"description":"An originating agent cannot approve its own material wallet decision."},
    {"rule_id":"ct.rule.wallet.chain.codehash.v1","effect":"DENY","reason_code":"ENTRYPOINT_RUNTIME_CODEHASH_MISMATCH","weight":100,"description":"A mismatched EntryPoint runtime codehash fails closed."},
    {"rule_id":"ct.rule.wallet.evidence.freshness.v1","effect":"HOLD","reason_code":"REQUIRED_EVIDENCE_STALE","weight":30,"description":"Required stale evidence cannot produce ECAC."},
    {"rule_id":"ct.rule.wallet.impact.settlement.v1","effect":"DENY","reason_code":"IMPACT_SETTLEMENT_REQUIRES_EXTERNAL_EVIDENCE","weight":100,"description":"Impact obligations are not disbursements without external settlement evidence."},
    {"rule_id":"ct.rule.wallet.passkey.private-material.v1","effect":"DENY","reason_code":"PASSKEY_PRIVATE_KEY_MATERIAL_FORBIDDEN","weight":100,"description":"Private key material is prohibited from governed passkey evidence."},
    {"rule_id":"ct.rule.wallet.provider.live-mode.v1","effect":"DENY","reason_code":"LIVE_PROVIDER_EVENT_IN_CONTROLLED_TEST","weight":100,"description":"Controlled tests reject live provider events."},
    {"rule_id":"ct.rule.wallet.rewards.cash-equivalence.v1","effect":"DENY","reason_code":"REWARD_CASH_EQUIVALENCE_NOT_AUTHORIZED","weight":90,"description":"Rewards cannot be represented as cash without explicit authority."},
    {"rule_id":"ct.rule.wallet.rights.payment-only.v1","effect":"DENY","reason_code":"PAYMENT_ONLY_ENTITLEMENT_FORBIDDEN","weight":100,"description":"Payment evidence cannot independently create rights."},
    {"rule_id":"ct.rule.wallet.rollback.required.v1","effect":"HOLD","reason_code":"ROLLBACK_PLAN_MISSING","weight":20,"description":"Material wallet actions require a rollback or compensation plan."},
    {"rule_id":"ct.rule.wallet.secret-fields.v1","effect":"DENY","reason_code":"FORBIDDEN_SECRET_BEARING_FIELD","weight":100,"description":"Secret-bearing fields are rejected from public-safe policy inputs."},
    {"rule_id":"ct.rule.wallet.unknown-action.v1","effect":"HOLD","reason_code":"ACTION_TYPE_NOT_IN_COMPILED_RULEPACK","weight":35,"description":"Unknown actions require explicit rulepack versioning."}
  ],
  "required_evidence": {
    "provider_event_translate": ["provider_signature_verified", "replay_state_verified", "provider_event_allowlisted"],
    "entitlement_evaluate": ["rights_evidence_present", "terms_version_exact"],
    "allocation_preview": ["economic_schedule_exact", "allocation_conservation_verified"],
    "thrivefund_obligation": ["impact_policy_exact", "obligation_evidence_present"],
    "proof_anchor_prepare": ["evidence_digest_present", "protected_evidence_offchain"],
    "passkey_registration": ["challenge_bound", "origin_bound", "rp_id_bound", "public_key_only"],
    "passkey_assertion": ["challenge_bound", "origin_bound", "rp_id_bound", "signature_verified", "counter_policy_satisfied"],
    "passkey_recovery": ["identity_review_complete", "cooldown_complete", "recovery_evidence_present"],
    "smart_account_intent": ["entrypoint_source_pinned", "chain_codehash_observed", "unsigned_intent_exact"],
    "provider_exit": ["stable_identity_preserved", "event_replay_preserved", "rollback_plan_present"],
    "wallet_public_projection": ["public_projection_reviewed", "private_evidence_hidden", "semantic_lanes_separate"],
    "pricing_candidate": ["candidate_snapshot_frozen", "independent_price_review_requested"]
  },
  "required_handoffs": {
    "provider_event_translate": ["ct.agent.qa-security", "ct.agent.webhook-delivery"],
    "entitlement_evaluate": ["ct.agent.rights-governance", "ct.subagent.legal-regulatory"],
    "allocation_preview": ["ct.subagent.finance-tax-treasury"],
    "thrivefund_obligation": ["ct.agent.impact-allocation", "ct.subagent.finance-tax-treasury"],
    "proof_anchor_prepare": ["ct.agent.qa-security", "ct.subagent.blockchain-protocol"],
    "passkey_registration": ["ct.agent.qa-security", "ct.subagent.verification-tevv"],
    "passkey_assertion": ["ct.agent.qa-security", "ct.subagent.verification-tevv"],
    "passkey_recovery": ["ct.agent.qa-security", "ct.subagent.recovery-rollback"],
    "smart_account_intent": ["ct.agent.phase-gate", "ct.agent.qa-security", "ct.subagent.blockchain-protocol"],
    "provider_exit": ["ct.agent.evidence-auditor", "ct.subagent.operations-sre"],
    "wallet_public_projection": ["ct.agent.rights-governance", "ct.subagent.accessibility-consumer"],
    "pricing_candidate": ["ct.agent.phase-gate", "ct.subagent.finance-tax-treasury"]
  }
}
