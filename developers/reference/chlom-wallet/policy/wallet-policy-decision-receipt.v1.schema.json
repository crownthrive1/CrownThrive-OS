{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crownthrive.com/chlom/wallet-policy-decision-receipt.v1.schema.json",
  "title": "CHLOM Wallet Policy Decision Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "policy_id", "policy_version", "compiled_digest_sha256", "input_digest_sha256", "decision", "reason_code", "decisive_rule_ids", "rule_evaluations", "hard_boundaries", "decision_digest_sha256"],
  "properties": {
    "contract": { "const": "ct.wallet.policy-decision-receipt.v1" },
    "policy_id": { "type": "string", "pattern": "^ct[.]policy[.][a-z0-9._-]+$" },
    "policy_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "compiled_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "enum": ["ALLOW", "HOLD", "DENY"] },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,120}$" },
    "decisive_rule_ids": { "type": "array", "maxItems": 500, "items": { "type": "string", "pattern": "^ct[.]rule[.]" } },
    "rule_evaluations": { "type": "array", "maxItems": 500 },
    "hard_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_write", "production_rights_grant", "credential_activation", "chain_broadcast", "custody", "money_movement", "effective_price_publication", "checkout_activation", "phase_advancement", "merge_authorized"],
      "properties": {
        "provider_write": { "const": false },
        "production_rights_grant": { "const": false },
        "credential_activation": { "const": false },
        "chain_broadcast": { "const": false },
        "custody": { "const": false },
        "money_movement": { "const": false },
        "effective_price_publication": { "const": false },
        "checkout_activation": { "const": false },
        "phase_advancement": { "const": false },
        "merge_authorized": { "const": false }
      }
    },
    "decision_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
