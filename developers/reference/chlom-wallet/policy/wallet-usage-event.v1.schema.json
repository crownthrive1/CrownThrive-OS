{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crownthrive.com/chlom/wallet-usage-event.v1.schema.json",
  "title": "CHLOM Wallet Usage Event v1",
  "description": "Append-only controlled-test usage evidence. It is not a bill, price, payment, right, or settlement record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "idempotency_key",
    "tenant_ref",
    "wallet_stable_id",
    "meter_id",
    "quantity",
    "occurred_at",
    "source_ref"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^ctue_[A-Za-z0-9_-]{12,120}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^ctik_[A-Za-z0-9_-]{12,160}$"
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "wallet_stable_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 220
    },
    "meter_id": {
      "type": "string",
      "pattern": "^ct[.]meter[.][a-z0-9._-]{3,180}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "payload_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object"
    }
  },
  "not": {
    "anyOf": [
      { "required": ["price"] },
      { "required": ["amount"] },
      { "required": ["private_key"] },
      { "required": ["seed_phrase"] },
      { "required": ["mnemonic"] },
      { "required": ["credential_value"] },
      { "required": ["provider_credential"] }
    ]
  }
}
