{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crownthrive.com/chlom/wallet-policy-assurance-status.v1.schema.json",
  "title": "CHLOM Wallet Policy Assurance Public Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "engine_id",
    "engine_version",
    "rulepack_id",
    "rulepack_version",
    "rulepack_sha256",
    "algorithms",
    "dispositions",
    "metrics",
    "hard_boundaries",
    "ai_advisory",
    "status_sha256"
  ],
  "properties": {
    "contract": {"const": "ct.wallet.policy-assurance-status.v1"},
    "engine_id": {"const": "ct.engine.chlom-wallet-policy-assurance.v1"},
    "engine_version": {"const": "1.0.0"},
    "rulepack_id": {"const": "ct.rulepack.chlom-wallet.policy-assurance.v1"},
    "rulepack_version": {"const": "1.0.0"},
    "rulepack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "algorithms": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^ct[.]algorithm[.]wallet[.][a-z0-9.-]+[.]v1$"},
          "name": {"type": "string"},
          "version": {"const": "1.0.0"}
        }
      }
    },
    "dispositions": {"const": ["ECAC", "HOLD", "DENY"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiled_rulepacks", "decision_receipts", "chaos_cases", "invariant_failures"],
      "properties": {
        "compiled_rulepacks": {"type": "integer", "minimum": 0},
        "decision_receipts": {"type": "integer", "minimum": 0},
        "chaos_cases": {"type": "integer", "minimum": 0},
        "invariant_failures": {"type": "integer", "minimum": 0}
      }
    },
    "hard_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "provider_write",
        "custody",
        "token_issuance",
        "money_movement",
        "production_rights_grant",
        "chain_broadcast",
        "effective_price_publication",
        "checkout_activation",
        "phase_advancement",
        "merge_authorized"
      ],
      "properties": {
        "production_activation": {"const": false},
        "provider_write": {"const": false},
        "custody": {"const": false},
        "token_issuance": {"const": false},
        "money_movement": {"const": false},
        "production_rights_grant": {"const": false},
        "chain_broadcast": {"const": false},
        "effective_price_publication": {"const": false},
        "checkout_activation": {"const": false},
        "phase_advancement": {"const": false},
        "merge_authorized": {"const": false}
      }
    },
    "ai_advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "final_authority", "deterministic_engine_is_authoritative_for_this_controlled_test"],
      "properties": {
        "enabled": {"const": false},
        "final_authority": {"const": false},
        "deterministic_engine_is_authoritative_for_this_controlled_test": {"const": true}
      }
    },
    "status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
