{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crownthrive.com/chlom/institutionalization-oidc-claims.v2.schema.json",
  "title": "CHLOM Institutionalization GitHub OIDC Claims v2",
  "description": "Public-safe normalized claims accepted by the CHLOM institutionalization v2 ingest runtime after RS256/JWKS verification and repository readback.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "repository",
    "repository_id",
    "repository_owner",
    "repository_owner_id",
    "repository_visibility",
    "event_name",
    "source_branch",
    "verified_current_head_sha",
    "verified_source_head_sha",
    "source_head_ancestor_verified",
    "manifest_path",
    "manifest_content_sha256",
    "manifest_canonical_sha256",
    "manifest_package_digest_sha256",
    "workflow",
    "workflow_ref",
    "workflow_sha",
    "github_event_sha",
    "github_run_id",
    "github_run_attempt",
    "github_actor",
    "github_actor_id",
    "oidc_jti",
    "oidc_issuer",
    "oidc_audience",
    "oidc_subject",
    "runner_environment",
    "manifest_binding_verified",
    "provider_write",
    "credential_access",
    "effective_offer",
    "stripe_objects_created",
    "checkout_enabled",
    "custody",
    "token_issuance",
    "money_movement",
    "production_rights_grant",
    "chain_broadcast",
    "phase_advancement",
    "merge_authorized",
    "automatic_profile_promotion"
  ],
  "properties": {
    "repository": { "const": "crownthrive1/CrownThrive-Support" },
    "repository_id": { "const": "1336348391" },
    "repository_owner": { "const": "crownthrive1" },
    "repository_owner_id": { "const": "315660018" },
    "repository_visibility": { "const": "public" },
    "event_name": { "enum": ["pull_request", "workflow_dispatch"] },
    "source_branch": { "const": "chlom-wallet/phase-c-proof-portability-20260822" },
    "target_branch": { "type": ["string", "null"], "enum": ["chlom-wallet/phase-b-webhook-passkey-contracts-20260822", null] },
    "pull_request_number": { "type": ["string", "null"], "enum": ["233", null] },
    "verified_current_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verified_source_head_sha": { "const": "64118e61c7671a78b43999ac5f17f9eddd1226b1" },
    "source_head_ancestor_verified": { "const": true },
    "manifest_path": { "const": "developers/manifests/chlom-wallet-phase-c-institutionalization.v1.json" },
    "manifest_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_canonical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_package_digest_sha256": { "const": "7b3be50d5541fff14127bfdd24724eb9b8b9f9ffd4b165a380dee02f2a1ef957" },
    "workflow": { "const": "CHLOM Institutionalization Package v2" },
    "workflow_ref": { "type": "string", "pattern": "^crownthrive1/CrownThrive-Support/[.]github/workflows/chlom-wallet-institutionalization-v2[.]yml@refs/" },
    "workflow_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "github_event_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "github_run_id": { "type": "string", "pattern": "^[0-9]+$" },
    "github_run_number": { "type": "string", "pattern": "^[0-9]*$" },
    "github_run_attempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "github_actor": { "const": "crownthrive1" },
    "github_actor_id": { "const": "315660018" },
    "oidc_jti": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,240}$" },
    "oidc_issuer": { "const": "https://token.actions.githubusercontent.com" },
    "oidc_audience": { "const": "chlom-wallet-institutionalization-v2" },
    "oidc_subject": {
      "type": "string",
      "anyOf": [
        { "const": "repo:crownthrive1/CrownThrive-Support:pull_request" },
        { "const": "repo:crownthrive1@315660018/CrownThrive-Support@1336348391:pull_request" },
        { "const": "repo:crownthrive1/CrownThrive-Support:ref:refs/heads/chlom-wallet/phase-c-proof-portability-20260822" },
        { "const": "repo:crownthrive1@315660018/CrownThrive-Support@1336348391:ref:refs/heads/chlom-wallet/phase-c-proof-portability-20260822" }
      ]
    },
    "runner_environment": { "const": "github-hosted" },
    "manifest_binding_verified": { "const": true },
    "provider_write": { "const": false },
    "credential_access": { "const": false },
    "effective_offer": { "const": false },
    "stripe_objects_created": { "const": false },
    "checkout_enabled": { "const": false },
    "custody": { "const": false },
    "token_issuance": { "const": false },
    "money_movement": { "const": false },
    "rights_grant": { "const": false },
    "production_rights_grant": { "const": false },
    "chain_broadcast": { "const": false },
    "phase_advancement": { "const": false },
    "merge_authorized": { "const": false },
    "automatic_profile_promotion": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "event_name": { "const": "pull_request" } }, "required": ["event_name"] },
      "then": {
        "properties": {
          "target_branch": { "const": "chlom-wallet/phase-b-webhook-passkey-contracts-20260822" },
          "pull_request_number": { "const": "233" }
        }
      }
    },
    {
      "if": { "properties": { "event_name": { "const": "workflow_dispatch" } }, "required": ["event_name"] },
      "then": {
        "properties": {
          "target_branch": { "type": "null" },
          "pull_request_number": { "type": "null" }
        }
      }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["token_value"] },
      { "required": ["raw_oidc_token"] },
      { "required": ["private_key"] },
      { "required": ["seed_phrase"] },
      { "required": ["credential_value"] },
      { "required": ["provider_credential"] }
    ]
  }
}
