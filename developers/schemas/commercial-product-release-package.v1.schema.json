{
  "$id": "https://docs.crownthrive.com/schemas/commercial-product-release-package.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commerce": {"additionalProperties": true, "type": "object"},
    "domain": {"additionalProperties": true, "type": "object"},
    "gates": {
      "items": {
        "additionalProperties": true,
        "required": ["code", "state", "reviewer_class", "evidence"],
        "type": "object"
      },
      "maxItems": 11,
      "minItems": 10,
      "type": "array"
    },
    "overall_state": {"enum": ["HOLD", "READY_FOR_INDEPENDENT_REVIEW", "ACCEPTED"]},
    "package_id": {"pattern": "^ct\\.release-package\\.[a-z0-9-]+\\.v1$", "type": "string"},
    "package_sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "platform": {"additionalProperties": true, "type": "object"},
    "pricing": {"additionalProperties": true, "type": "object"},
    "product": {"additionalProperties": true, "type": "object"},
    "publication": {"additionalProperties": true, "type": "object"},
    "schema_version": {"const": "1.0.0"},
    "sku": {"pattern": "^CT-(LAUNCH|READY|PROCURE)-[A-Z0-9]+-001$", "type": "string"},
    "tax": {"additionalProperties": true, "type": "object"}
  },
  "required": ["schema_version", "package_id", "sku", "platform", "product", "pricing", "tax", "commerce", "domain", "publication", "gates", "overall_state", "package_sha256"],
  "title": "CrownThrive Commercial Product Release Package v1",
  "type": "object"
}
