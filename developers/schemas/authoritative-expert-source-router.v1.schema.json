{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crown-thrive.mintlify.io/developers/schemas/authoritative-expert-source-router.v1.schema.json",
  "title": "CrownThrive Authoritative Expert Source Router v1",
  "type": "object",
  "required": [
    "schema_version",
    "stable_id",
    "program_phase",
    "phase_3_entry",
    "status",
    "authority_model",
    "inheritance",
    "safety",
    "mcp_contracts",
    "domain_profiles",
    "sources",
    "evidence_envelope"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stable_id": {"const": "ct.capability.authoritative-expert-source-router.v1"},
    "program_phase": {"const": "2.99"},
    "phase_3_entry": {"const": "blocked_pending_phase_2_99_hard_exit"},
    "status": {"enum": ["prepared_not_activated", "controlled_test", "active"]},
    "authority_model": {"type": "object"},
    "inheritance": {
      "type": "object",
      "required": ["scope", "agents", "projects", "mcp_surfaces", "runtime_dispatch_binding"],
      "properties": {
        "scope": {"const": "institution_wide"},
        "agents": {"const": "all_registered_agents"},
        "projects": {"const": "all_current_and_future_crownthrive_projects"},
        "mcp_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "runtime_dispatch_binding": {"type": "string"}
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": ["phase_2_99_methods", "provider_mutation", "credential_storage_in_git", "high_consequence_domains", "founder_overrides"],
      "properties": {
        "phase_2_99_methods": {"type": "array", "items": {"enum": ["GET", "HEAD"]}, "minItems": 1, "uniqueItems": true},
        "provider_mutation": {"const": false},
        "credential_storage_in_git": {"const": false},
        "high_consequence_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "founder_overrides": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "mcp_contracts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["tool", "purpose", "mode", "state"],
        "properties": {
          "tool": {"type": "string", "pattern": "^expert_sources\\."},
          "purpose": {"type": "string"},
          "mode": {"enum": ["local_read_only", "read_only"]},
          "state": {"enum": ["contracted", "prepared_not_activated", "controlled_test", "active"]}
        },
        "additionalProperties": false
      }
    },
    "domain_profiles": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": ["sources", "review_policy"],
        "properties": {
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "review_policy": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": ["source_id", "name", "authority_class", "domains", "documentation_url", "api_base", "auth_mode", "allowed_methods", "runtime_state", "claim_scope"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string"},
          "authority_class": {"type": "string"},
          "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "documentation_url": {"type": "string", "pattern": "^https://"},
          "api_base": {"anyOf": [{"type": "string", "pattern": "^https://"}, {"type": "null"}]},
          "auth_mode": {"type": "string"},
          "allowed_methods": {"type": "array", "minItems": 1, "items": {"enum": ["GET", "HEAD"]}},
          "runtime_state": {"enum": ["cataloged_official_source", "cataloged_open_source", "verified_adapter", "controlled_test", "active"]},
          "claim_scope": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence_envelope": {"type": "object"}
  },
  "additionalProperties": false
}
