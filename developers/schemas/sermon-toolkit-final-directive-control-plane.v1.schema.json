{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crown-thrive.mintlify.io/developers/schemas/sermon-toolkit-final-directive-control-plane.v1.schema.json",
  "title": "Sermon Toolkit Final Directive Control Plane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "directive",
    "properties",
    "non_negotiables",
    "authority",
    "current_evidence",
    "artifacts",
    "repository_federation",
    "agent_topology",
    "scheduled_jobs",
    "scheduler_implementation",
    "integration_matrix",
    "advertising",
    "stripe_contract",
    "public_routes",
    "license_tiers",
    "initial_articles",
    "product_families",
    "release_gates",
    "activation_policy",
    "documentation_impact"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"const": "ct.manifest.kjv-sermon.final-directive-control-plane.v1"},
    "directive": {
      "type": "object",
      "required": [
        "directive_id",
        "business_model",
        "production_activation_authorized",
        "final_release_certified",
        "phase_state",
        "phase_3_state"
      ],
      "properties": {
        "directive_id": {"const": "ct.directive.kjv-sermon.final-patch-aware-production.2026-08-15"},
        "business_model": {"const": "digital_only"},
        "production_activation_authorized": {"const": false},
        "final_release_certified": {"const": false},
        "phase_state": {"const": "phase_2_99_fail_closed_preparation"},
        "phase_3_state": {"const": "blocked_pending_phase_2_99_hard_exit"}
      },
      "additionalProperties": true
    },
    "properties": {"type": "object"},
    "non_negotiables": {
      "type": "object",
      "required": ["digital_only_notice", "physical_fulfillment", "shipping_workflows"],
      "properties": {
        "digital_only_notice": {"const": "DIGITAL PRODUCT ONLY. NO PHYSICAL ITEM WILL BE SHIPPED."},
        "physical_fulfillment": {"const": false},
        "shipping_workflows": {"const": false}
      },
      "additionalProperties": {"type": ["boolean", "string"]}
    },
    "authority": {"type": "object"},
    "current_evidence": {"type": "object"},
    "artifacts": {
      "type": "object",
      "required": ["google_drive_master", "mintlify_control_plane", "github_pull_request"],
      "properties": {
        "google_drive_master": {
          "type": "object",
          "required": ["title", "document_id", "url", "state"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "document_id": {"type": "string", "minLength": 10},
            "url": {"type": "string", "pattern": "^https://docs\\.google\\.com/document/d/"},
            "state": {"const": "created_and_verified"}
          },
          "additionalProperties": false
        },
        "mintlify_control_plane": {"type": "object"},
        "mintlify_changelog": {"type": "object"},
        "github_pull_request": {"type": "object"}
      },
      "additionalProperties": false
    },
    "repository_federation": {"type": "object"},
    "agent_topology": {
      "type": "object",
      "required": ["orchestrator", "projected_siblings", "activation_rule"],
      "properties": {
        "orchestrator": {"type": "object"},
        "projected_siblings": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "required": ["agent_id", "role", "state", "authority_ceiling", "vote_eligible"],
            "properties": {
              "agent_id": {"type": "string", "pattern": "^ct\\.agent\\.kjv\\."},
              "role": {"type": "string", "minLength": 1},
              "state": {"const": "planned_not_registered"},
              "authority_ceiling": {"enum": ["D0", "D1", "D2"]},
              "vote_eligible": {"const": false}
            },
            "additionalProperties": false
          }
        },
        "activation_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scheduled_jobs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "job_id",
          "local_cron",
          "timezone",
          "queue",
          "state",
          "idempotency_template",
          "max_runtime_minutes",
          "requires"
        ],
        "properties": {
          "job_id": {"type": "string", "pattern": "^ct\\.job\\.kjv\\."},
          "local_cron": {"type": "string"},
          "timezone": {"const": "America/New_York"},
          "queue": {"type": "string"},
          "state": {"const": "defined_not_activated"},
          "idempotency_template": {"type": "string", "minLength": 1},
          "max_runtime_minutes": {"type": "integer", "minimum": 1, "maximum": 10},
          "requires": {"type": "array", "minItems": 4, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "scheduler_implementation": {"type": "object"},
    "integration_matrix": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["provider", "service_id", "state", "directive_capability", "activation", "secret_values_in_docs"],
        "properties": {
          "provider": {"type": "string"},
          "service_id": {"type": ["string", "null"]},
          "state": {"type": "string"},
          "directive_capability": {"type": "string"},
          "activation": {"type": "string"},
          "secret_values_in_docs": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "advertising": {"type": "object"},
    "stripe_contract": {"type": "object"},
    "public_routes": {"type": "array", "minItems": 30, "uniqueItems": true, "items": {"type": "string"}},
    "license_tiers": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"type": "string"}},
    "initial_articles": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["category", "title"],
        "properties": {
          "category": {"type": "string"},
          "title": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "product_families": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["ordinal", "family_id", "name", "state"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 30},
          "family_id": {"type": "string", "pattern": "^ct\\.product-family\\."},
          "name": {"type": "string"},
          "state": {"const": "blocked_incomplete"}
        },
        "additionalProperties": false
      }
    },
    "release_gates": {"type": "array", "minItems": 20},
    "activation_policy": {
      "type": "object",
      "required": ["fail_closed", "apply_supabase_ddl_in_this_change", "merge_or_deploy_in_this_change"],
      "properties": {
        "fail_closed": {"const": true},
        "apply_supabase_ddl_in_this_change": {"const": false},
        "merge_or_deploy_in_this_change": {"const": false}
      },
      "additionalProperties": {"type": "boolean"}
    },
    "documentation_impact": {"type": "object"}
  }
}
