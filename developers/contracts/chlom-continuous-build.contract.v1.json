{
  "schema_version": "1.1.1",
  "contract_id": "ct.contract.chlom-continuous-build.v1",
  "system": "CHLOM",
  "architecture": "ct.architecture.pentafabric.v1",
  "purpose": "Continuously reconcile canon, research, identity, rights, evidence, documentation, machine contracts, public commercial projection, asset articleization, integration packaging, and monetization candidates without bypassing maintenance, authority, public/private boundaries, vault custody, or independent verification.",
  "source_priority": [
    "current founder adjudication",
    "current machine-verified institutional state",
    "current canonical CrownThrive Support records",
    "recovered primary sources",
    "validated child registries and schemas",
    "historical or research sources"
  ],
  "bound_manifests_and_contracts": [
    "developers/manifests/chlom-pentafabric.v1.json",
    "developers/manifests/chlom-agent-factory-candidates.v1.json",
    "developers/manifests/chlom-api-mcp-surface-candidates.v1.json",
    "developers/manifests/chlom-pentafabric-asset-classes.v1.json",
    "developers/manifests/chlom-commercial-package-candidates.v1.json",
    "developers/manifests/chlom-mesh-failover.v1.json",
    "developers/manifests/chlom-maintenance-projection-gate.v1.json",
    "developers/manifests/chlom-pentafabric-factory-intake.v1.json",
    "developers/contracts/chlom-machine-access.contract.v1.json",
    "developers/contracts/chlom-vault-boundary.contract.v1.json",
    "developers/contracts/chlom-commercial-projection.contract.v1.json"
  ],
  "continuous_lanes": [
    "canon_reconciliation",
    "research_and_development",
    "identity_did_fingerprint_provenance",
    "rights_and_dla_modeling",
    "hybrid_licensing_design",
    "compliance_oracle_evaluation",
    "dail_record_and_evidence_design",
    "pallet_module_container_component_build",
    "framework_plugin_skill_algorithm_formula_build",
    "api_mcp_sdk_webhook_agent_contract_build",
    "portal_dashboard_widget_wireframe_scaffold_documentation",
    "individual_asset_articleization_and_versioning",
    "parent_child_projection",
    "website_mesh_observation",
    "commercial_packaging",
    "thriveevergreen_handoff"
  ],
  "trigger_classes": [
    "source_change",
    "canon_change",
    "repository_drift",
    "scheduled_continuity_check",
    "documentation_gap",
    "new_capability",
    "new_asset_or_identity",
    "rights_or_policy_change",
    "integration_request",
    "licensing_request",
    "mesh_failure",
    "maintenance_state_change",
    "founder_directed_work"
  ],
  "execution": {
    "builder": "ct.agent.execution-builder",
    "agent_candidate_manifest": "developers/manifests/chlom-agent-factory-candidates.v1.json",
    "asset_class_manifest": "developers/manifests/chlom-pentafabric-asset-classes.v1.json",
    "factory_intake_manifest": "developers/manifests/chlom-pentafabric-factory-intake.v1.json",
    "build_completion_state": "BUILT_PENDING_INDEPENDENT_VERIFICATION",
    "direct_main_write": false,
    "force_push": false,
    "self_merge": false,
    "self_certification": false,
    "d3_allowed": false
  },
  "maintenance": {
    "gate": "developers/manifests/chlom-maintenance-projection-gate.v1.json",
    "current_state": "PAUSED_FOR_TARGETED_MAINTENANCE",
    "read_only_and_candidate_work_allowed": true,
    "routine_autonomous_external_mutation_allowed": false,
    "release_is_time_based": false
  },
  "projection": {
    "parent": "crownthrive1/CrownThrive-OS",
    "child": "crownthrive/chlom-protocol",
    "managed_child_paths_only": true,
    "delete_unmanaged_child_paths": false,
    "child_pull_request_required": true,
    "exact_parent_sha_receipt_required": true,
    "automatic_child_projection_requires_maintenance_release": true,
    "automatic_child_projection_requires_bounded_child_token": true
  },
  "vault": {
    "contract": "developers/contracts/chlom-vault-boundary.contract.v1.json",
    "runtime_binding_state": "PENDING_VERIFIED_RUNTIME_BINDING",
    "protected_inputs_are_opaque_references": true,
    "raw_secret_return": false
  },
  "machine_interfaces": {
    "candidate_manifest": "developers/manifests/chlom-api-mcp-surface-candidates.v1.json",
    "public_runtime_activation_inferred": false,
    "production_activation_requires_separate_runtime_evidence": true
  },
  "mesh": {
    "manifest": "developers/manifests/chlom-mesh-failover.v1.json",
    "public_route_observation_allowed_during_maintenance": true,
    "infrastructure_failover_certified": false
  },
  "economic_boundary": {
    "commercial_package_manifest": "developers/manifests/chlom-commercial-package-candidates.v1.json",
    "commercial_packaging_allowed": true,
    "pricing_activation_allowed_by_this_contract": false,
    "checkout_activation_allowed_by_this_contract": false,
    "entitlement_activation_allowed_by_this_contract": false,
    "money_movement_allowed_by_this_contract": false,
    "activation_authority": "ThriveEvergreen / ECAC"
  },
  "security": {
    "public_safe_projection_only": true,
    "raw_secret_export": false,
    "restricted_body_publication": false,
    "private_economic_logic_publication": false,
    "protected_identity_data_publication": false,
    "fingerprint_private_derivation_publication": false,
    "private_prompt_or_scoring_publication": false
  }
}
