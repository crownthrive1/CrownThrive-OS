{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crownthrive.example/agent-build-receipt.v1.schema.json",
  "title": "CrownThrive Agent Build Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id","executor_agent_id","candidate_branch","exact_head","output_sha256",
    "output_manifest","tests","rollback","custody","verifier_agent_id","receipt_state"
  ],
  "properties": {
    "request_id": {"type":"string"},
    "executor_agent_id": {"const":"ct.agent.execution-builder"},
    "candidate_branch": {"type":"string","minLength":3},
    "exact_head": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "output_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "output_manifest": {"type":"object"},
    "tests": {"type":"object"},
    "rollback": {"type":"object"},
    "custody": {"type":"object"},
    "verifier_agent_id": {"type":"string","minLength":4},
    "receipt_state": {"const":"BUILT_PENDING_INDEPENDENT_VERIFICATION"},
    "certification_effect": {"const":false},
    "sovereign_vote_created": {"const":false},
    "operational_activation": {"const":false}
  }
}
