{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crownthrive.example/agent-build-request.v1.schema.json",
  "title": "CrownThrive Agent Build Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_key","requester_agent_id","target_repository","target_base_head","authority_ceiling",
    "risk_class","build_scope","required_outputs","input_sha256","verifier_agent_id"
  ],
  "properties": {
    "request_key": {"type":"string","minLength":8},
    "source_work_id": {"type":["string","null"]},
    "source_queue_id": {"type":["string","null"]},
    "requester_agent_id": {"type":"string","minLength":4},
    "target_repository": {"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "target_base_head": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "authority_ceiling": {"enum":["D0","D1","D2"]},
    "risk_class": {"enum":["D0","D1","D2"]},
    "build_scope": {"type":"object"},
    "required_outputs": {"type":"object"},
    "protected_input_refs": {"type":"array","items":{"type":"string"}},
    "input_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "verifier_agent_id": {"type":"string","minLength":4},
    "direct_main_write": {"const":false},
    "force_push": {"const":false},
    "self_merge": {"const":false},
    "d3_allowed": {"const":false}
  }
}
