{
  "schema_version":"1.0.1",
  "contract_id":"ct.contract.cie.production-authority.v1",
  "subject":"ct.framework.cultural-imprint-engine",
  "package_id":"ct.framework-package.cie",
  "repository_id":"ct.repo.cie",
  "parent_repository_id":"ct.repo.CrownThrive-OS",
  "stable_platform_id":"ct.platform.cie",
  "algorithm_id":"ct.algorithm.cie.v1",
  "production_agent_id":"ct.framework-agent.cie",
  "production_state":{
    "repository_governance_state":"linked_governed",
    "package_state":"maintained",
    "operationally_enabled":true,
    "algorithm_invocation_state":"production_limited",
    "api_exposure":"governed_internal_only",
    "mcp_exposure":"governed_internal_only",
    "public_activation":false,
    "commerce_activation":false,
    "provider_write_effect":false,
    "rights_effect":false,
    "economic_effect":false,
    "vote_effect":false,
    "d3_auto":false
  },
  "authority_modes":{
    "agent_d_certification":{"human_required":false,"independent_parent_certification_required":true},
    "founder_override":{"human_required":true,"deadlock_preflight_required":true,"ask_first_required":true,"surrogate_allowed":false},
    "founder_direct":{
      "human_required":true,
      "deadlock_preflight_required":false,
      "surrogate_allowed":false,
      "surrogate_state_required":"ineligible",
      "authority_class_required":"D2",
      "autonomy_class_required":"A2",
      "request_metadata_required":{"founder_direct":true,"direct_scope":"CIE_GOVERNED_INTERNAL_PRODUCTION"},
      "exact_version_ref_required":true,
      "content_sha256_required":true,
      "rollback_test_state_required":"pass",
      "explicit_human_approval_required":true,
      "chain_event_reverification_required":true,
      "production_receipt_authority_mode":"founder_direct"
    }
  },
  "production_receipt":{
    "table":"chlom_runtime.framework_production_receipts_v1",
    "required":true,
    "append_only":true,
    "authority_mode_vocabulary":["agent_d_certification","founder_override","founder_direct","rollback_only"],
    "founder_direct_must_be_recordable":true
  },
  "parent_hosted_package_proof":{
    "registered_parent_matches_canonical_host":true,
    "exact_parent_head_required":true,
    "exact_child_head_required":true,
    "guardian_verified_required":true,
    "family_verified_required":true,
    "interoperability_verified_required":true,
    "link_authority_effect_must_be_false":true,
    "link_operational_activation_must_be_false":true,
    "link_vote_effect_must_be_false":true,
    "child_self_activation_must_be_false":true
  },
  "production_canary":{"required":true,"function":"public.ct_cie_score_private_impl","expected_verdict":"PASS","private_policy_body_returned":false,"chain_event_required":true},
  "rollback":{"required":true,"function":"chlom_runtime.rollback_framework_production_v1","authority_reducing":true,"history_preserved":true},
  "economic_boundary":{"thriveevergreen_required_for_pricing_checkout_credits_entitlement":true,"production_activation_does_not_create_commerce_authority":true}
}
