        "generalizedDispatchEnabled": { "const": false },
        "wrapperOnly": { "const": true },
        "blocker": { "const": "generalized_external_dispatch_not_independently_certified" },
        "wrapperId": { "$ref": "#/$defs/stableId" },
        "idempotencyKey": { "type": "string" },
        "wrapperExecutionAuthorized": { "const": false },
        "providerWriteAuthorized": { "const": false },
        "dispatchEvaluationDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "semanticValidators": [
    "Gate profiles are nonempty, unique, sorted, content-digested, registry-bound by an independently trusted wrapper-pinned expected digest, and effective-dated; caller-supplied matching values are validation material only.",
    "The independently trusted wrapper-pinned expected registry snapshot SHA-256 equals the registry snapshot bound into the canonical gate-profile digest; an untrusted caller cannot establish that expectation.",
    "The independently trusted wrapper-pinned expected candidate SHA-256 equals the canonical digest of the full normalized candidate, including subject, content, and requested effects; an untrusted caller cannot establish that expectation.",
    "The supplied gate object contains every and only the exact gate profile keys.",
    "The candidate, expected version, and gate-profile candidate version are identical.",
    "All monetary inputs are safe, nonnegative integers; invalid negatives are rejected rather than clamped.",
    "The canonical JSON implementation rejects non-I-JSON values and hashes supported values independently of object insertion order.",
    "UTC instants are real-calendar RFC 3339 Z timestamps with zero to nine fractional digits; offsets and impossible dates are rejected.",
    "Provider identifiers are lowercase ASCII identifiers and provider evidence is sorted by deterministic code-unit order.",
    "REVOKED, REFUNDED, and EXPIRED entitlements cannot reactivate; renewal creates a new exact-version entitlement.",
    "Provider readback mismatch returns HOLD, and provider success remains evidence only.",
    "A validated mutation envelope is not effect authorization.",
    "ML authority attempts are contract violations.",
    "All derived ML scores, confidence values, and explanation values are finite before output.",
    "Generalized dispatch requests are rejected; a valid wrapper-only request still returns HOLD and does not authorize execution."
  ],
  "contracts": {
    "candidateNormalization": {
      "inputSchema": { "$ref": "#/$defs/candidate" },
      "outputAuthority": "none"
    },
    "gateProfileRegistration": {
      "inputSchema": { "$ref": "#/$defs/gateProfileMaterial" },
      "outputSchema": { "$ref": "#/$defs/exactGateProfile" },
      "registryBindingRequired": true
    },
    "exactEcacEvaluation": {
      "inputSchema": { "$ref": "#/$defs/ecacInput" },
      "outputSchema": { "$ref": "#/$defs/ecacOutput" },
      "outputAuthority": "validation_only_not_execution_authority",
      "decisionValues": ["ECAC", "HOLD", "DENY"],
      "providerSuccessAuthority": false
    },
    "priceEnvelope": {
      "inputSchema": { "$ref": "#/$defs/priceEnvelopeInput" },
      "outputSchema": { "$ref": "#/$defs/priceEnvelopeOutput" },
      "authority": "advisory_only"
    },
    "providerReadback": {
      "inputSchema": { "$ref": "#/$defs/providerReadbackInput" },
      "outputSchema": { "$ref": "#/$defs/providerReadbackOutput" },
      "institutionalEffectAllowedDefault": false
    },
    "entitlementTransition": {
      "inputSchema": { "$ref": "#/$defs/entitlementInput" },
      "outputSchema": { "$ref": "#/$defs/entitlementOutput" },
      "terminalStates": ["REVOKED", "REFUNDED", "EXPIRED"],
      "terminalReactivation": false,
      "transitionMatrix": {
        "PENDING": ["PENDING", "ACTIVE", "SUSPENDED", "REVOKED", "REFUNDED", "DISPUTED", "EXPIRED"],
        "ACTIVE": ["ACTIVE", "SUSPENDED", "REVOKED", "REFUNDED", "DISPUTED", "EXPIRED"],
        "SUSPENDED": ["SUSPENDED", "ACTIVE", "REVOKED", "REFUNDED", "DISPUTED", "EXPIRED"],
        "DISPUTED": ["DISPUTED", "SUSPENDED", "REVOKED", "REFUNDED", "EXPIRED"],
        "REVOKED": ["REVOKED"],
        "REFUNDED": ["REFUNDED"],
        "EXPIRED": ["EXPIRED"]
      }
    },
    "settlement": {
      "inputSchema": { "$ref": "#/$defs/settlementInput" },
      "outputSchema": { "$ref": "#/$defs/settlementOutput" },
      "stateValues": ["PASS", "HOLD"],
      "remedyValues": ["CORRECT", "COMPENSATE"],
      "providerSettlementAuthority": false
    },
    "rollbackCompensation": {
      "inputSchema": { "$ref": "#/$defs/rollbackInput" },
      "outputSchema": { "$ref": "#/$defs/rollbackOutput" },
      "appendOnlyReceiptRequired": true
    },
    "mutationExecutionEnvelope": {
      "inputSchema": { "$ref": "#/$defs/mutationEnvelopeInput" },
      "outputSchema": { "$ref": "#/$defs/mutationEnvelopeOutput" },
      "requiredControls": ["idempotency", "pre_read", "second_read", "post_read", "compensation"],
      "effectAuthority": false
    },
    "mlAdvisory": {
      "inputRequestSchema": { "$ref": "#/$defs/mlRequest" },
      "outputSchema": { "$ref": "#/$defs/mlOutput" },
      "models": [
        "ct.ml.thriveevergreen.demand-score",
        "ct.ml.thriveevergreen.price-elasticity-advisor",
        "ct.ml.thriveevergreen.anomaly-risk"
      ],
      "authority": "advisory_only"
    },
    "generalizedDispatch": {
      "inputSchema": { "$ref": "#/$defs/dispatchInput" },
      "outputSchema": { "$ref": "#/$defs/dispatchOutput" },
      "state": "HOLD",
      "enabled": false,
      "wrapperOnly": true
    }
  }
