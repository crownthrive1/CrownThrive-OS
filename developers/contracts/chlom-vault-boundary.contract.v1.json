{
  "schema_version": "1.0.0",
  "contract_id": "ct.contract.chlom-vault-boundary.v1",
  "system": "CHLOM",
  "architecture": "ct.architecture.pentafabric.v1",
  "purpose": "Define how CHLOM public, agent, factory, API/MCP, DAIL, rights, identity, and commercial artifacts reference protected state without exporting protected bodies or secrets into public repositories or untrusted machine surfaces.",
  "runtime_binding_state": "PENDING_VERIFIED_RUNTIME_BINDING",
  "broker_reference": "chlom-vault-broker",
  "gateway_reference": "chlom-vault-gateway",
  "opaque_references_only": true,
  "raw_secret_return": false,
  "public_vault_locator": false,
  "protected_classes": [
    "credentials",
    "private_keys",
    "signing_secrets",
    "private_contracts",
    "protected_evidence",
    "protected_person_data",
    "customer_data_outside_authorized_public_scope",
    "private_economic_logic",
    "private_pricing_logic",
    "private_prompts",
    "private_scoring_logic",
    "fingerprint_private_derivation",
    "protected_identity_mappings",
    "confidential_implementation",
    "unreleased_source_assets"
  ],
  "allowed_public_reference_fields": [
    "stable_reference_id",
    "version",
    "content_digest_or_commitment",
    "classification",
    "custody_status",
    "authority_reference",
    "public_safe_status",
    "public_safe_provenance_reference"
  ],
  "required_for_runtime_promotion": [
    "exact asset and version binding",
    "opaque reference readback",
    "least privilege authorization",
    "no raw secret return",
    "restore or recovery proof where applicable",
    "DAIL lineage reference",
    "independent security review for high consequence bindings"
  ],
  "agent_rules": {
    "agents_may_receive_opaque_reference": true,
    "agents_may_request_authorized_bounded_operation": true,
    "agents_may_export_raw_secret": false,
    "agents_may_publish_protected_body": false,
    "agents_may_expand_their_own_vault_scope": false
  },
  "factory_rules": {
    "candidate_artifacts_may_reference_protected_inputs_opaquely": true,
    "candidate_artifacts_may_copy_protected_inputs": false,
    "public_projection_must_strip_protected_bodies": true,
    "verification_receipt_does_not_reveal_secret": true
  },
  "economic_rules": {
    "commercial_package_may_reference_private_pricing_inputs_opaquely": true,
    "public_repository_may_publish_private_pricing_inputs": false,
    "economic_activation_authority": "ThriveEvergreen / ECAC"
  },
  "truth_boundary": "This contract defines the custody boundary but does not claim that a live vault binding currently exists. Runtime activation requires machine readback and evidence."
}
