{
  "schema": "ct.penta.repository-mesh.v1",
  "version": "1.0.0",
  "canonical_hub": "crownthrive1/CrownThrive-Support",
  "protocol_registry": "crownthrive1/chlom-protocol",
  "authority_invariant": "Repository connectivity, CI capability, provider credentials, and mesh membership never manufacture execution authority.",
  "repositories": [
    {
      "repository": "crownthrive1/CrownThrive-Support",
      "visibility": "public",
      "default_branch": "main",
      "roles": ["penta-runtime-hub", "provider-control-plane", "pentamail", "pentastatus", "public-governance-projection"],
      "node_manifest": "federation/penta-mesh-node.v1.json"
    },
    {
      "repository": "crownthrive1/CrownThrive-CIE",
      "visibility": "private",
      "default_branch": "main",
      "roles": ["cultural-imprint-engine", "private-governed-source", "penta-mesh-node"],
      "node_manifest": "federation/penta-mesh-node.v1.json"
    },
    {
      "repository": "crownthrive1/chlom-protocol",
      "visibility": "public",
      "default_branch": "main",
      "roles": ["chlom-protocol", "integration-registry", "governance-contracts", "penta-mesh-node"],
      "node_manifest": "federation/penta-mesh-node.v1.json"
    }
  ],
  "interoperability": {
    "transport_hub": "crownthrive1/CrownThrive-Support",
    "mail_operation": "email_send",
    "mail_provider_control": "runtime/penta-provider-control-plane/providers.json",
    "shared_runtime": ["runtime/penta_mail.py", "runtime/penta_runtime_suite.py"],
    "integration_registry_url": "https://raw.githubusercontent.com/crownthrive1/chlom-protocol/main/registry/integrations.json",
    "public_mesh_contract_url": "https://raw.githubusercontent.com/crownthrive1/CrownThrive-Support/main/federation/penta-mesh.v1.json",
    "private_repository_rule": "Private nodes independently attest their local node manifest against this public contract; public nodes do not require private repository read access."
  }
}
