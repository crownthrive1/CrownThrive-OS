{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/contracts/penta/assignment-fulfillment-v1.schema.json",
  "title": "CrownThrive Penta Assignment Fulfillment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "assignment_id",
    "assignment_key",
    "subject_ref",
    "task_kind",
    "family_key",
    "owner_pentas",
    "risk_class",
    "authority_ceiling",
    "exact_artifact_ref",
    "acceptance_criteria",
    "required_projections",
    "d3_human_reserved",
    "money_movement",
    "credential_change",
    "authority_expansion"
  ],
  "properties": {
    "contract": { "const": "ct.penta.assignment-fulfillment.v1" },
    "assignment_id": { "type": "string", "format": "uuid" },
    "assignment_key": { "type": "string", "minLength": 8, "maxLength": 300 },
    "subject_ref": { "type": "string", "minLength": 1 },
    "task_kind": { "type": "string", "minLength": 1 },
    "family_key": {
      "type": "string",
      "enum": [
        "AUTOMATION_AGENTIC",
        "BUILD_RELEASE",
        "COMMERCE_ECONOMY",
        "COMMUNICATIONS_SERVICE",
        "GOVERNANCE_LEGAL",
        "INTELLIGENCE_RESEARCH",
        "KNOWLEDGE_DATA",
        "MEDIA_CREATIVE",
        "OBSERVABILITY_ORGANIC",
        "RESILIENCE_CONTINUITY",
        "ROUTING_INTEROP",
        "SECURITY_TRUST",
        "SYSTEM_ARCHITECTURE",
        "TRANSPORT_PRIMITIVES",
        "WORKFORCE_PEOPLE"
      ]
    },
    "owner_pentas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "risk_class": { "enum": ["D0", "D1", "D2"] },
    "authority_ceiling": { "enum": ["D0", "D1", "D2"] },
    "source_repo": { "type": ["string", "null"] },
    "source_pr_number": { "type": ["integer", "null"], "minimum": 1 },
    "exact_head_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "exact_artifact_ref": { "type": "string", "minLength": 1 },
    "exact_artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "acceptance_criteria": { "type": "array" },
    "required_projections": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "PENTADOCS" } },
        { "contains": { "const": "DRIVE_HUMAN" } },
        { "contains": { "const": "DRIVE_HYBRID" } },
        { "contains": { "const": "DRIVE_MACHINE_SHEET" } }
      ],
      "items": { "type": "string" }
    },
    "d3_human_reserved": { "const": true },
    "money_movement": { "const": false },
    "credential_change": { "const": false },
    "authority_expansion": { "const": false }
  }
}
