{
  "schema": "ct.penta.contract.v1",
  "canonical_name": "PentaProof",
  "mark": "PentaProof™",
  "version": "1.0.0",
  "state": "IMPLEMENTED_TESTING",
  "family": "build-release",
  "role": "CI and runtime evidence automation, provenance binding and fail-closed proof generation",
  "inputs": [
    "certification workflow conclusion",
    "test evidence JSON",
    "workflow/run identity",
    "execution SHA",
    "artifact digest"
  ],
  "outputs": [
    "ct.penta.proof-envelope.v1",
    "source SHA-256 digest",
    "proof-envelope SHA-256 digest",
    "DAIL projection",
    "PentaCertify/PentaAssure/PentaRelease evidence input"
  ],
  "invariants": {
    "source_verdict_must_be_pass": true,
    "all_tests_must_pass": true,
    "failed_count_must_be_zero": true,
    "passed_count_must_equal_test_count": true,
    "duplicate_test_names_rejected": true,
    "execution_sha_required": true,
    "hash_source_evidence": true,
    "hash_proof_envelope": true,
    "fail_closed": true,
    "cannot_self_authorize_release": true,
    "cannot_self_authorize_money_movement": true,
    "cannot_self_authorize_rights": true,
    "cannot_dispatch_provider_writes": true
  },
  "handoffs": {
    "upstream": ["PentaActions", "PentaResults", "PentaTest"],
    "assurance": ["PentaCertify", "PentaAssure"],
    "ledger": ["DAIL"],
    "release": ["PentaRelease"]
  },
  "production_gate": "Exact-commit CI PASS plus successful PentaProof envelope generation and governed merge/post-merge canary are required before state may become PRODUCTION_CERTIFIED."
}
