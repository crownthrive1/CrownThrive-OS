{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/contracts/penta/pentarouter-node.v1.schema.json",
  "title": "CrownThrive PentaRouter Node Contract",
  "type": "object",
  "required": ["node_id", "node_type", "dispatch_role", "enabled", "lanes", "capabilities", "risk_ceiling", "health_default"],
  "properties": {
    "node_id": {"type": "string", "pattern": "^ct\\.node\\."},
    "node_type": {
      "enum": ["pentarouter", "durable_queue", "append_only_ledger", "independent_observer", "bridge", "adapter", "runtime"]
    },
    "dispatch_role": {"enum": ["router", "support"]},
    "enabled": {"type": "boolean"},
    "priority": {"type": "integer", "minimum": 0},
    "lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["hot", "warm", "cold"]}
    },
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_ceiling": {"enum": ["D0", "D1", "D2", "D3"]},
    "health_default": {
      "type": "object",
      "required": ["state", "breaker", "capacity"],
      "properties": {
        "state": {"enum": ["healthy", "degraded", "unavailable"]},
        "breaker": {"enum": ["closed", "open"]},
        "capacity": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "x-crownthrive-selection-order": ["health", "priority", "capacity", "node_id"],
  "x-crownthrive-no-provider-authority": true
}
