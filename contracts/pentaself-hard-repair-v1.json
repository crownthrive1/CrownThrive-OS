{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "ct.penta.self.hard-repair.v1",
  "version": "1.0.0",
  "state": "production",
  "family": {
    "key": "SURGICAL_CARE",
    "canonical_name": "Penta Surgical Care Family",
    "members": ["PentaSurgeon", "PentaChart", "PentaRounds"],
    "collaborators": [
      "PentaSELF",
      "PentaScribe",
      "PentaDocs",
      "PentaDnD",
      "PentaCertify",
      "PentaPR",
      "PentaMerge",
      "PentaCloser"
    ]
  },
  "authority": {
    "maximum_risk_class": "D2",
    "d3_human_reserved": true,
    "money_movement": false,
    "secret_mutation": false,
    "credential_manufacture": false,
    "authority_manufacture": false,
    "arbitrary_sql": false,
    "direct_main": false,
    "originator_self_certification": false,
    "originator_self_vote_counted": false
  },
  "execution": {
    "handler_contract": "jsonb -> jsonb",
    "registered_handlers_only": true,
    "precheck_required": true,
    "postcheck_required": true,
    "transaction_subrollback_on_exception": true,
    "maximum_immediate_retries": 1,
    "compensation_rule": "regression=true AND caused_by_repair=true",
    "compensation_readback_required": true,
    "post_compensation_retry_limit": 1,
    "stale_rollback_forbidden": true,
    "generation_policy": "newer_generation_supersession_only"
  },
  "assurance": {
    "exact_case_sha256_required": true,
    "required_independent_certifiers": ["penta.dnd", "penta.certify"],
    "minimum_independent_passes": 2,
    "penta_self_may_certify_own_case": false,
    "post_operation_current_truth_required": true
  },
  "charting": {
    "owner": "PentaChart/PentaScribe",
    "chart_types": [
      "triage",
      "preop",
      "procedure",
      "postop",
      "rollback",
      "retry",
      "certification",
      "discharge",
      "followup"
    ],
    "operational_not_medical": true,
    "secret_redaction": true,
    "chart_sha256_required": true
  },
  "documentation": {
    "owner": "PentaDocs",
    "internal_path": "/internal/pentaself/hard-repairs",
    "public_path": "/pentaself/hard-repairs",
    "public_projection_for": ["significant", "critical", "held", "failed"],
    "public_redaction_required": true
  },
  "pull_request_closure": {
    "required_for_source_changes": true,
    "base_ref": "main",
    "exact_head_sha_required": true,
    "non_draft_required": true,
    "mergeable_required": true,
    "green_checks_required": true,
    "unresolved_high_findings": 0,
    "documentation_complete_required": true,
    "merge_classifier": "PentaPR",
    "merge_executor": "PentaMerge",
    "provider_readback_required": true,
    "direct_main": false
  },
  "production_canary": {
    "case_id": "6975c96b-0925-48ad-b7f8-0a71d1509ae7",
    "exact_case_sha256": "c01273cb8579a4f77edad2f1db5d198166327f101886aa48486a36e55da6685d",
    "disposition": "PASS",
    "final_state": "discharged",
    "verified_compensations": 1,
    "bounded_immediate_retries": 1,
    "independent_certifiers": ["penta.dnd", "penta.certify"],
    "provider_write": false,
    "money_movement": false,
    "secret_mutation": false,
    "authority_expansion": false,
    "direct_main": false
  }
}
