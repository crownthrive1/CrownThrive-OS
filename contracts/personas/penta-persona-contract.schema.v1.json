{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownthrive.com/contracts/personas/penta-persona-contract.schema.v1.json",
  "title": "CrownThrive Penta Persona Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "persona_id",
    "persona_version",
    "display_name",
    "role_title",
    "organization",
    "brand",
    "corridor",
    "purpose",
    "state",
    "disclosure",
    "voice_rules",
    "capability_refs",
    "playbook_refs",
    "authority",
    "transport",
    "data_policy",
    "escalation",
    "lifecycle",
    "evidence"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^ct\\.persona\\."
    },
    "contract_version": {
      "type": "string"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^ct\\.persona\\."
    },
    "persona_version": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "role_title": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "corridor": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "candidate",
        "approved",
        "active",
        "suspended",
        "superseded",
        "retired"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "disclosure": {
      "type": "object",
      "required": [
        "ai_assisted",
        "required_text",
        "impersonation_prohibited"
      ],
      "properties": {
        "ai_assisted": {
          "const": true
        },
        "required_text": {
          "type": "string",
          "minLength": 1
        },
        "impersonation_prohibited": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "voice_rules": {
      "type": "object",
      "required": [
        "tone",
        "terminology",
        "cultural_alignment"
      ],
      "properties": {
        "tone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminology": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cultural_alignment": {
          "type": "string"
        },
        "prohibited_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "capability_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "playbook_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "required": [
        "ceiling",
        "d3_human_reserved",
        "allowed",
        "prohibited"
      ],
      "properties": {
        "ceiling": {
          "enum": [
            "D0",
            "D1",
            "D2"
          ]
        },
        "d3_human_reserved": {
          "const": true
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": [
        "penta_mail_transport_only",
        "sender_identity_refs",
        "direct_mailbox_send_prohibited"
      ],
      "properties": {
        "penta_mail_transport_only": {
          "const": true
        },
        "sender_identity_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "direct_mailbox_send_prohibited": {
          "const": true
        },
        "provider_policy_ref": {
          "type": "string"
        },
        "universal_copy_policy_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data_policy": {
      "type": "object",
      "required": [
        "minimum_necessary",
        "raw_secret_access",
        "retention_ref"
      ],
      "properties": {
        "minimum_necessary": {
          "const": true
        },
        "raw_secret_access": {
          "const": false
        },
        "retention_ref": {
          "type": "string"
        },
        "sensitive_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "commerce_rights": {
      "type": "object",
      "properties": {
        "money_movement_authority": {
          "const": false
        },
        "rights_grant_authority": {
          "const": false
        },
        "legal_acceptance_authority": {
          "const": false
        },
        "credential_authority": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "required": [
        "typed_holds",
        "human_owner",
        "security_incident_route"
      ],
      "properties": {
        "typed_holds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "human_owner": {
          "type": "string",
          "minLength": 1
        },
        "security_incident_route": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "created_at",
        "approved_at",
        "invalidation_conditions",
        "supersedes"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "invalidation_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_refs",
        "contract_digest",
        "test_refs",
        "certification_state",
        "dail_refs",
        "custody_refs"
      ],
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "certification_state": {
          "enum": [
            "pending",
            "hold",
            "pass",
            "fail",
            "superseded"
          ]
        },
        "dail_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custody_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
