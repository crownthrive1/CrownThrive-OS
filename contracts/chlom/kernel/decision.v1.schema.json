{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crownthrive:chlom:kernel:decision:v1",
  "title": "CHLOM Kernel Decision Contract v1",
  "description": "Phase 2.99 semantic-oracle decision record. It is evidence of a reference decision, not production execution authority.",
  "type": "object",
  "required": [
    "decision_id",
    "effect",
    "action",
    "resource_id",
    "matched_rule_ids",
    "reasons",
    "required_approvals",
    "risk_class",
    "docs_impact",
    "event_id",
    "contract_id",
    "contract_version",
    "request_contract_id",
    "request_id",
    "correlation_id",
    "idempotency_key",
    "actor_id",
    "organization_id",
    "resource_type",
    "observed_resource_version",
    "expected_resource_version",
    "authority_evidence",
    "prototype_state"
  ],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^ct\\.decision\\.ref\\.[0-9]{8}$"},
    "effect": {"enum": ["allow", "deny", "hold"]},
    "action": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "matched_rule_ids": {"type": "array", "items": {"type": "string"}},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "required_approvals": {"type": "array", "items": {"type": "string"}},
    "risk_class": {"enum": ["D0", "D1", "D2", "D3"]},
    "docs_impact": {"type": "object"},
    "event_id": {"type": "string", "pattern": "^ct\\.event\\.ref\\.[0-9]{8}$"},
    "contract_id": {"const": "ct.contract.chlom.kernel.decision.v1"},
    "contract_version": {"const": "1.0.0"},
    "request_contract_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "resource_type": {"type": "string", "minLength": 1},
    "observed_resource_version": {"type": ["integer", "null"], "minimum": 0},
    "expected_resource_version": {"type": ["integer", "null"], "minimum": 0},
    "authority_evidence": {"type": "array", "items": {"type": "string"}},
    "prototype_state": {"const": "phase_2_99_semantic_oracle"}
  },
  "additionalProperties": false
}
