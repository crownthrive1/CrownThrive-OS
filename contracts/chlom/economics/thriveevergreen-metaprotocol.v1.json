{
  "schema_version": "1.0.0",
  "contract_id": "ct.contract.chlom.economics.thriveevergreen.v1",
  "name": "ThriveEvergreen Metaprotocol Commerce and Economic Activation Contract",
  "effective_date": "2026-08-22",
  "governance_state": "adopted_phase_2_specification",
  "runtime_state": "not_yet_phase_3_certified",
  "canonical_platform_id": "ct.platform.thriveevergreen",
  "canonical_agent_id": "ct.agent.thriveevergreen-steward",
  "canonical_asset_class_id": "ct.assetclass.evergreen",
  "governance_parent": "CHLOM",
  "cultural_authority": "CIE",
  "metaprotocol_role": "cross_pallet_commerce_economic_execution_subprotocol",
  "separate_pallet": false,
  "constitutional_invariants": [
    "ThriveEvergreen may optimize within authority. It may never manufacture authority.",
    "No certified CrownThrive economic activation surface may bypass the ECAC decision contract.",
    "Provider evidence is not economic truth.",
    "Provider identifiers are aliases and never replace canonical CrownThrive commerce identity.",
    "Execution occurs inside signed authority and is reconciled immediately afterward.",
    "Corrections, rollback and compensating actions append evidence and do not erase adverse history.",
    "The executor is never its own sole D2 or D3 certifier."
  ],
  "activation_decision": {
    "input": "commercial_candidate",
    "outputs": ["ECAC", "HOLD", "DENY"],
    "non_bypass": true
  },
  "exclusive_sku_authority": {
    "issuer": "ct.platform.thriveevergreen",
    "sku_reuse": "prohibited",
    "retired_sku_state": "reserved",
    "provider_ids": "aliases_only"
  },
  "ecac_binding": [
    "asset_id",
    "asset_version",
    "product_id",
    "variant_id",
    "sku",
    "offer_id",
    "rights_evidence",
    "license_policy",
    "pricing_decision",
    "tax_classification",
    "fulfillment_contract",
    "entitlement_contract",
    "refund_dispute_policy",
    "risk_profile",
    "advertising_policy",
    "territory",
    "currency",
    "channels",
    "chlom_record",
    "cie_record",
    "authority_bundle",
    "policy_hash",
    "approvals",
    "signature",
    "fingerprint",
    "effective_period"
  ],
  "provider_evidence_rule": {
    "direct_money_promotion": "prohibited",
    "requires_reconciliation_before": [
      "invoice",
      "advertiser_charge",
      "publisher_earning",
      "creator_earning",
      "location_earning",
      "commission",
      "payout",
      "settlement",
      "public_performance_claim",
      "entitlement"
    ]
  },
  "adluxe_scope": {
    "network": "commercial_and_economic_layer",
    "studio": "commercial_envelope_and_release_eligibility",
    "places": "inventory_assetization_economics_and_settlement",
    "native_providers": "replaceable_execution_systems"
  },
  "economic_execution_doctrine": "execute_inside_signed_authority_reconcile_immediately_rollback_or_compensate_when_evidence_fails",
  "reconciliation_outcomes": ["PASS", "CORRECT", "ROLLBACK", "COMPENSATE", "ESCALATE"],
  "safe_hold_triggers": [
    "rights_contradiction_or_expiry",
    "unexpected_payout_destination",
    "credential_drift",
    "provider_drift",
    "price_or_rate_anomaly",
    "payment_ledger_mismatch",
    "webhook_or_signature_failure",
    "refund_or_chargeback_anomaly",
    "tax_failure",
    "fulfillment_failure",
    "inventory_mismatch",
    "contract_mismatch",
    "policy_hash_mismatch",
    "unknown_production_deployment",
    "adluxe_budget_overrun",
    "invalid_traffic",
    "prohibited_targeting",
    "failed_reconciliation"
  ],
  "supervision": {
    "charter": "top-level-charter-agent",
    "supervisor": "ct.agent.agent-a-supervisor",
    "independent_domains": [
      "chlom_rights",
      "economic",
      "legal_policy",
      "security",
      "adluxe_when_relevant",
      "independent_commerce_certifier"
    ],
    "self_escalation": "prohibited",
    "charter_self_modification": "prohibited",
    "credential_self_expansion": "prohibited"
  },
  "phase_3_required_services": [
    "sku_service",
    "ecac_service",
    "commerce_ledger",
    "reconciliation_engine",
    "chlom_bridge",
    "cie_bridge",
    "pricing_and_risk_services",
    "stripe_payment_adapters",
    "adluxe_adapters",
    "api_and_mcp_contracts",
    "vault_boundaries",
    "capability_manifests",
    "certification_harness"
  ],
  "required_adversarial_and_fault_tests": [
    "sell_without_rights_must_fail",
    "forge_or_reuse_sku_must_fail",
    "bypass_ecac_must_fail",
    "exceed_price_authority_must_fail",
    "exceed_adluxe_budget_authority_must_fail",
    "redirect_payout_destination_must_fail",
    "self_expand_credentials_must_fail",
    "disable_audit_or_reconciliation_must_fail",
    "rewrite_signed_contract_must_fail",
    "unauthorized_entitlement_must_fail",
    "pay_from_unreconciled_ad_delivery_must_fail",
    "prohibited_sensitive_targeting_must_fail",
    "spawn_unrestricted_agent_must_fail",
    "modify_own_charter_must_fail",
    "erase_adverse_evidence_must_fail",
    "escape_crownthrive_custody_must_fail",
    "provider_outage",
    "provider_replacement",
    "credential_compromise",
    "duplicate_or_replayed_events",
    "partial_provider_success",
    "stale_policy",
    "rights_revocation",
    "payment_mismatch",
    "adluxe_delivery_mismatch",
    "rollback",
    "compensating_action",
    "restore"
  ],
  "public_projection": {
    "restricted_algorithms": "excluded",
    "prompts": "excluded_when_proprietary_or_sensitive",
    "credentials": "excluded",
    "private_economics": "excluded",
    "provider_account_billing_and_capacity": "restricted"
  },
  "provenance": {
    "institutionalization_pr": 265,
    "institutionalization_merge_commit": "84ef5b8655c0b5349d475885e90f77d48cb09316",
    "follow_on_ratification_pr": 266
  }
}
